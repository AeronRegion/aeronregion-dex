---
import '../styles/global.css';
import { meta } from '../lib/data';
const { title, description = 'Pokédex, moves, items, type chart and moveset search, with Cobbleverse movepools.' } = Astro.props;
const fullTitle = title ? `${title} · ARdex` : 'ARdex · Aeron Region Pokédex';
const path = Astro.url.pathname;
// Top menu. Entries with `items` open a dropdown; `quick` adds a small "Quick links" part under it.
const ITEM = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/';
const menus: any[] = [
  { label: 'Pokédex', icon: ITEM + 'poke-ball.png', match: ['/pokedex/', '/pokemon/', '/moves/', '/abilities/', '/search/', '/regions/'], items: [
    { href: '/pokedex/', label: 'All Pokémon' }, { href: '/moves/', label: 'Moves' },
    { href: '/abilities/', label: 'Abilities' }, { href: '/search/', label: 'Moveset search' },
  ], quick: [{ href: '/regions/', label: 'Pokémon by generation' }, { href: '/moves/?tag=Multi-hit', label: 'Multi-hit moves' }, { href: '/moves/?tag=Priority', label: 'Priority moves' }] },
  { label: 'Items', icon: ITEM + 'leftovers.png', href: '/items/', match: ['/items/'] },
  { label: 'Mechanics', icon: 'gear', match: ['/types/', '/natures/'], items: [
    { href: '/types/', label: 'Type chart' }, { href: '/natures/', label: 'Natures' },
  ] },
  { label: 'Aeron Region', icon: '/icon-96.png', match: [], items: [
    { href: '/', label: 'ARdex home' }, { href: 'https://aeronregion.net', label: 'aeronregion.net' },
    { href: 'https://aeronregion.net/league/', label: 'Gym League' }, { href: 'https://aeronregion.net/tournaments/', label: 'Tournaments' },
    { href: 'https://discord.gg/zC4YKx5sDx', label: 'Discord' },
  ] },
];
const isOn = (m: { match: string[] }) => m.match.some((x) => path.startsWith(x));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#2e1a20" />
  </head>
  <body>
    <header class="site-header band">
      <div class="wrap bar">
        <nav class="nav" aria-label="Main">
          {menus.map((m) => {
            const icon = m.icon === 'gear'
              ? <svg class="ic" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M19.4 13a7.6 7.6 0 0 0 0-2l2.1-1.6-2-3.5-2.5 1a7.4 7.4 0 0 0-1.7-1L15 3h-4l-.3 2.9a7.4 7.4 0 0 0-1.7 1l-2.5-1-2 3.5L6.6 11a7.6 7.6 0 0 0 0 2l-2.1 1.6 2 3.5 2.5-1a7.4 7.4 0 0 0 1.7 1L11 21h4l.3-2.9a7.4 7.4 0 0 0 1.7-1l2.5 1 2-3.5zM13 15.5a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7z"/></svg>
              : <img class="ic" src={m.icon} alt="" width="28" height="28" />;
            return m.items ? (
              <div class:list={['more', 'tab', { on: isOn(m) }]}>
                <button type="button" aria-haspopup="true">{icon}<span class="tl">{m.label}</span><span class="car">▾</span></button>
                <div class="menu">
                  {m.items.map((x: any) => <a href={x.href}>{x.label}</a>)}
                  {m.quick && <><span class="qh">Quick links</span>{m.quick.map((x: any) => <a href={x.href}>{x.label}</a>)}</>}
                </div>
              </div>
            ) : <a href={m.href} class:list={['tab', { on: isOn(m) }]}>{icon}<span class="tl">{m.label}</span></a>;
          })}
        </nav>
        <form class="find" action="/pokedex/" role="search"><input id="find" placeholder="Search Pokémon, moves, abilities…" autocomplete="off" aria-label="Search" /></form>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="band site-footer">
      <div class="wrap">
        <p>Data from <a href="https://github.com/smogon/pokemon-showdown">Pokémon Showdown</a> and <a href="https://pokeapi.co">PokéAPI</a>{meta.cobbleverse && <>, plus Cobbleverse {meta.cobbleverse} pack files</>}. Sprites from PokéAPI. Updated {meta.built}.</p>
        <p class="soft">ARdex is part of <a href="https://aeronregion.net">Aeron Region</a>. Fan-made and not affiliated with Nintendo, Game Freak, The Pokémon Company, Mojang or Microsoft. Pokémon and its names are trademarks of their owners.</p>
      </div>
    </footer>
    <script>
      // Header search (and any input with data-find): themed suggestions, jump to the page on pick/enter.
      import { autocomplete } from '../lib/ac';
      let names: Promise<[string, string, string, string?, string?][]> | null = null;
      const loadNames = () => (names ??= fetch('/names.json').then((r) => r.json()));
      const items = async () => (await loadNames()).map(([label, value, sub, type, cat]) => ({ label, value, sub, type, cat }));
      for (const input of document.querySelectorAll<HTMLInputElement>('#find, [data-find]')) {
        autocomplete(input, items, (it) => { location.href = it.value!; }, 14);
        input.form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const v = input.value.trim().toLowerCase(); if (!v) return;
          const list = await loadNames();
          const hit = list.find(([n]) => n.toLowerCase() === v) ?? list.find(([n]) => n.toLowerCase().startsWith(v)) ?? list.find(([n]) => n.toLowerCase().includes(v));
          if (hit) location.href = hit[1];
        });
      }
      // Dropdowns open on hover (desktop) or tap; tapping elsewhere closes them.
      document.querySelectorAll<HTMLElement>('.more > button').forEach((b) => b.addEventListener('click', () => {
        const box = b.parentElement!; const was = box.classList.contains('open');
        document.querySelectorAll('.more.open').forEach((x) => x.classList.remove('open'));
        if (!was) box.classList.add('open');
      }));
      document.addEventListener('click', (e) => { document.querySelectorAll('.more.open').forEach((d) => { if (!d.contains(e.target as Node)) d.classList.remove('open'); }); });
      // Any <table class="data sortable">: click a header with data-sort to sort by it.
      // Cells can carry data-v for the sort value; numbers sort high→low first.
      document.querySelectorAll<HTMLTableElement>('table.sortable').forEach((table) => {
        table.querySelectorAll<HTMLTableCellElement>('th[data-sort]').forEach((th) => {
          th.addEventListener('click', () => {
            const i = [...th.parentElement!.children].indexOf(th);
            const num = th.dataset.sort === 'num';
            const asc = th.classList.contains('sorted') ? !th.classList.contains('asc') : !num;
            table.querySelectorAll('th').forEach((h) => h.classList.remove('sorted', 'asc'));
            th.classList.add('sorted'); if (asc) th.classList.add('asc');
            const body = table.tBodies[0];
            const val = (r: HTMLTableRowElement) => { const c = r.cells[i]; const v = c?.dataset.v ?? c?.textContent?.trim() ?? ''; return num ? (v === '' || v === '—' ? -Infinity : +v) : v.toLowerCase(); };
            const rows = [...body.rows].filter((r) => !r.classList.contains('group'));
            rows.sort((a, b) => { const x = val(a), y = val(b); return (x < y ? -1 : x > y ? 1 : 0) * (asc ? 1 : -1); });
            body.querySelectorAll('tr.group').forEach((g) => g.remove());
            rows.forEach((r) => body.appendChild(r));
            table.dispatchEvent(new CustomEvent('sorted'));
          });
        });
      });
    </script>
  </body>
</html>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; }
  .bar { display: flex; align-items: flex-end; gap: 1rem; height: 58px; }
  .nav { flex: 1; display: flex; align-items: flex-end; gap: .3rem; height: 100%; }
  .tab { flex: 1; position: relative; height: 48px; display: flex; }
  .tab > button, a.tab { flex: 1; font: inherit; display: flex; align-items: center; justify-content: center; gap: .5rem; height: 48px;
    font-weight: 700; font-size: 1rem; color: var(--on-brick); text-decoration: none; background: none; cursor: pointer;
    border: 2px solid transparent; border-bottom: 0; }
  .tab > button:hover, a.tab:hover { background: rgb(255 255 255 / .07); color: var(--on-brick); }
  .tab.on > button, a.tab.on { background: var(--petal); color: var(--ink); border-color: var(--brick-deep); }
  .ic { width: 28px; height: 28px; image-rendering: pixelated; flex: none; }
  img.ic { width: 38px; height: 38px; margin: -5px; }
  .car { font-size: .7em; opacity: .7; }
  .find { width: 280px; flex: none; align-self: center; position: relative; }
  .find input { width: 100%; font: inherit; font-size: .92rem; padding: .4rem .7rem; border: 2px solid var(--brick-deep); background: #fff7f5; color: var(--ink); }
  .more > .menu { display: none; }
  .more.open > .menu, .more:focus-within > .menu { display: grid; }
  @media (hover: hover) { .more:hover > .menu { display: grid; } }
  .menu { position: absolute; left: 0; top: 100%; min-width: 100%; width: max-content; max-width: 280px; background: var(--brick-deep); border: 2px solid #000; padding: .3rem; z-index: 70; }
  .menu a { padding: .5rem .8rem; text-decoration: none; color: var(--on-brick); font-weight: 600; white-space: nowrap; }
  .menu a:hover { background: var(--brick); outline: 2px solid #fff; outline-offset: -2px; }
  .qh { font-size: .7rem; font-weight: 700; letter-spacing: .04em; color: var(--on-brick-soft); background: rgb(255 255 255 / .08); padding: .3rem .8rem; margin: .3rem -.3rem; }
  @media (max-width: 960px) { .find { width: 200px; } .tl { font-size: .92rem; } }
  @media (max-width: 760px) {
    .bar { flex-wrap: wrap; height: auto; padding-top: .5rem; gap: .4rem; }
    .find { width: 100%; order: -1; }
    .nav { height: 48px; }
    .tl, .car { display: none; }
    .menu { left: auto; right: 0; }
    .tab:first-child .menu { left: 0; right: auto; }
  }
  main { padding: 1.4rem 0 1rem; }
  .site-footer { border-top: 4px solid var(--brick-deep); padding: 1.6rem 0 .6rem; margin-top: 4rem; font-size: .88rem; }
</style>
