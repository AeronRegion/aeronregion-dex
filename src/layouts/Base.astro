---
import '../styles/global.css';
import { meta } from '../lib/data';
const { title, description = 'Pokédex, moves, items, type chart and moveset search, with Cobbleverse movepools.' } = Astro.props;
const fullTitle = title ? `${title} | ARdex` : 'ARdex | Aeron Region Pokédex';
const path = Astro.url.pathname;
// Top menu. Entries with `items` open a dropdown; `quick` adds a small "Quick links" part under it.
const ITEM = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/';
const menus: any[] = [
  { label: 'Pokémon', icon: ITEM + 'poke-ball.png', match: ['/pokedex/', '/pokemon/', '/moves/', '/abilities/', '/items/', '/natures/', '/regions/', '/egg-groups/', '/ev-yield/'], items: [
    { href: '/pokedex/', label: 'Pokédex' }, { href: '/types/#pick', label: 'Types' }, { href: '/moves/', label: 'Moves' },
    { href: '/abilities/', label: 'Abilities' }, { href: '/items/', label: 'Items' }, { href: '/natures/', label: 'Natures' },
    { href: '/egg-groups/', label: 'Egg groups' }, { href: '/ev-yield/', label: 'EV yield' },
  ], quick: [{ href: '/regions/', label: 'Pokémon by generation' }, { href: '/moves/?tag=Multi-hit', label: 'Multi-hit moves' }, { href: '/moves/?tag=Priority', label: 'Priority moves' }, { href: '/moves/?tag=Spread', label: 'Spread moves' }] },
  { label: 'Tools', icon: 'gear', match: ['/types/', '/search/', '/coverage/', '/team/'], items: [
    { href: '/types/#chart', label: 'Type chart' }, { href: '/search/', label: 'Moveset search' }, { href: '/team/', label: 'Teambuilder' }, { href: '/coverage/', label: 'Coverage checker' },
  ] },
];
const isOn = (m: { match: string[] }) => m.match.some((x) => path.startsWith(x));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#23262b" />
    <script is:inline>
      // pick the theme before the page paints: saved choice, otherwise the system setting
      (function () { var m = document.cookie.match(/(?:^|; )theme=(dark|light)/), t = m && m[1];
        if (!t) { try { t = localStorage.getItem('theme'); } catch (e) {} }
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t; })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand"><img src="/icon-96.png" alt="" width="40" height="40" />ARdex</a>
        <nav class="nav" aria-label="Main">
          {menus.map((m) => m.items ? (
            <div class:list={['more', { on: isOn(m) }]}>
              <button type="button" aria-haspopup="true">{m.label}<span class="car">▾</span></button>
              <div class="menu">
                {m.items.map((x: any) => <a href={x.href}>{x.label}</a>)}
                {m.quick && <><span class="qh">Quick links</span>{m.quick.map((x: any) => <a href={x.href}>{x.label}</a>)}</>}
              </div>
            </div>
          ) : <a href={m.href} class:list={['lnk', { on: isOn(m) }]}>{m.label}</a>)}
        </nav>
        <button type="button" class="mode" id="mode" aria-label="Switch to dark mode" title="Dark mode"><span class="moon" aria-hidden="true">☾</span><span class="sun" aria-hidden="true">☀</span></button>
        <a class="ar" href="https://aeronregion.net"><span class="arl">Aeron Region</span> <span aria-hidden="true">↗</span></a>
        <form class="find" action="/pokedex/" role="search"><input id="find" placeholder="Search Pokémon, moves, abilities…" autocomplete="off" aria-label="Search" /></form>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="band site-footer">
      <div class="wrap">
        <p>Data from <a href="https://github.com/smogon/pokemon-showdown">Pokémon Showdown</a> and <a href="https://pokeapi.co">PokéAPI</a>{meta.cobbleverse && <>, plus Cobbleverse {meta.cobbleverse} pack files</>}. Sprites from PokéAPI. Updated {meta.built}.</p>
        <p class="soft">ARdex is part of <a href="https://aeronregion.net">Aeron Region</a>. Fan-made and not affiliated with Nintendo, Game Freak, The Pokémon Company, Mojang or Microsoft. Pokémon and its names are trademarks of their owners.</p>
      </div>
    </footer>
    <script>
      // Light / dark toggle, remembered in this browser
      const modeBtn = document.getElementById('mode')!;
      const setLabel = () => { const dark = document.documentElement.dataset.theme === 'dark'; modeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode'); modeBtn.title = dark ? 'Light mode' : 'Dark mode'; };
      setLabel();
      modeBtn.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next; try { localStorage.setItem('theme', next); } catch {}
        // shared with aeronregion.net so both sites match
        const host = location.hostname.endsWith('aeronregion.net') ? '; domain=.aeronregion.net' : '';
        document.cookie = `theme=${next}; path=/; max-age=31536000; samesite=lax${host}`; setLabel();
      });
      // Header search (and any input with data-find): themed suggestions, jump to the page on pick/enter.
      import { autocomplete } from '../lib/ac';
      let names: Promise<[string, string, string, string?, string?][]> | null = null;
      const loadNames = () => (names ??= fetch('/names.json').then((r) => r.json()));
      const items = async () => (await loadNames()).map(([label, value, sub, type, cat]) => ({ label, value, sub, type, cat }));
      for (const input of document.querySelectorAll<HTMLInputElement>('#find, [data-find]')) {
        autocomplete(input, items, (it) => { location.href = it.value!; }, 14);
        input.form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          const v = input.value.trim().toLowerCase(); if (!v) return;
          const list = await loadNames();
          const hit = list.find(([n]) => n.toLowerCase() === v) ?? list.find(([n]) => n.toLowerCase().startsWith(v)) ?? list.find(([n]) => n.toLowerCase().includes(v));
          if (hit) location.href = hit[1];
        });
      }
      // Dropdowns open on hover (desktop) or tap; tapping elsewhere closes them.
      document.querySelectorAll<HTMLElement>('.more > button').forEach((b) => b.addEventListener('click', () => {
        const box = b.parentElement!; const was = box.classList.contains('open');
        document.querySelectorAll('.more.open').forEach((x) => x.classList.remove('open'));
        if (!was) box.classList.add('open');
      }));
      document.addEventListener('click', (e) => { document.querySelectorAll('.more.open').forEach((d) => { if (!d.contains(e.target as Node)) d.classList.remove('open'); }); });
      // Any <table class="data sortable">: click a header with data-sort to sort by it.
      // Cells can carry data-v for the sort value; numbers sort high→low first.
      document.querySelectorAll<HTMLTableElement>('table.sortable').forEach((table) => {
        table.querySelectorAll<HTMLTableCellElement>('th[data-sort]').forEach((th) => {
          th.addEventListener('click', () => {
            const i = [...th.parentElement!.children].indexOf(th);
            const num = th.dataset.sort === 'num';
            const asc = th.classList.contains('sorted') ? !th.classList.contains('asc') : !num;
            table.querySelectorAll('th').forEach((h) => h.classList.remove('sorted', 'asc'));
            th.classList.add('sorted'); if (asc) th.classList.add('asc');
            const body = table.tBodies[0];
            const val = (r: HTMLTableRowElement) => { const c = r.cells[i]; const v = c?.dataset.v ?? c?.textContent?.trim() ?? ''; return num ? (v === '' || v === '—' ? -Infinity : +v) : v.toLowerCase(); };
            const rows = [...body.rows].filter((r) => !r.classList.contains('group'));
            rows.sort((a, b) => { const x = val(a), y = val(b); return (x < y ? -1 : x > y ? 1 : 0) * (asc ? 1 : -1); });
            body.querySelectorAll('tr.group').forEach((g) => g.remove());
            rows.forEach((r) => body.appendChild(r));
            table.dispatchEvent(new CustomEvent('sorted'));
          });
        });
      });
    </script>
  </body>
</html>
<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--brick-deep); border-bottom: 3px solid #000; }
  .bar { display: flex; align-items: center; gap: 1.4rem; height: 56px; width: min(100% - 2.5rem, 1280px); }
  .home, .more > button, .lnk { font: inherit; font-weight: 700; font-size: 1rem; color: var(--on-brick); text-decoration: none; background: none; border: 0; cursor: pointer;
    display: flex; align-items: center; gap: .45rem; height: 56px; padding: 0 .2rem; border-bottom: 3px solid transparent; margin-bottom: -3px; }
  .brand { display: flex; align-items: center; gap: .55rem; font-weight: 800; font-size: 1.45rem; color: var(--on-brick); text-decoration: none; white-space: nowrap; margin-right: .6rem; }
  .brand img { width: 40px; height: 40px; image-rendering: pixelated; }
  .brand:hover { color: #fff; }
  .home:hover, .more > button:hover, .lnk:hover { color: #fff; }
  .home.on, .more.on > button, .lnk.on { border-bottom-color: #59c4fb; }
  .nav { display: flex; gap: 1.4rem; flex: 1; justify-content: flex-end; }
  .car { font-size: .7em; opacity: .7; }
  .more { position: relative; }
  .more > .menu { display: none; }
  .more.open > .menu, .more:focus-within > .menu { display: grid; }
  @media (hover: hover) { .more:hover > .menu { display: grid; } }
  .menu { position: absolute; left: -.6rem; top: 100%; width: max-content; min-width: 220px; background: var(--brick-deep); border: 1px solid #000; padding: .3rem; z-index: 70; }
  .menu a { padding: .5rem .8rem; text-decoration: none; color: var(--on-brick); font-weight: 600; white-space: nowrap; }
  .menu a:hover { background: var(--brick); outline: 2px solid #fff; outline-offset: -2px; }
  .qh { font-size: .7rem; font-weight: 700; letter-spacing: .04em; color: var(--on-brick-soft); background: rgb(255 255 255 / .08); padding: .3rem .8rem; margin: .3rem -.3rem; }
  .ar { font-weight: 700; font-size: .9rem; color: var(--on-brick); text-decoration: none; padding: .32rem .8rem; border: 2px solid var(--brick); white-space: nowrap; }
  .ar:hover { background: var(--brick); color: #fff; }
  .mode { background: none; border: 2px solid var(--brick); color: var(--on-brick); font-size: 1rem; line-height: 1; width: 2.1rem; height: 2.1rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; padding: 0; }
  .mode:hover { background: var(--brick); }
  .mode .sun { display: none; }
  :global(html[data-theme='dark']) .mode .sun { display: inline; }
  :global(html[data-theme='dark']) .mode .moon { display: none; }
  .find { width: 300px; position: relative; }
  .find input { width: 100%; font: inherit; font-size: .9rem; padding: .38rem .7rem; border: 2px solid var(--brick); background: var(--card); color: var(--ink); }
  @media (max-width: 700px) {
    .bar { flex-wrap: wrap; height: auto; gap: 0 .9rem; padding-top: .3rem; row-gap: 0; }
    .brand { margin-right: auto; }
    .nav { flex: none; gap: .9rem; justify-content: flex-start; }
    .home, .more > button { height: 44px; font-size: .95rem; }
    .find { flex: 1 1 200px; order: 9; padding: .1rem 0 .5rem; }
    .mode { order: 10; margin: -.4rem -.4rem 0 0; }
    .menu { left: auto; right: -.6rem; }
    .ar { order: 11; font-size: .85rem; padding: .32rem .5rem; margin: -.4rem 0 0 0; }
    .arl { display: none; }
    .ar::before { content: "AR"; }
  }
  main { padding: 1.4rem 0 1rem; }
  .site-footer { border-top: 4px solid var(--brick-deep); padding: 1.6rem 0 .6rem; margin-top: 4rem; font-size: .88rem; }
</style>
