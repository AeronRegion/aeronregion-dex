---
// Move category icon in the PokemonDB style (drawn here): Physical red-outlined white burst, Special blue tilted rings, Status grey tilted pill with a dark left half. Hover shows the name.
import { CAT_SVG } from '../lib/ac';
const { cat } = Astro.props as { cat: string };
---
<span class={`caticon ${cat}`} title={cat} aria-label={cat} role="img"><svg viewBox="0 0 28 14" aria-hidden="true" set:html={CAT_SVG[cat] ?? ''}></svg></span>
<style>
  .caticon { display: inline-block; width: 30px; height: 15px; vertical-align: middle; line-height: 0; }
  .caticon svg { width: 100%; height: 100%; }
</style>
