---
// Move category icon: Physical (burst), Special (rings), Status (half circle). Hover shows the name.
const { cat } = Astro.props as { cat: string };
---
<span class={`caticon ${cat}`} title={cat} aria-label={cat} role="img">
  {cat === 'Physical' && <svg viewBox="0 0 28 14" aria-hidden="true"><rect width="28" height="14" rx="3" fill="#c9482c"/><path d="M14 2.2l1.5 3 3.2-1.1-1.2 3.1 3 1.6-3.3.6.2 3.3-2.6-2-2.6 2 .2-3.3-3.3-.6 3-1.6L9.3 4.1l3.2 1.1z" fill="#ffd34d"/></svg>}
  {cat === 'Special' && <svg viewBox="0 0 28 14" aria-hidden="true"><rect width="28" height="14" rx="3" fill="#4f6fc7"/><circle cx="14" cy="7" r="4.6" fill="none" stroke="#dfe7ff" stroke-width="1.4"/><circle cx="14" cy="7" r="2.2" fill="#dfe7ff"/></svg>}
  {cat === 'Status' && <svg viewBox="0 0 28 14" aria-hidden="true"><rect width="28" height="14" rx="3" fill="#8a8a8a"/><circle cx="14" cy="7" r="4.4" fill="none" stroke="#f2f2f2" stroke-width="1.4"/><path d="M14 2.6a4.4 4.4 0 0 1 0 8.8z" fill="#f2f2f2"/></svg>}
</span>
<style>
  .caticon { display: inline-block; width: 34px; height: 17px; vertical-align: middle; line-height: 0; }
  .caticon svg { width: 100%; height: 100%; }
</style>
