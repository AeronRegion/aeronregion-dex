---
// Sortable Pokémon table used by the Pokédex list and type pages.
import Type from './Type.astro';
import { pokeUrl, iconUrl } from '../lib/data';
const { list, id = 'dex' } = Astro.props as { list: any[]; id?: string };
---
<table class="data sortable dextable" id={id}>
  <thead><tr><th data-sort="num">#</th><th></th><th data-sort="text">Name</th><th>Type</th><th data-sort="text">EV yield</th>
    <th data-sort="num">HP</th><th data-sort="num">Atk</th><th data-sort="num">Def</th><th data-sort="num">SpA</th><th data-sort="num">SpD</th><th data-sort="num">Spe</th><th data-sort="num">Total</th></tr></thead>
  <tbody>
    {list.map((s) => (
      <tr data-q={`${s.name} ${s.num} ${Object.values(s.abilities).join(' ')}`.toLowerCase()} data-t={s.types.join(' ')} data-form={s.forme ? 1 : 0}>
        <td class="n soft" data-v={s.num}>{String(s.num).padStart(4, '0')}</td>
        <td><img class="sprite" src={iconUrl(s.art)} alt="" loading="lazy" width="40" height="40" /></td>
        <td><a href={pokeUrl(s)}>{s.name}</a></td>
        <td><div class="chips">{s.types.map((t: string) => <Type type={t} small />)}</div></td>
        <td class="tgt">{s.ev.join(', ')}</td>
        {['hp', 'atk', 'def', 'spa', 'spd', 'spe'].map((k) => <td class="n">{s.stats[k]}</td>)}
        <td class="n"><b>{s.bst}</b></td>
      </tr>
    ))}
  </tbody>
</table>
