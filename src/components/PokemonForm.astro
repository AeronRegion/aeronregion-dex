---
import Type from './Type.astro';
import Cat from './Cat.astro';
import { abilityUrl, abilityByName, moveById, pokeUrl, moveUrl, artUrl, STATS, statRange, GAMES, meta, formSlug, formLabel } from '../lib/data';
import { TYPES, typeColors, effWith, effText, effBg, effFg, dbTypeColors, ABILITY_DEF } from '../lib/types';
const LIGHT = new Set(['Normal', 'Electric', 'Grass', 'Ice', 'Ground', 'Flying', 'Bug', 'Rock', 'Steel', 'Fairy']);
import learnData from '../data/learn.json';

const { s, first } = Astro.props as { s: any; first: boolean };
const learn = (learnData as Record<string, [string, string[]][]>)[s.id] ?? [];

const imp = (m: number) => { const inch = Math.round(m * 39.3701); return `${Math.floor(inch / 12)}′${String(inch % 12).padStart(2, '0')}″`; };
const abil = [s.abilities['0'], s.abilities['1']].filter(Boolean);
const statColor = (b: number) => b < 50 ? '#e06a5a' : b < 80 ? '#f2a65a' : b < 100 ? '#e8c64a' : b < 130 ? '#8cc35b' : '#3fa66a';

// moves tab
const catOrder: Record<string, number> = { Physical: 0, Special: 1, Status: 2 };
const rows = learn.map(([mid, src]) => ({ m: moveById.get(mid), src })).filter((r) => r.m)
  .sort((a, b) => catOrder[a.m.cat] - catOrder[b.m.cat] || a.m.name.localeCompare(b.m.name));
const gens = [...new Set(learn.flatMap(([, src]) => src.map((c) => c[0])))].filter((g) => g !== 'C').map(Number).sort((a, b) => b - a);
const hasCobble = learn.some(([, src]) => src.some((c) => c[0] === 'C'));
const pri = (p: number) => p > 0 ? `+${p}` : String(p);
const priClass = (p: number) => p > 0 ? 'pos' : p < 0 ? 'neg' : 'zero';
const defs = s.types;
// Damage-taken variants by ability, merged when abilities give the same chart (PokemonDB style).
const allAbil = [s.abilities['0'], s.abilities['1'], s.abilities.H, s.abilities.S].filter(Boolean) as string[];
const variants: { names: string[]; cells: number[] }[] = [];
for (const a of allAbil) {
  const cells = TYPES.map((t) => effWith(t, defs, a));
  const v = variants.find((x) => x.cells.join() === cells.join());
  if (v) v.names.push(a); else variants.push({ names: [a], cells });
}
const affecting = allAbil.filter((a) => ABILITY_DEF[a]);
const plain = TYPES.map((t) => effWith(t, defs));
// show the ability that changes matchups first, so it isn't hidden behind a button
variants.sort((x, y) => (x.names.some((n) => ABILITY_DEF[n]) ? 0 : 1) - (y.names.some((n) => ABILITY_DEF[n]) ? 0 : 1));
const spawns = s.cobbleverse?.spawns ?? [];
---
<div class="form" data-form={formSlug(s)} hidden={!first}>
  <section class="hd">
    <img class="art" src={artUrl(s.art)} alt={s.name} width="200" height="200" />
    <div>
      <span class="no">#{String(s.num).padStart(4, '0')}</span>
      <h1>{formLabel(s)}</h1>
      <div class="chips">{s.types.map((t: string) => <Type type={t} />)}</div>
      <table class="kv top" style="margin-top:.8rem">
        <tr><th>Height</th><td>{s.height != null ? <>{s.height} m <span class="soft">({imp(s.height)})</span></> : '—'}</td></tr>
        <tr><th>Weight</th><td>{s.weight} kg <span class="soft">({(s.weight * 2.20462).toFixed(1)} lbs)</span></td></tr>
        <tr><th>Abilities</th><td>{abil.map((a, i) => <>{i > 0 && <br />}<a class="ab" href={abilityUrl(a)} title={abilityByName.get(a)?.short}>{a}</a></>)}{s.abilities.H && <><br /><a class="ab" href={abilityUrl(s.abilities.H)} title={abilityByName.get(s.abilities.H)?.short}>{s.abilities.H}</a> <span class="soft">(hidden ability)</span></>}</td></tr>
      </table>
    </div>
    <table class="kv top">
      <tr><th>EV yield</th><td>{s.ev.length ? <span class="evs">{s.ev.map((e: string) => <a class={`evb ev-${e.split(' ')[1]}`} href={`/ev-yield/?stat=${e.split(' ')[1]}`}>{e}</a>)}</span> : '—'}</td></tr>
      <tr><th>Catch rate</th><td>{s.catchRate ?? '—'}</td></tr>
      <tr><th>Egg groups</th><td>{s.eggGroups.map((g: string, i: number) => <>{i > 0 && ', '}<a class="ab" href={`/egg-groups/#${g.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}>{g}</a></>)}</td></tr>
      <tr><th>Gender</th><td>{s.gender ?? '—'}</td></tr>
      <tr><th>Growth rate</th><td>{s.growth ?? '—'}</td></tr>
      <tr><th>Smogon tier</th><td>{s.tier || '—'}{s.doublesTier && <span class="soft"> · Doubles: {s.doublesTier}</span>}</td></tr>
    </table>
  </section>

  <div class="tabs" role="tablist">
    <button role="tab" aria-selected="true" data-tab="overview">Overview</button>
    <button role="tab" aria-selected="false" data-tab="moves">Moves ({rows.length})</button>
  </div>

  <section data-panel="overview" class="panel">
    <div class="two">
      <div>
        <h3 class="sec">Base stats</h3>
        {STATS.map(([k, label]) => { const b = s.stats[k]; const [lo, hi] = statRange(k, b); return (
          <div class="st"><span>{label}</span><b>{b}</b><div class="bar"><i style={`width:${Math.min(100, b / 1.8)}%;background:${statColor(b)}`}></i></div><span class="mm">{lo}–{hi}</span></div>
        ); })}
        <div class="st tot"><span>Total</span><b>{s.bst}</b><span class="mm">Min–max at Lv. 100</span></div>
      </div>
      <div>
        <h3 class="sec">Type defenses</h3>
        {variants.length > 1 && (
          <div class="abilrow"><span class="lab">Ability</span><div class="seg abil">
            {variants.map((v, i) => <button aria-pressed={i === 0 ? 'true' : 'false'} data-v={i}>{v.names.join(' / ')}</button>)}
          </div></div>
        )}
        {variants.map((v, i) => (
          <div class="dt" data-v={i} hidden={i > 0}>
            {TYPES.map((t, j) => { const m = v.cells[j]; const bg = effBg(m); return (
              <div class="tc"><a href={`/types/${t.toLowerCase()}/`} style={`background:${dbTypeColors[t]}`}>{t.slice(0, 3).toUpperCase()}</a><b class:list={{ chg: m !== plain[j] }} title={m !== plain[j] ? `Changed by ${v.names.join(' / ')} (normally ${effText(plain[j]) || '1'}×)` : undefined} style={bg ? `background:${bg};color:${effFg(m)}` : ''}>{effText(m)}</b></div>
            ); })}
          </div>
        ))}
        <p class="note" style="margin-top:.5rem">
          {variants.length === 1 && affecting.length > 0 ? <>Includes {affecting.join(', ')}. Outlined boxes are changed by the ability. </> : variants.length > 1 ? <>Outlined boxes are changed by the selected ability. </> : null}
          <a href="/types/">Type chart</a>
        </p>
      </div>
    </div>

    {s.evo.length > 0 && <>
      <h3 class="sec">Evolution</h3>
      <div class:list={["evos", { branch: s.evo.some((st: any[]) => st.length > 2) }]}>
        {s.evo.map((stage: any[], i: number) => <>
          {i > 0 && <span class="arr">{stage.length === 1 && stage[0].how && <em>{stage[0].how}</em>}<span>→</span></span>}
          <div class:list={["stage", { many: stage.length > 2 }]}>{stage.map((e) => (
            <a class:list={['evo', { cur: e.id === s.id }]} href={pokeUrl(e)}>
              <img src={artUrl(e.art)} alt="" width="84" height="84" loading="lazy" />
              <span class="soft">#{String(e.num).padStart(4, '0')}</span><b>{e.forme ? formLabel(e) : e.name}</b>
              <span class="etypes">{e.types.map((t: string) => <Type type={t} small link={false} />)}</span>
              {stage.length > 1 && e.how && <em>{e.how}</em>}
            </a>
          ))}</div>
        </>)}
      </div>
    </>}

    <h3 class="sec">Where to find</h3>
    <table class="loc">
      <tr class="cv"><th><span class="cvname"><img src="/cobbleverse.png" alt="" width="28" height="28" />Cobbleverse {meta.cobbleverse ?? ''}</span><span class="soft" style="font-weight:400;font-size:.8rem">Spawns from the pack's own files</span></th><td>
        {!meta.cobbleverse ? <span class="soft">Spawn data is being added.</span>
          : !s.cobbleverse ? <span class="soft">Not in Cobbleverse.</span>
          : spawns.length === 0 ? <span class="soft">Doesn't spawn naturally. Evolve, breed, or check special encounters.</span>
          : spawns.map((sp: any) => (
            <div class="spawn">
              <dl>
                <dt>Rarity</dt><dd>{sp.bucket}{sp.weight != null && <span class="soft"> · weight {sp.weight}</span>}</dd>
                <dt>Levels</dt><dd>{sp.levels}</dd>
                <dt>Weather</dt><dd>{sp.weather ?? 'Any'}</dd>
                {sp.sky && <><dt>Sky light</dt><dd>{sp.sky}</dd></>}
              </dl>
              <dl>
                <dt>Biomes</dt><dd>{sp.biomes}</dd>
                <dt>Time</dt><dd>{sp.time ?? 'Any'}</dd>
                <dt>Context</dt><dd>{sp.context}</dd>
                {sp.conditions && <><dt>Conditions</dt><dd>{sp.conditions}</dd></>}
              </dl>
            </div>))}
      </td></tr>
      {s.locations.map((l: any) => <tr><th>{l.game}</th><td>{l.places.join(', ')}</td></tr>)}
      {s.locations.length === 0 && <tr><th>Main games</th><td class="soft">No wild locations listed. Usually obtained by evolution, trade or event.</td></tr>}
    </table>

    <div class="two">
      <div><h3 class="sec">Training</h3>
        <table class="kv"><tr><th>Base friendship</th><td>{s.friendship ?? '—'}</td></tr><tr><th>Base exp.</th><td>{s.baseExp ?? '—'}</td></tr>{s.cobbleverse?.drops && <tr><th>Drops (Cobbleverse)</th><td>{s.cobbleverse.drops}</td></tr>}</table></div>
      <div><h3 class="sec">Breeding</h3>
        <table class="kv"><tr><th>Egg cycles</th><td>{s.eggCycles ?? '—'}{s.eggCycles && <span class="soft"> ({(s.eggCycles * 257).toLocaleString()} steps)</span>}</td></tr><tr><th>Egg groups</th><td>{s.eggGroups.map((g: string, i: number) => <>{i > 0 && ', '}<a class="ab" href={`/egg-groups/#${g.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`}>{g}</a></>)}</td></tr></table></div>
    </div>

    {s.dex.length > 0 && <>
      <h3 class="sec">Pokédex entries</h3>
      <table class="dex">{s.dex.map((d: any) => <tr><th>{d.game}</th><td>{d.text}</td></tr>)}</table>
    </>}
  </section>

  <section data-panel="moves" class="panel" hidden>
    <div class="controls">
      <select class="field game" aria-label="Game">
        <option value="all" selected>All games</option>
        {hasCobble && <option value="C">Cobbleverse {meta.cobbleverse}</option>}
        {gens.map((g) => <option value={g}>{GAMES[g]}</option>)}
      </select>
      <div class="seg split"><button aria-pressed="true" data-split="0">One list</button><button aria-pressed="false" data-split="1">By how it learns</button></div>
      <input class="field mfilter" placeholder="Filter moves or types…" style="margin-left:auto;min-width:240px" />
    </div>
    <p class="note mcount"></p>
    <div class="msplit"></div>
    <table class="data sortable mtable">
      <thead><tr><th data-sort="text">Move</th><th data-sort="text">Type</th><th data-sort="num" class="sorted asc">Cat.</th><th data-sort="num">Power</th><th data-sort="num">Acc</th><th data-sort="num">PP</th><th data-sort="num" class="pri">Priority</th><th data-sort="text">Target</th><th data-sort="num">How</th></tr></thead>
      <tbody>
        {rows.map(({ m, src }) => (
          <tr data-src={src.join(',')} data-q={`${m.name} ${m.type} ${m.cat}`.toLowerCase()}>
            <td><a href={moveUrl(m)}>{m.name}</a></td>
            <td data-v={m.type}><Type type={m.type} small /></td>
            <td data-v={catOrder[m.cat]}><Cat cat={m.cat} /></td>
            <td class="n">{m.power ?? '—'}</td>
            <td class="n">{m.acc ?? '—'}</td>
            <td class="n">{m.pp}</td>
            <td class={`n pri ${priClass(m.pri)}`} data-v={m.pri}>{pri(m.pri)}</td>
            <td class="tgt">{m.target}</td>
            <td class="how"></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="note" style="margin-top:.6rem">“All games” lists every move it can learn in any game.</p>
  </section>
</div>

<script>
  // Each form block has its own Overview/Moves tabs and moves table.
  const METHOD: Record<string, [string, number]> = { L: ['Level up', 0], M: ['TM', 1], E: ['Egg', 2], T: ['Tutor', 3], S: ['Event', 4], D: ['Event', 4], V: ['Transfer', 5], R: ['Special', 4] };
  const COBBLE: Record<string, [string, number]> = { tm: ['TM', 1], egg: ['Egg', 2], tutor: ['Tutor', 3], legacy: ['Older games', 5], special: ['Special', 4], form_change: ['Form change', 4], evolution: ['Evolution', 4] };
  const parse = (codes: string[]) => codes.map((c) => {
    if (c[0] === 'C') { const k = c.slice(1); if (/^\d+$/.test(k)) return { label: `Lv ${k}`, group: 0, sort: +k }; const [l, gr] = COBBLE[k] ?? [k, 4]; return { label: l, group: gr, sort: 200 + gr }; }
    const t = c[1]; const [l, gr] = METHOD[t] ?? ['Other', 4];
    if (t === 'L') { const lv = +c.slice(2); return { label: `Lv ${lv}`, group: 0, sort: lv }; }
    return { label: l, group: gr, sort: 200 + gr };
  });

  for (const form of document.querySelectorAll<HTMLElement>('.form')) {
    form.querySelectorAll<HTMLButtonElement>('.abil button').forEach((b) => b.addEventListener('click', () => {
      form.querySelectorAll('.abil button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      form.querySelectorAll<HTMLElement>('.dt').forEach((d) => (d.hidden = d.dataset.v !== b.dataset.v));
    }));
    const tabs = form.querySelectorAll<HTMLButtonElement>('[data-tab]');
    form.addEventListener('show-tab', ((e: CustomEvent) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === e.detail)));
      form.querySelectorAll<HTMLElement>('.panel').forEach((p) => (p.hidden = p.dataset.panel !== e.detail));
    }) as EventListener);
    tabs.forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.form').forEach((f) => f.dispatchEvent(new CustomEvent('show-tab', { detail: t.dataset.tab })));
      document.dispatchEvent(new CustomEvent('form-state'));
    }));

    const table = form.querySelector<HTMLTableElement>('.mtable');
    if (!table) continue;
    const body = table.tBodies[0];
    const rows = [...body.rows];
    const gameSel = form.querySelector<HTMLSelectElement>('select.game')!;
    let game = gameSel.value;
    let split = false;
    const msplit = form.querySelector<HTMLElement>('.msplit')!;
    const howFor = (src: string[]) => {
      if (game === 'C') return parse(src.filter((c) => c[0] === 'C'));
      if (game !== 'all') return parse(src.filter((c) => c[0] === game));
      const real = src.filter((c) => c[0] !== 'C' && c[1] !== 'V');
      const pool = real.length ? real : src.filter((c) => c[0] !== 'C');
      if (!pool.length) return parse(src);
      const top = Math.max(...pool.map((c) => +c[0]));
      const h = parse(pool.filter((c) => +c[0] === top));
      if (top < 9 && h.length) h[0] = { ...h[0], label: `${h[0].label} (Gen ${top})` };
      return h;
    };
    const uniq = (h: { label: string }[]) => [...new Set(h.map((x) => x.label))];
    const render = () => {
      const q = form.querySelector<HTMLInputElement>('.mfilter')!.value.trim().toLowerCase();
      let n = 0;
      body.querySelectorAll('tr.group').forEach((g) => g.remove());
      for (const r of rows) {
        const h = howFor(r.dataset.src!.split(','));
        const ok = h.length > 0 && (!q || r.dataset.q!.includes(q));
        r.hidden = !ok; if (ok) n++;
        const cell = r.cells[8];
        cell.textContent = uniq(h).join(', ');
        cell.dataset.v = String(Math.min(...h.map((x) => x.sort), 999));
        r.dataset.group = String(Math.min(...h.map((x) => x.group), 9));
      }
      table.hidden = split;
      if (split) {
        // PokemonDB-style: one small table per method, level up + egg on the left, TM + the rest on the right
        const names = ['Moves learnt by level up', 'Moves learnt by TM', 'Egg moves', 'Tutor moves', 'Event / special moves', 'Older games / transfer'];
        const by: Record<number, string[]> = {};
        const q2 = (r: HTMLTableRowElement) => [0, 1, 2, 3, 4].map((k) => r.cells[k].innerHTML);
        const lvRows: [number, string][] = [];
        for (const r of rows) {
          if (r.hidden) continue;
          const [mv, ty, ca, pw, ac] = q2(r);
          const tail = `<td>${mv}</td><td>${ty}</td><td class="c">${ca}</td><td class="n">${pw}</td><td class="n">${ac}</td>`;
          const h = howFor(r.dataset.src!.split(','));
          const seen = new Set<number>();
          for (const x of h) {
            if (x.group === 0) lvRows.push([x.sort, `<tr><td class="n lv">${x.sort === 0 ? 'Evo' : x.sort}</td>${tail}</tr>`]);
            else if (!seen.has(x.group)) { seen.add(x.group); (by[x.group] ??= []).push(`<tr>${tail}</tr>`); }
          }
        }
        const lvSeen = new Set<string>();
        by[0] = lvRows.sort((a, b) => a[0] - b[0]).map((x) => x[1]).filter((x) => !lvSeen.has(x) && lvSeen.add(x));
        const head = (g: number) => `<thead><tr>${g === 0 ? '<th class="n">Lv.</th>' : ''}<th>Move</th><th>Type</th><th class="c">Cat.</th><th class="n">Power</th><th class="n">Acc.</th></tr></thead>`;
        const block = (g: number) => by[g]?.length ? `<div class="mgrp"><h4>${names[g]} <span>${by[g].length}</span></h4><table class="data mini">${head(g)}<tbody>${by[g].join('')}</tbody></table></div>` : '';
        msplit.innerHTML = `<div>${block(0)}${block(2)}</div><div>${block(1)}${block(3)}${block(4)}${block(5)}</div>`;
      } else msplit.innerHTML = '';
      form.querySelector('.mcount')!.textContent = `${n} moves`;
    };
    gameSel.addEventListener('change', () => { game = gameSel.value; render(); });
    form.querySelectorAll<HTMLButtonElement>('.split button').forEach((b) => b.addEventListener('click', () => {
      form.querySelectorAll('.split button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      split = b.dataset.split === '1';
      if (!split) {
        const ord = [...rows].sort((a, b) => +a.cells[2].dataset.v! - +b.cells[2].dataset.v! || a.cells[0].textContent!.localeCompare(b.cells[0].textContent!));
        ord.forEach((r) => body.appendChild(r));
      }
      render();
    }));
    form.querySelector('.mfilter')!.addEventListener('input', render);
    table.addEventListener('sorted', () => render());
    render();
  }
</script>

<style>
  .hd { display: grid; grid-template-columns: 200px 1fr 330px; gap: 1.6rem; align-items: start; height: 268px; }
  .hd h1 { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .art { width: 210px; height: 210px; object-fit: contain; margin-top: -6px; }
  .no { font-weight: 600; color: var(--ink-soft); }
  .ab { color: var(--ink); font-weight: 700; text-decoration: none; }
  .ab:hover { color: #1f7fb8; }
  h1 { margin: .1rem 0 .5rem; }
  .tabs { display: flex; border-bottom: 3px solid var(--ink); margin-top: 1.6rem; }
  .tabs button { font: inherit; font-weight: 700; font-size: 1.05rem; padding: .5rem 1.6rem; background: none; border: 3px solid transparent; border-bottom: 0; margin-bottom: -3px; cursor: pointer; color: var(--ink); }
  .tabs button[aria-selected='true'] { border-color: var(--ink); background: #fff7f5; }
  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 2.2rem; }
  .st { display: grid; grid-template-columns: 80px 40px 1fr 80px; gap: .6rem; align-items: center; padding: .22rem 0; }
  .st > span:first-child { text-align: right; color: var(--ink-soft); font-weight: 500; }
  .st span:first-child { font-weight: 500; }
  .st b { text-align: right; }
  .bar { height: 12px; background: #ead1cd; } .bar i { display: block; height: 100%; }
  .tot .mm { grid-column: 3 / 5; white-space: nowrap; }
  .mm { color: var(--ink-soft); font-size: .82rem; text-align: right; }
  .tot { border-top: 2px solid var(--ink); margin-top: .3rem; }
  .dt { display: grid; grid-template-columns: repeat(9, 44px); gap: 6px 2px; }
  .tc { display: flex; flex-direction: column; text-align: center; font-weight: 700; font-size: .7rem; }
  .tc a { min-width: 0; height: 18px; line-height: 17px; font-size: .62rem; text-decoration: none; color: #fff; text-shadow: 1px 1px 1px rgb(0 0 0 / .6); border: 1px solid rgb(0 0 0 / .2); border-radius: 0; }
  .abilrow { display: flex; align-items: center; gap: .6rem; margin-bottom: .6rem; flex-wrap: wrap; }
  .abilrow .lab { font-weight: 600; font-size: .85rem; color: var(--ink-soft); }
  .tc b.chg { outline: 2px solid var(--ink); outline-offset: -2px; }
  .tc b { height: 26px; line-height: 26px; box-sizing: border-box; font-size: .8rem; background: #fff7f5; border: 1px solid #e2c3bf; border-top: 0; }
  .evos { display: flex; align-items: center; justify-content: center; gap: 1rem; flex-wrap: wrap; }
  .stage { display: flex; flex-direction: column; align-items: center; gap: .6rem; }
  .stage.many { display: grid; grid-template-columns: repeat(4, minmax(110px, 1fr)); gap: .4rem .6rem; }
  .evo { display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--ink); padding: .3rem .6rem; border: 2px solid transparent; }
  .evo.cur b { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: #59c4fb; text-underline-offset: 4px; }
  .evo img { width: 84px; height: 84px; object-fit: contain; }
  .evo em { font-style: normal; font-size: .75rem; background: var(--petal-deep); padding: 0 .4rem; }
  .evo b { font-weight: 700; }
  .etypes { display: flex; gap: .2rem; margin-top: .15rem; }
  .arr { display: flex; flex-direction: column; align-items: center; gap: .1rem; color: var(--ink-soft); font-size: 1.4rem; line-height: 1; margin-top: -2.2rem; max-width: 9rem; text-align: center; }
