---
// One VGC usage format: Pokémon list on the left, the selected Pokémon's full data on the right
// (base stats, moves, teammates, items, abilities + Tera, spreads with nature and EVs together).
// The page carries the data as JSON; the panel is drawn in the browser.
import { pokeUrl, boxIconUrl, iconUrl, moveUrl, itemUrl, abilityUrl, itemByName, itemIconUrl, moveById } from '../lib/data';
import { formats, GROUPS, loadFormat, findSpecies, moveName, itemName, abilityName, updated, pickerGroups, twin, monthName } from '../lib/usage';
import { typeColors } from '../lib/types';
const { id } = Astro.props as { id: string };
const f = formats.find((x) => x.id === id)!;
const d = loadFormat(id);
const sheets = f.group !== 'sd';
const champ = f.name.startsWith('Champions');
const toID = (s: string) => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const keyOf = (name: string, s: any) => toID(s?.name ?? name);
const STAT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
const mons = d.mons.map((m: any, k: number) => {
  const s = findSpecies(m.name);
  const sp = (m.spreads ?? []).map(([x, p]: [string, number]) => { const [nat, v] = x.split(':'); return [nat, v.split('/').map(Number), p]; });
  const top4 = m.moves.slice(0, 4).map(([x]: [string]) => moveName(x));
  const nat = sp[0]?.[0] ?? m.natures?.[0]?.[0] ?? '';
  const paste = [
    `${s?.name ?? m.name}${m.items[0] ? ` @ ${itemName(m.items[0][0])}` : ''}`,
    m.abilities[0] ? `Ability: ${abilityName(m.abilities[0][0])}` : '',
    'Level: 50',
    m.tera?.[0] ? `Tera Type: ${m.tera[0][0]}` : '',
    sp[0] ? `EVs: ${sp[0][1].map((x: number, i: number) => (x ? `${x} ${STAT[i]}` : '')).filter(Boolean).join(' / ')}` : '',
    nat ? `${nat} Nature` : '',
    ...top4.map((x: string) => `- ${x}`),
  ].filter(Boolean).join('\n');
  return {
    k: keyOf(m.name, s), n: s?.name ?? m.name, r: k + 1, u: m.usage, wr: m.wr ?? null,
    url: s ? pokeUrl(s) : null, ic: boxIconUrl(s?.art), fb: iconUrl(s?.art), ty: s?.types ?? [],
    st: s ? [s.stats.hp, s.stats.atk, s.stats.def, s.stats.spa, s.stats.spd, s.stats.spe] : null,
    mv: m.moves.map(([x, p]: [string, number]) => { const nm = moveName(x); const mm = moveById.get(toID(nm)); return [nm, mm?.type ?? '', mm?.cat ?? '', p, mm ? moveUrl(mm) : '']; }),
    it: m.items.map(([x, p]: [string, number]) => { const it = itemByName.get(itemName(x)); return [it?.name ?? itemName(x), it?.icon ? itemIconUrl(it.icon) : '', p, it ? itemUrl(it) : '']; }),
    ab: m.abilities.map(([x, p]: [string, number]) => [abilityName(x), p, abilityUrl(abilityName(x))]),
    te: (m.tera ?? []).map(([x, p]: [string, number]) => [x, p]),
    sp, na: sp.length ? [] : (m.natures ?? []),
    mt: m.mates.map(([x, p]: [string, number]) => { const o = findSpecies(x); return [o?.name ?? x, keyOf(x, o), boxIconUrl(o?.art), o?.types ?? [], p, iconUrl(o?.art)]; }),
    paste,
  };
});
// Tera exists only in Scarlet & Violet formats; Showdown only started recording it in Sept 2024
const svFormat = /^Scarlet & Violet/.test(f.name) || (f.group === 'pd' && +f.id.slice(3) >= 2023 && +f.id.slice(3) <= 2026) || (f.group === 'lt' && /^Scarlet/.test(f.name));
const DATA = { sheets, champ, mons, colors: typeColors, tera: svFormat ? 'nodata' : 'none' };
const fmtNum = (n: number) => n.toLocaleString('en-US');
const pct = (p: number) => String(+p.toFixed(p >= 10 ? 1 : 2)) + '%';
---
<div class="ufmt">
  <nav class="usrc" aria-label="Data source">
    {GROUPS.map((g) => { const first = pickerGroups(g.key)[0]?.items[0]; return first && <a href={`/usage/${first.id}/`} class:list={['segchip', { on: g.key === f.group }]} aria-current={g.key === f.group ? 'page' : undefined}>{({ sd: 'Showdown ladder', lt: 'Tournaments', pd: 'Official majors' } as any)[g.key]}</a>; })}
  </nav>
  <div class="upick">
    <select class="field" id="ufmt" aria-label="Format">
      {pickerGroups(f.group).map((g) => (
        <optgroup label={g.game}>{g.items.map((x: any) => <option value={`/usage/${x.id}/`} selected={x.base === f.base}>{x.short}{x.group === 'sd' ? (x.current ? ' (current)' : ` · ${monthName(x.period)}`) : x.group === 'lt' ? ` · ${x.period}` : ''}</option>)}</optgroup>
      ))}
    </select>
    {f.group === 'sd' && (twin(f)
      ? <span class="ubo" role="group" aria-label="Best of">{[false, true].map((b) => { const x = b === f.bo3 ? f : twin(f); return <a href={`/usage/${x.id}/`} class:list={['segchip', { on: b === f.bo3 }]}>{b ? 'Bo3' : 'Bo1'}</a>; })}</span>
      : <span class="ubo solo">{f.bo3 ? 'Bo3 only' : 'Bo1 only'}</span>)}
  </div>
</div>
<p class="note">
  {GROUPS.find((g) => g.key === f.group)!.label}: {f.group === 'sd'
    ? <>{fmtNum(f.total)} battles in {f.period}, players rated {f.cutoff}+.{!f.current && ' This format has ended; this is its last full month on the ladder.'}</>
    : f.group === 'lt'
      ? <>{fmtNum(f.total)} teams from {f.tours} tournaments, {f.period}.</>
      : <>{fmtNum(f.total)} teams from {f.tours} events.</>}
  {' '}Updated weekly (last {updated}).
  {f.group === 'pd' && <details class="evs"><summary>Events included</summary>{f.period}</details>}
</p>

<div class="uwrap">
  <aside class="uside">
    <input class="field" id="uq" placeholder="Search Pokémon…" autocomplete="off" />
    <div class="uhead"><span>Pokémon</span><span>Usage</span></div>
    <ol class="ulist" id="ulist">
      {mons.map((m: any) => (
        <li><a href={`#${m.k}`} data-k={m.k} data-q={m.n.toLowerCase()}>
          <span class="rk">{m.r}</span>
          <img class="sprite" src={m.ic} data-fb={m.fb} onerror="if(this.dataset.fb&&this.src!==this.dataset.fb){this.src=this.dataset.fb;this.classList.add('fb')}" alt="" loading="lazy" width="40" height="30" />
          <span class="nm">{m.n}</span><b>{pct(m.u)}</b>
        </a></li>
      ))}
    </ol>
  </aside>
  <section class="upanel" id="upanel" aria-live="polite"></section>
</div>
<p class="note">Sources: Pokémon Showdown usage stats; Limitless (play.limitlesstcg.com); official event team lists from RK9 Labs via Pokedata. "Add set to Teambuilder" uses the top item, ability, spread or nature, and four most used moves.</p>
<script is:inline type="application/json" id="udata" set:html={JSON.stringify(DATA).replace(/</g, '\\u003c')}></script>

<script>
  import { CAT_SVG } from '../lib/ac';
  const D = JSON.parse(document.getElementById('udata')!.textContent!);
  const sel = document.getElementById('ufmt') as HTMLSelectElement;
  sel.addEventListener('change', () => { location.href = sel.value; });
  const STAT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'], STATN = ['HP', 'Attack', 'Defense', 'Sp. Atk', 'Sp. Def', 'Speed'];
  const esc = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const pct = (p: number) => String(+p.toFixed(p >= 10 ? 1 : 2)) + '%';
  const chip = (t: string) => t ? `<a class="chip small" href="/types/${t.toLowerCase()}/" style="--c:${D.colors[t] ?? '#777'};--t:#fff">${t}</a>` : '';
  const cat = (c: string) => c ? `<svg viewBox="0 0 28 14" width="26" height="13" role="img" aria-label="${c}"><title>${c}</title>${(CAT_SVG as any)[c] ?? ''}</svg>` : '';
  const ic = (src: string, fb = '') => src ? `<img class="sprite" src="${src}" data-fb="${fb}" onerror="if(this.dataset.fb&&this.src!==this.dataset.fb)this.src=this.dataset.fb" alt="" loading="lazy" width="32" height="24" />` : '';
  const card = (title: string, cls: string, head: string, rows: string[]) => `<div class="ucard ${cls}"><h3>${title}</h3>${head}<div class="ubody">${rows.length ? rows.join('') : '<p class="soft">No data</p>'}</div></div>`;
  const row = (left: string, p: number) => `<div class="urow"><span class="l">${left}</span><span class="p">${pct(p)}</span></div>`;
  const bar = (v: number) => `<i style="width:${Math.min(100, (v / 255) * 100)}%;background:hsl(${Math.min(360, Math.floor((v * 180) / 255))},85%,45%)"></i>`;
  const byK = new Map(D.mons.map((m: any) => [m.k, m]));
  const panel = document.getElementById('upanel')!, list = document.getElementById('ulist')!;
  const baseTitle = document.title;
  const draw = (k: string, scroll = false) => {
    const m: any = byK.get(k) ?? D.mons[0]; if (!m) { panel.innerHTML = '<p>No data.</p>'; return; }
    list.querySelectorAll('a.on').forEach((a) => a.classList.remove('on'));
    list.querySelector(`a[data-k="${m.k}"]`)?.classList.add('on');
    const b64 = btoa(unescape(encodeURIComponent(m.paste)));
    const spreadHead = `<div class="urow sphead"><span class="l"><span class="nat">Nature</span>${STAT.map((s) => `<span class="sv">${s}</span>`).join('')}</span><span class="p"></span></div>`;
    panel.innerHTML = `
      <div class="utop">
        <img class="uart" src="${m.ic}" data-fb="${m.fb}" onerror="if(this.src!==this.dataset.fb)this.src=this.dataset.fb" alt="" width="68" height="51" />
        <div class="ut">
          <h2>${m.url ? `<a class="pk" href="${m.url}">${esc(m.n)}</a>` : esc(m.n)}</h2>
          <div class="tys">${m.ty.map(chip).join(' ')}</div>
        </div>
        <dl class="unums"><div><dt>Usage</dt><dd>${pct(m.u)}</dd></div><div><dt>Rank</dt><dd>#${m.r}</dd></div>${D.sheets && m.wr != null ? `<div><dt title="Game win rate of teams with this Pokémon">Win rate</dt><dd>${pct(m.wr)}</dd></div>` : ''}</dl>
        <div class="uact"><div class="uadd"><button type="button" class="block" id="uadd" aria-haspopup="true" aria-expanded="false">Add set to Teambuilder ▾</button><div class="umenu" id="umenu" hidden></div></div><button type="button" class="sm" id="ucopy">Copy as Showdown text</button></div>
      </div>
      <div class="ugrid">
        ${m.st ? card('Base stats', 'c-bs', '', m.st.map((v: number, i: number) => `<div class="urow bsr"><span class="bl">${STATN[i]}</span><span class="bb">${bar(v)}</span><span class="bv">${v}</span></div>`).concat(`<div class="urow bsr tot"><span class="bl">Total</span><span class="bb"></span><span class="bv">${m.st.reduce((x: number, y: number) => x + y, 0)}</span></div>`)) : ''}
        ${card('Moves', 'c-mv', '', m.mv.map(([n, t, c, p, u]: any) => row(`${u ? `<a href="${u}">${esc(n)}</a>` : esc(n)}<span class="tg">${chip(t)}${cat(c)}</span>`, p)))}
        ${card('Teammates', 'c-mt', '', m.mt.map(([n, k, src, ty, p, fb]: any) => row(`${ic(src, fb)}${byK.has(k) ? `<a class="pk" href="#${k}">${esc(n)}</a>` : esc(n)}`, p)))}
        ${card('Items', 'c-it', '', m.it.map(([n, src, p, u]: any) => row(`${src ? `<img src="${src}" alt="" width="24" height="24" loading="lazy" />` : ''}${u ? `<a href="${u}">${esc(n)}</a>` : esc(n)}`, p)))}
        <div class="ustack">
          ${card('Abilities', 'c-ab', '', m.ab.map(([n, p, u]: any) => row(`<a href="${u}">${esc(n)}</a>`, p)))}
          ${m.te.length ? card('Tera types', 'c-te', '', m.te.map(([t, p]: any) => row(chip(t), p))) : `<div class="ucard c-te"><h3>Tera types</h3><p class="unone">${D.tera === 'none' ? 'No Terastallization in this format.' : 'No Tera data for this period.'}</p></div>`}
        </div>
        ${m.sp.length
          ? card(D.champ ? 'Spreads (Stat Points)' : 'EV spreads', 'c-sp', spreadHead, m.sp.map(([nat, v, p]: any) => row(`<span class="nat">${nat}</span>${v.map((x: number) => `<span class="sv${x ? '' : ' z'}">${x}</span>`).join('')}`, p)))
          : card('Natures', 'c-sp', '', m.na.map(([n, p]: any) => row(esc(n), p)))}
      </div>`;
    // pick which saved team gets the set (teams live in this browser, same as the Teambuilder)
    const addBtn = document.getElementById('uadd')!, menu = document.getElementById('umenu')!;
    addBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!menu.hidden) { menu.hidden = true; addBtn.setAttribute('aria-expanded', 'false'); return; }
      let teams: any[] = []; try { teams = JSON.parse(localStorage.getItem('ardex-teams') ?? '[]'); } catch {}
      const last = +(localStorage.getItem('ardex-cur') ?? 0);
      const base = `/team/?add=${encodeURIComponent(b64)}`;
      menu.innerHTML = `<div class="umh">Add ${esc(m.n)} to…</div>` + teams.map((t, i) => {
        const n = (t.mons ?? []).filter((x: any) => x.sp).length;
        return `<a class="segchip" href="${base}&to=${i}">${esc(t.name || 'Untitled team')}<small>${n}/6${i === last ? ' · last opened' : ''}</small></a>`;
      }).join('') + `<a class="segchip new" href="${base}&to=new">+ New team</a>`;
      menu.hidden = false; addBtn.setAttribute('aria-expanded', 'true');
    });
    document.getElementById('ucopy')!.addEventListener('click', (e) => { const b = e.currentTarget as HTMLButtonElement; navigator.clipboard?.writeText(m.paste).then(() => { b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy as Showdown text'), 1500); }); });
    document.title = `${m.n}: ${baseTitle}`;
    if (scroll && matchMedia('(max-width: 900px)').matches) panel.scrollIntoView({ block: 'start' });
  };
  document.addEventListener('click', (e) => { const mn = document.getElementById('umenu'); if (mn && !mn.hidden && !(e.target as HTMLElement).closest('.uadd')) { mn.hidden = true; document.getElementById('uadd')?.setAttribute('aria-expanded', 'false'); } });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const mn = document.getElementById('umenu'); if (mn) mn.hidden = true; } });
  const go = (k: string, scroll = false) => { history.replaceState(null, '', `#${k}`); draw(k, scroll); };
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
    if (!a || !byK.has(a.hash.slice(1))) return;
    e.preventDefault(); go(a.hash.slice(1), true);
    const li = list.querySelector(`a[data-k="${a.hash.slice(1)}"]`) as HTMLElement | null;
    if (li) list.scrollTop = li.offsetTop - list.offsetTop - list.clientHeight / 2;
  });
  const q = document.getElementById('uq') as HTMLInputElement;
  q.addEventListener('input', () => { const v = q.value.trim().toLowerCase(); list.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => { a.parentElement!.hidden = !!v && !a.dataset.q!.includes(v); }); });
  q.addEventListener('keydown', (e) => { if (e.key === 'Enter') { const a = list.querySelector<HTMLAnchorElement>('li:not([hidden]) a'); if (a) go(a.dataset.k!, true); } });
  draw(location.hash.slice(1));
</script>
<style>
  :global(body:has(.uwrap) .wrap) { width: min(100% - 2.5rem, 1500px); }
  .ufmt { display: flex; gap: .5rem 1.2rem; align-items: center; flex-wrap: wrap; margin: .4rem 0; }
  .usrc, .ubo { display: inline-flex; }
  .usrc a, .ubo a { display: inline-block; padding: .3rem .75rem; border: 1px solid var(--line-2); background: var(--card); color: var(--link) !important; text-decoration: none !important; font-size: .88rem; margin-left: -1px; }
  .usrc a:first-child, .ubo a:first-child { border-radius: 3px 0 0 3px; margin-left: 0; }
  .usrc a:last-child, .ubo a:last-child { border-radius: 0 3px 3px 0; }
  .usrc a.on, .ubo a.on { background: #2f6db5; border-color: #24579a; color: #fff !important; position: relative; }
  .usrc a:not(.on):hover, .ubo a:not(.on):hover { background: rgb(74 144 217 / .12); }
  .ubo.solo { font-size: .8rem; color: var(--ink-soft); }
  .upick { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  .upick select { min-width: 15rem; max-width: 100%; }
  .evs { display: inline; } .evs summary { display: inline; cursor: pointer; color: var(--link, #1f5fbf); } .evs[open] { display: block; margin-top: .3rem; font-size: .85rem; color: var(--ink-soft); }
  .uwrap { display: grid; grid-template-columns: 290px minmax(0, 1fr); gap: 1rem; align-items: start; margin-top: .6rem; }
  .uside { position: sticky; top: 70px; border: 1px solid var(--line-2); border-radius: 4px; background: var(--card); padding: .5rem; }
  .uside #uq { width: 100%; }
  .uhead { display: flex; justify-content: space-between; font-size: .75rem; color: var(--ink-soft); padding: .45rem .3rem .2rem; border-bottom: 1px solid var(--line-2); }
  .ulist { list-style: none; margin: 0; padding: 0; max-height: calc(100vh - 210px); overflow-y: auto; position: relative; }
  .ulist a { display: grid; grid-template-columns: 1.6rem 34px minmax(0, 1fr) 3.6rem; align-items: center; gap: .3rem; padding: 2px .3rem; text-decoration: none !important; color: var(--ink); border-bottom: 1px solid var(--line); font-size: .9rem; }
  .ulist a:hover { background: rgb(74 144 217 / .1); }
  .ulist a.on { background: #dfe9f6; }
  :global(html[data-theme='dark']) .ulist a.on { background: #2f353d; }
  .ulist .rk { color: var(--ink-soft); font-size: .75rem; text-align: right; }
  .ulist img { width: 34px; height: 26px; object-fit: contain; }
  .ulist .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--link); }
  .ulist b { font-weight: 600; font-variant-numeric: tabular-nums; font-size: .85rem; text-align: right; }
  .upanel { min-width: 0; }
  .upanel :global(.utop) { display: flex; align-items: center; gap: .8rem 1.2rem; flex-wrap: wrap; padding-bottom: .6rem; border-bottom: 1px solid var(--line-2); }
  .upanel :global(.uart) { width: 68px; height: 51px; object-fit: contain; }
  .upanel :global(h2) { margin: 0 0 .2rem; font-size: 1.4rem; }
  .upanel :global(.tys) { display: flex; gap: 2px; }
  .upanel :global(.unums) { display: flex; gap: 1.4rem; margin: 0 0 0 auto; }
  .upanel :global(.unums dt) { font-size: .75rem; color: var(--ink-soft); }
  .upanel :global(.unums dd) { margin: 0; font-size: 1.15rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .upanel :global(.uact) { display: flex; gap: .5rem; flex-wrap: wrap; width: 100%; }
  .upanel :global(.uadd) { position: relative; }
  .upanel :global(.umenu) { position: absolute; top: calc(100% + 4px); left: 0; z-index: 30; min-width: 260px; max-height: 320px; overflow-y: auto; background: var(--card); border: 1px solid var(--line-2); border-radius: 4px; box-shadow: 0 4px 14px rgb(0 0 0 / .15); padding: .25rem 0; }
  .upanel :global(.umh) { padding: .3rem .7rem; font-size: .78rem; color: var(--ink-soft); }
  .upanel :global(.umenu a) { display: flex; justify-content: space-between; gap: 1rem; padding: .35rem .7rem; color: var(--link) !important; text-decoration: none !important; }
  .upanel :global(.umenu a:hover) { background: rgb(74 144 217 / .12); }
  .upanel :global(.umenu a small) { color: var(--ink-soft); font-size: .75rem; }
  .upanel :global(.umenu a.new) { border-top: 1px solid var(--line); }
  .upanel :global(.ugrid) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .8rem; margin-top: .8rem; align-items: start; }
  .upanel :global(.ucard) { border: 1px solid var(--line-2); border-radius: 4px; background: var(--card); min-width: 0; }
  .upanel :global(.ucard h3) { margin: 0; padding: .4rem .6rem; font-size: .9rem; border-bottom: 1px solid var(--line-2); }
  .upanel :global(.ubody) { max-height: 300px; overflow-y: auto; }
  .upanel :global(.urow) { display: flex; align-items: center; justify-content: space-between; gap: .5rem; padding: 0 .6rem; min-height: 28px; border-bottom: 1px solid var(--line); font-size: .86rem; }
  .upanel :global(.urow .l) { display: flex; align-items: center; gap: .35rem; min-width: 0; flex: 1; overflow: hidden; white-space: nowrap; }
  .upanel :global(.urow .l > a) { flex: 0 1 auto; min-width: 2.5rem; overflow: hidden; text-overflow: ellipsis; }
  .upanel :global(.urow .tg) { display: inline-flex; align-items: center; gap: 2px; margin-left: auto; padding-left: .3rem; flex: none; }
  .upanel :global(.urow .p) { flex: none; width: 3.7rem; text-align: right; font-variant-numeric: tabular-nums; }
  .upanel :global(.chip) { display: inline-block; text-align: center; font-weight: 700; font-size: .7rem; padding: 0 .4rem; background: var(--c); color: #fff !important; border: 1px solid rgb(0 0 0 / .3); text-decoration: none !important; white-space: nowrap; }
  .upanel :global(.urow .sprite) { width: 32px !important; height: 24px !important; object-fit: contain; flex: none; }
  .upanel :global(.ustack) { display: grid; gap: .8rem; align-content: start; min-width: 0; }
  .upanel :global(.unone) { margin: 0; padding: .5rem .6rem; font-size: .84rem; color: var(--ink-soft); }
  .upanel :global(.c-ab .ubody), .upanel :global(.c-te .ubody) { max-height: 150px; }
  .upanel :global(.usub) { padding: .35rem .6rem .15rem; font-size: .78rem; color: var(--ink-soft); border-bottom: 1px solid var(--line); }
  .upanel :global(.bsr) { display: grid; grid-template-columns: 4.2rem minmax(0, 1fr) 2.2rem; }
  .upanel :global(.bsr .bl) { color: var(--ink-soft); font-size: .8rem; }
  .upanel :global(.bsr .bb i) { display: block; height: 9px; border-radius: 1px; }
  .upanel :global(.bsr .bv) { text-align: right; font-variant-numeric: tabular-nums; }
