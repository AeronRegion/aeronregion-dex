---
// One VGC usage format: Pokémon list on the left, the selected Pokémon's full data on the right
// (base stats, moves, teammates, items, abilities + Tera, spreads with nature and EVs together).
// The page carries the data as JSON; the panel is drawn in the browser.
import { pokeUrl, boxIconUrl, iconUrl, moveUrl, itemUrl, abilityUrl, itemByName, itemIconUrl, moveById } from '../lib/data';
import { formats, GROUPS, loadFormat, findSpecies, moveName, itemName, abilityName, updated, pickerGroups, twin, monthName, variants, fmtDate, fmtRange } from '../lib/usage';
import { typeColors } from '../lib/types';
import Dropdown from './Dropdown.astro';
const { id } = Astro.props as { id: string };
const f = formats.find((x) => x.id === id)!;
const d = loadFormat(id);
const sheets = f.group !== 'sd';
const champ = f.name.startsWith('Champions');
const toID = (s: string) => String(s ?? '').toLowerCase().replace(/[^a-z0-9]/g, '');
const keyOf = (name: string, s: any) => toID(s?.name ?? name);
const STAT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
const mons = d.mons.map((m: any, k: number) => {
  const s = findSpecies(m.name);
  const sp = (m.spreads ?? []).map(([x, p]: [string, number]) => { const [nat, v] = x.split(':'); return [nat, v.split('/').map(Number), p]; });
  const top4 = m.moves.slice(0, 4).map(([x]: [string]) => moveName(x));
  const nat = sp[0]?.[0] ?? m.natures?.[0]?.[0] ?? '';
  const paste = [
    `${s?.name ?? m.name}${m.items[0] ? ` @ ${itemName(m.items[0][0])}` : ''}`,
    m.abilities[0] ? `Ability: ${abilityName(m.abilities[0][0])}` : '',
    'Level: 50',
    m.tera?.[0] ? `Tera Type: ${m.tera[0][0]}` : '',
    sp[0] ? `EVs: ${sp[0][1].map((x: number, i: number) => (x ? `${x} ${STAT[i]}` : '')).filter(Boolean).join(' / ')}` : '',
    nat ? `${nat} Nature` : '',
    ...top4.map((x: string) => `- ${x}`),
  ].filter(Boolean).join('\n');
  return {
    k: keyOf(m.name, s), n: s?.name ?? m.name, r: k + 1, u: m.usage, wr: m.wr ?? null, cnt: Math.round(m.n ?? 0),
    url: s ? pokeUrl(s) : null, ic: boxIconUrl(s?.art), fb: iconUrl(s?.art), ty: s?.types ?? [],
    st: s ? [s.stats.hp, s.stats.atk, s.stats.def, s.stats.spa, s.stats.spd, s.stats.spe] : null,
    mv: m.moves.map(([x, p]: [string, number]) => { const nm = moveName(x); const mm = moveById.get(toID(nm)); return [nm, mm?.type ?? '', mm?.cat ?? '', p]; }),
    it: m.items.map(([x, p]: [string, number]) => { const it = itemByName.get(itemName(x)); return [it?.name ?? itemName(x), it?.icon ?? '', p]; }),
    ab: m.abilities.map(([x, p]: [string, number]) => [abilityName(x), p]),
    te: (m.tera ?? []).map(([x, p]: [string, number]) => [x.charAt(0).toUpperCase() + x.slice(1), p]),
    sp, na: sp.length ? [] : (m.natures ?? []),
    mt: m.mates.map(([x, p]: [string, number]) => { const o = findSpecies(x); return [o?.name ?? x, keyOf(x, o), o?.art ?? '', p]; }),
    paste,
  };
});
// Tera exists only in Scarlet & Violet formats; Showdown only started recording it in Sept 2024
const svFormat = /^Scarlet & Violet/.test(f.name) || (f.group === 'pd' && +f.id.slice(3) >= 2023 && +f.id.slice(3) <= 2026) || (f.group === 'lt' && /^Scarlet/.test(f.name));
const DATA = { sheets, champ, mons, colors: { ...typeColors, Stellar: '#40a3c5' }, tera: svFormat ? 'nodata' : 'none' };
const fmtNum = (n: number) => (n ?? 0).toLocaleString('en-US');
// a Showdown regulation's battles over every recorded month (one rating cutoff, so games aren't counted twice)
const regTotal = (x: any) => variants(x).filter((v: any) => v.cutoff === x.cutoff).reduce((a: number, v: any) => a + (v.total ?? 0), 0);
const regRange = (x: any) => { const ms = [...new Set(variants(x).map((v: any) => v.period))].sort(); return ms.length > 1 ? `${monthName(ms[0])} – ${monthName(ms.at(-1))}` : monthName(ms[0]); };
const short = (n: number) => !n ? '' : n >= 1e6 ? `${+(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}k` : String(n);
// tournaments and majors: the whole set, or one event of it
const parent: any = f.group === 'sd' ? null : f.def ? f : formats.find((x) => x.id === f.base);
const pct = (p: number) => String(+p.toFixed(p >= 10 ? 1 : 2)) + '%';
---
<div class="ufmt">
  <nav class="usrc" aria-label="Data source">
    {GROUPS.map((g) => { const first = pickerGroups(g.key)[0]?.items[0]; return first && <a href={`/usage/${first.id}/`} class:list={['segchip', { on: g.key === f.group }]} aria-current={g.key === f.group ? 'page' : undefined}>{({ sd: 'Showdown ladder', lt: 'Tournaments', pd: 'Official majors' } as any)[g.key]}</a>; })}
  </nav>
  <div class="upick">
    <Dropdown label="Format" minWidth="19rem" groups={pickerGroups(f.group).map((g) => ({ label: g.game, items: g.items.map((x: any) => ({
      href: `/usage/${x.id}/`, on: x.fam === f.fam || x.id === f.base, a: x.short,
      b: x.group === 'sd' ? regRange(x) + (x.current ? ' · current' : '') : x.group === 'lt' ? fmtRange(x.period) : '',
      c: `${short(x.group === 'sd' ? regTotal(x) : x.battles || x.total)} ${x.group === 'sd' || x.battles ? 'battles' : 'teams'}`,
    })) }))} />
    {f.group === 'sd' && (twin(f)
      ? <span class="ubo" role="group" aria-label="Best of">{[false, true].map((b) => { const x = b === f.bo3 ? f : twin(f); return <a href={`/usage/${x.id}/`} class:list={['segchip', { on: b === f.bo3 }]}>{b ? 'Bo3' : 'Bo1'}</a>; })}</span>
      : <span class="ubo solo">{f.bo3 ? 'Bo3 only' : 'Bo1 only'}</span>)}
    {f.group === 'sd' && (() => {
      const vs = variants(f);
      const months = [...new Set(vs.map((x: any) => x.period))].sort().reverse();
      const cuts = [...new Set(vs.filter((x: any) => x.period === f.period).map((x: any) => x.cutoff))].sort();
      const pick = (month: string, cut: number) => vs.find((x: any) => x.period === month && x.cutoff === cut) ?? vs.find((x: any) => x.period === month);
      return <>
        {months.length > 1 && <span class="usel">Month <Dropdown label="Month" minWidth="13rem" groups={[{ items: months.map((mo) => ({ href: `/usage/${pick(mo, f.cutoff).id}/`, on: mo === f.period, a: monthName(mo), b: vs.find((x: any) => x.period === mo && x.def) ? 'default' : '', c: `${short(pick(mo, f.cutoff)?.total)} battles` })) }]} /></span>}
        {cuts.length > 1
          ? <span class="ubo" role="group" aria-label="Rating">{cuts.map((c) => <a href={`/usage/${pick(f.period, c)!.id}/`} class:list={['segchip', { on: c === f.cutoff }]} title={`Games where players were rated ${c}+`}>{c}+</a>)}</span>
          : <span class="ubo solo">Rated {f.cutoff}+</span>}
      </>;
    })()}
  </div>
</div>
<p class="note usum">
  {f.group === 'sd'
    ? <>Showdown ladder, {monthName(f.period)}: <b>{fmtNum(f.total)}</b> battles, weighted toward players rated {f.cutoff}+ (whole regulation: <b>{fmtNum(regTotal(f))}</b> battles over {new Set(variants(f).map((v: any) => v.period)).size} months).{!f.current && f.def && ' This format has ended; this is its last full month on the ladder.'}</>
    : f.event
      ? <>{f.source.replace(/ \(.*$/, '')}, {fmtDate(f.period)}: <b>{fmtNum(f.players)}</b> players, <b>{fmtNum(f.total)}</b> team sheets, <b>{fmtNum(f.battles)}</b> battles.</>
      : <>{f.group === 'lt' ? `Limitless tournaments, ${fmtRange(f.period)}` : 'Official majors, Masters division'}: <b>{fmtNum(f.tours)}</b> events, <b>{fmtNum(f.total)}</b> team sheets{f.battles ? <>, <b>{fmtNum(f.battles)}</b> battles</> : ''}.</>}
  {' '}Updated weekly (last {fmtDate(updated)}).
</p>
{f.group === 'pd' && parent?.events?.length > 0 && (
  <details class="uevents">
    <summary>Events in this data, by size ({parent.events.length})</summary>
    <table class="data">
      <thead><tr><th>Event</th><th>Date</th><th class="n">Players</th><th class="n">Team sheets</th><th class="n">Battles</th></tr></thead>
      <tbody>{[...parent.events].sort((a: any, b: any) => b.battles - a.battles).map((e: any) => <tr><td><a href={`/usage/${e.id}/`}>{e.name}</a></td><td>{fmtDate(e.date)}</td><td class="n">{fmtNum(e.players)}</td><td class="n">{fmtNum(e.teams)}</td><td class="n">{fmtNum(e.battles)}</td></tr>)}</tbody>
    </table>
  </details>
)}

<div class="uwrap">
  <aside class="uside">
    <input class="field" id="uq" placeholder="Search Pokémon…" autocomplete="off" />
    <div class="uhead"><span>Pokémon</span><span>Usage</span></div>
    <ol class="ulist" id="ulist">
      {mons.map((m: any) => (
        <li><a href={`#${m.k}`} data-k={m.k} data-q={m.n.toLowerCase()}>
          <span class="rk">{m.r}</span>
          <img class="sprite" src={m.ic} data-fb={m.fb} onerror="if(this.dataset.fb&&this.src!==this.dataset.fb){this.src=this.dataset.fb;this.classList.add('fb')}" alt="" loading="lazy" width="40" height="30" />
          <span class="nm">{m.n}</span><b>{pct(m.u)}</b>
        </a></li>
      ))}
    </ol>
  </aside>
  <section class="upanel" id="upanel" aria-live="polite"></section>
</div>
<p class="note">Sources: Pokémon Showdown usage stats; Limitless (play.limitlesstcg.com); official event team lists from RK9 Labs via Pokedata. Your set starts with the most common item, ability, Tera type, spread or nature and four moves; click rows to change it.</p>
<script is:inline type="application/json" id="udata" set:html={JSON.stringify(DATA).replace(/</g, '\\u003c')}></script>

<script>
  import { CAT_SVG } from '../lib/ac';
  const D = JSON.parse(document.getElementById('udata')!.textContent!);
  const SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites';
  // same slugs as the site's pages (lib/data slug)
  const slug = (n: string) => n.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/♀/g, '-f').replace(/♂/g, '-m').replace(/['’.:%]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const STAT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'], STATN = ['HP', 'Attack', 'Defense', 'Sp. Atk', 'Sp. Def', 'Speed'];
  const esc = (s: string) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const pct = (p: number) => String(+p.toFixed(p >= 10 ? 1 : 2)) + '%';
  const chip = (t: string) => t ? `<a class="chip small" data-type="${t}" href="/types/${t.toLowerCase()}/" style="--c:${D.colors[t] ?? '#777'};--t:#fff">${t}</a>` : '';
  const cat = (c: string) => c ? `<svg viewBox="0 0 28 14" width="26" height="13" role="img" aria-label="${c}"><title>${c}</title>${(CAT_SVG as any)[c] ?? ''}</svg>` : '';
  const ic = (src: string, fb = '') => src ? `<img class="sprite" src="${src}" data-fb="${fb}" onerror="if(this.dataset.fb&&this.src!==this.dataset.fb)this.src=this.dataset.fb" alt="" loading="lazy" width="32" height="24" />` : '';
  const card = (title: string, cls: string, head: string, rows: string[]) => `<div class="ucard ${cls}"><h3>${title}</h3><div class="ubody">${head}${rows.length ? rows.join('') : '<p class="soft">No data</p>'}</div></div>`;
  const row = (left: string, p: number, kind = '', i = -1) => `<div class="urow${kind ? ' pickable' : ''}"${kind ? ` data-kind="${kind}" data-i="${i}" role="button" tabindex="0"` : ''}><span class="l">${kind ? '<i class="tick" aria-hidden="true"></i>' : ''}${left}</span><span class="p">${pct(p)}</span></div>`;
  const bar = (v: number) => `<i style="width:${Math.min(100, (v / 255) * 100)}%;background:hsl(${Math.min(360, Math.floor((v * 180) / 255))},85%,45%)"></i>`;
  const byK = new Map(D.mons.map((m: any) => [m.k, m]));
  const panel = document.getElementById('upanel')!, list = document.getElementById('ulist')!;
  const baseTitle = document.title;
  // the set builder is opt-in: browsing never selects anything until you open it
  let building = false;
  const draw = (k: string, scroll = false) => {
    const m: any = byK.get(k) ?? D.mons[0]; if (!m) { panel.innerHTML = '<p>No data.</p>'; return; }
    list.querySelectorAll('a.on').forEach((a) => a.classList.remove('on'));
    list.querySelector(`a[data-k="${m.k}"]`)?.classList.add('on');
    // the set you're building: starts as the most common pick in each list
    const P: any = { mv: m.mv.slice(0, 4).map((_: any, i: number) => i), it: m.it.length ? 0 : -1, ab: m.ab.length ? 0 : -1, te: m.te.length ? 0 : -1, sp: m.sp.length ? 0 : -1, na: m.na.length ? 0 : -1 };
    const pasteOf = () => {
      const sp = P.sp >= 0 ? m.sp[P.sp] : null, nat = sp ? sp[0] : P.na >= 0 ? m.na[P.na][0] : '';
      return [
        `${m.n}${P.it >= 0 ? ` @ ${m.it[P.it][0]}` : ''}`,
        P.ab >= 0 ? `Ability: ${m.ab[P.ab][0]}` : '', 'Level: 50',
        P.te >= 0 ? `Tera Type: ${m.te[P.te][0]}` : '',
        sp ? `EVs: ${sp[1].map((x: number, i: number) => (x ? `${x} ${STAT[i]}` : '')).filter(Boolean).join(' / ')}` : '',
        nat ? `${nat} Nature` : '',
        ...P.mv.map((i: number) => `- ${m.mv[i][0]}`),
      ].filter(Boolean).join('\n');
    };
    const spreadHead = `<div class="urow sphead"><span class="l"><i class="tick ghost" aria-hidden="true"></i><span class="nat">Nature</span>${STAT.map((s) => `<span class="sv">${s}</span>`).join('')}</span><span class="p"></span></div>`;
    panel.innerHTML = `
      <div class="utop">
        <img class="uart" src="${m.ic}" data-fb="${m.fb}" onerror="if(this.src!==this.dataset.fb)this.src=this.dataset.fb" alt="" width="68" height="51" />
        <div class="ut">
          <h2>${m.url ? `<a class="pk" href="${m.url}">${esc(m.n)}</a>` : esc(m.n)}</h2>
          <div class="tys">${m.ty.map(chip).join(' ')}</div>
        </div>
        <dl class="unums"><div><dt>Usage</dt><dd>${pct(m.u)}</dd></div><div><dt>Rank</dt><dd>#${m.r}</dd></div><div><dt title="${D.sheets ? 'Team sheets with this Pokémon' : 'Teams with this Pokémon in the sampled battles'}">Teams</dt><dd>${(m.cnt ?? 0).toLocaleString('en-US')}</dd></div>${D.sheets && m.wr != null ? `<div><dt title="Game win rate of teams with this Pokémon">Win rate</dt><dd>${pct(m.wr)}</dd></div>` : ''}</dl>
      </div>
      <div class="ubuild"${building ? ' hidden' : ''}><button type="button" class="sm" id="ubuild">Build a set from this data</button></div>
      <div class="uset"${building ? '' : ' hidden'}>
        <div class="ush"><b>Your set</b><span class="soft">Click rows below to choose the moves (up to 4), item, ability${m.te.length ? ', Tera type' : ''} and ${m.sp.length ? 'spread' : 'nature'}. It starts with the most common of each.</span></div>
        <pre id="upaste"></pre>
        <div class="uact"><div class="uadd"><button type="button" class="block" id="uadd" aria-haspopup="true" aria-expanded="false">Add set to Teambuilder ▾</button><div class="umenu" id="umenu" hidden></div></div><button type="button" class="sm" id="ucopy">Copy as Showdown text</button><button type="button" class="sm" id="ureset">Reset to most common</button><button type="button" class="sm" id="uclear">Clear</button><button type="button" class="sm" id="uclose">Close set builder</button><span class="soft" id="umsg"></span></div>
      </div>
      <div class="ugrid">
        ${m.st ? card('Base stats', 'c-bs', '', m.st.map((v: number, i: number) => `<div class="urow bsr"><span class="bl">${STATN[i]}</span><span class="bb">${bar(v)}</span><span class="bv">${v}</span></div>`).concat(`<div class="urow bsr tot"><span class="bl">Total</span><span class="bb"></span><span class="bv">${m.st.reduce((x: number, y: number) => x + y, 0)}</span></div>`)) : ''}
        ${card('Moves', 'c-mv', '', m.mv.map(([n, t, c, p]: any, i: number) => row(`<a class="nm" href="/moves/${slug(n)}/">${esc(n)}</a><span class="tg">${chip(t).replace('<a ', '<span ').replace('</a>', '</span>')}</span>`, p, 'mv', i)))}
        ${card('Teammates', 'c-mt', '', m.mt.map(([n, k, art, p]: any) => row(`${art ? ic(`${SPR}/pokemon/versions/generation-vii/icons/${art}.png`, `${SPR}/pokemon/${art}.png`) : ''}${byK.has(k) ? `<a class="pk" href="#${k}">${esc(n)}</a>` : esc(n)}`, p)))}
        ${card('Items', 'c-it', '', m.it.map(([n, icon, p]: any, i: number) => row(`${icon ? `<img src="${SPR}/items/${icon}.png" alt="" width="24" height="24" loading="lazy" />` : ''}<a class="nm" href="/items/${slug(n)}/">${esc(n)}</a>`, p, 'it', i)))}
        <div class="ustack">
          ${card('Abilities', 'c-ab', '', m.ab.map(([n, p]: any, i: number) => row(`<a class="nm" href="/abilities/${slug(n)}/">${esc(n)}</a>`, p, 'ab', i)))}
          ${m.te.length ? card('Tera types', 'c-te', '', m.te.map(([t, p]: any, i: number) => row(chip(t).replace('<a ', '<span ').replace('</a>', '</span>'), p, 'te', i))) : `<div class="ucard c-te"><h3>Tera types</h3><p class="unone">${D.tera === 'none' ? 'No Terastallization in this format.' : 'No Tera data for this period.'}</p></div>`}
        </div>
        ${m.sp.length
          ? card(D.champ ? 'Spreads (Stat Points)' : 'EV spreads', 'c-sp', spreadHead, m.sp.map(([nat, v, p]: any, i: number) => row(`<span class="nat">${nat}</span>${v.map((x: number) => `<span class="sv${x ? '' : ' z'}">${x}</span>`).join('')}`, p, 'sp', i)))
          : card('Natures', 'c-sp', '', m.na.map(([n, p]: any, i: number) => row(esc(n), p, 'na', i)))}
      </div>`;
    // pick which saved team gets the set (teams live in this browser, same as the Teambuilder)
    const addBtn = document.getElementById('uadd')!, menu = document.getElementById('umenu')!;
    addBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!menu.hidden) { menu.hidden = true; addBtn.setAttribute('aria-expanded', 'false'); return; }
      let teams: any[] = []; try { teams = JSON.parse(localStorage.getItem('ardex-teams') ?? '[]'); } catch {}
      const last = +(localStorage.getItem('ardex-cur') ?? 0);
      const base = `/team/?add=${encodeURIComponent(btoa(unescape(encodeURIComponent(pasteOf()))))}`;
      menu.innerHTML = `<div class="umh">Add ${esc(m.n)} to…</div>` + teams.map((t, i) => {
        const n = (t.mons ?? []).filter((x: any) => x.sp).length;
        return `<a class="segchip" href="${base}&to=${i}">${esc(t.name || 'Untitled team')}<small>${n}/6${i === last ? ' · last opened' : ''}</small></a>`;
      }).join('') + `<a class="segchip new" href="${base}&to=new">+ New team</a>`;
      menu.hidden = false; addBtn.setAttribute('aria-expanded', 'true');
    });
    document.getElementById('ucopy')!.addEventListener('click', (e) => { const b = e.currentTarget as HTMLButtonElement; navigator.clipboard?.writeText(pasteOf()).then(() => { b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy as Showdown text'), 1500); }); });
    const msg = document.getElementById('umsg')!;
    const sync = () => {
      document.getElementById('upaste')!.textContent = pasteOf();
      panel.querySelectorAll<HTMLElement>('.pickable').forEach((r) => {
        const k = r.dataset.kind!, i = +r.dataset.i!;
        const on = k === 'mv' ? P.mv.includes(i) : P[k] === i;
        r.classList.toggle('sel', on); r.setAttribute('aria-pressed', String(on));
      });
    };
    const choose = (r: HTMLElement) => {
      if (!building) return;
      const k = r.dataset.kind!, i = +r.dataset.i!; msg.textContent = '';
      if (k === 'mv') {
        if (P.mv.includes(i)) P.mv = P.mv.filter((x: number) => x !== i);
        else if (P.mv.length < 4) P.mv.push(i);
        else { msg.textContent = 'Four moves picked. Click one of them to remove it first.'; return; }
      } else P[k] = P[k] === i ? -1 : i;
      sync();
    };
    panel.querySelectorAll<HTMLElement>('.pickable').forEach((r) => {
      r.addEventListener('click', (e) => { if (building) { e.preventDefault(); choose(r); } });
      r.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); choose(r); } });
    });
    document.getElementById('ureset')!.addEventListener('click', () => { P.mv = m.mv.slice(0, 4).map((_: any, i: number) => i); P.it = m.it.length ? 0 : -1; P.ab = m.ab.length ? 0 : -1; P.te = m.te.length ? 0 : -1; P.sp = m.sp.length ? 0 : -1; P.na = m.na.length ? 0 : -1; msg.textContent = ''; sync(); });
    const setBuilding = (on: boolean) => {
      building = on; panel.classList.toggle('building', on);
      panel.querySelector<HTMLElement>('.uset')!.hidden = !on; panel.querySelector<HTMLElement>('.ubuild')!.hidden = on;
      panel.querySelectorAll<HTMLElement>('.pickable').forEach((r) => { r.tabIndex = on ? 0 : -1; on ? r.setAttribute('role', 'button') : r.removeAttribute('role'); });
    };
    document.getElementById('ubuild')!.addEventListener('click', () => setBuilding(true));
    document.getElementById('uclose')!.addEventListener('click', () => setBuilding(false));
    document.getElementById('uclear')!.addEventListener('click', () => { P.mv = []; P.it = P.ab = P.te = P.sp = P.na = -1; msg.textContent = ''; sync(); });
    setBuilding(building);
    sync();
    document.title = `${m.n}: ${baseTitle}`;
    if (scroll && matchMedia('(max-width: 900px)').matches) panel.scrollIntoView({ block: 'start' });
  };
  document.addEventListener('click', (e) => { const mn = document.getElementById('umenu'); if (mn && !mn.hidden && !(e.target as HTMLElement).closest('.uadd')) { mn.hidden = true; document.getElementById('uadd')?.setAttribute('aria-expanded', 'false'); } });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { const mn = document.getElementById('umenu'); if (mn) mn.hidden = true; } });
