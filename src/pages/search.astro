---
import Base from '../layouts/Base.astro';
import { moves, GAMES, meta } from '../lib/data';
---
<Base title="Moveset search" description="Find every Pokémon that can learn up to four moves together.">
  <h1>Moveset search</h1>
  <p>Pick up to 4 moves to see every Pokémon that can learn all of them.</p>
  <div class="controls">
    <span class="lab">Movepool</span>
    <div class="seg" id="game">
      {meta.cobbleverse && <button aria-pressed="true" data-b="0">Cobbleverse {meta.cobbleverse}</button>}
      <button aria-pressed={meta.cobbleverse ? 'false' : 'true'} data-b="all">All games</button>
      {[9, 8, 7].map((g) => <button aria-pressed="false" data-b={g}>{GAMES[g]}</button>)}
    </div>
  </div>
  <form id="f" class="slots">
    {[0, 1, 2, 3].map((i) => <input class="field" list="movelist" placeholder="Add a move…" autocomplete="off" />)}
    <button class="block" type="submit">Find Pokémon</button>
  </form>
  <datalist id="movelist">{moves.map((m) => <option value={m.name} />)}</datalist>
  <h3 class="sec" id="title" hidden></h3>
  <div class="cards" id="out"></div>
</Base>
<script>
  type Index = { species: [string, string, string[], string | null, number, string][]; moves: Record<string, [string, string, string]>; learn: Record<string, number[]> };
  let idx: Index | null = null;
  const load = async () => (idx ??= await (await fetch('/search-index.json')).json());
  const toID = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
  const slug = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/♀/g, '-f').replace(/♂/g, '-m').replace(/['’.:%]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const TC: Record<string, string> = { Normal: '#a8a77a', Fire: '#ee8130', Water: '#6390f0', Electric: '#f7d02c', Grass: '#7ac74c', Ice: '#96d9d6', Fighting: '#c22e28', Poison: '#a33ea1', Ground: '#e2bf65', Flying: '#a98ff3', Psychic: '#f95587', Bug: '#a6b91a', Rock: '#b6a136', Ghost: '#735797', Dragon: '#6f35fc', Dark: '#705746', Steel: '#b7b7ce', Fairy: '#d685ad' };
  const light = new Set(['Normal', 'Electric', 'Grass', 'Ice', 'Ground', 'Flying', 'Bug', 'Rock', 'Steel', 'Fairy']);
  const chip = (t: string) => `<span style="display:inline-block;font-weight:700;font-size:.7rem;padding:0 .4rem;border:1px solid rgb(0 0 0/.3);background:${TC[t]};color:${light.has(t) ? '#2e1a20' : '#fff'}">${t}</span>`;
  const inputs = [...document.querySelectorAll<HTMLInputElement>('#f input')];
  let bit = (document.querySelector('#game [aria-pressed="true"]') as HTMLElement).dataset.b!;

  const search = async () => {
    const data = await load();
    const ids = inputs.map((i) => toID(i.value)).filter((m) => m && data.moves[m]);
    const out = document.getElementById('out')!, title = document.getElementById('title')!;
    history.replaceState(null, '', ids.length ? `?m=${ids.join(',')}&g=${bit}` : location.pathname);
    if (!ids.length) { out.innerHTML = ''; title.hidden = true; return; }
    const want = bit === 'all' ? 0 : 1 << +bit;
    let result: Set<number> | null = null;
    for (const m of ids) {
      const arr = data.learn[m] ?? []; const set = new Set<number>();
      for (let i = 0; i < arr.length; i += 2) if (!want || arr[i + 1] & want) set.add(arr[i]);
      result = result ? new Set([...result].filter((x) => set.has(x))) : set;
    }
    const list = [...result!].sort((a, b) => data.species[a][4] - data.species[b][4] || a - b);
    title.hidden = false;
    title.textContent = `${list.length} Pokémon learn ${ids.length === 1 ? data.moves[ids[0]][0] : ids.length === 2 ? 'both moves' : `all ${ids.length} moves`}`;
    const SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
    out.innerHTML = list.map((i) => { const [, name, types, art, num, url] = data.species[i];
      return `<a class="card" href="${url}"><img src="${art ? SPR + art + '.png' : ''}" alt="" loading="lazy" width="52" height="52" /><div><b>${name}</b><small>#${String(num).padStart(4, '0')}</small><div class="chips">${types.map(chip).join(' ')}</div></div></a>`; }).join('');
  };
  document.getElementById('f')!.addEventListener('submit', (e) => { e.preventDefault(); search(); });
  document.querySelectorAll<HTMLButtonElement>('#game button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('#game button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    bit = b.dataset.b!; if (inputs.some((i) => i.value)) search();
  }));
  // restore from a shared link: ?m=rockslide,protect&g=0
  const p = new URLSearchParams(location.search);
  if (p.get('m')) load().then((data) => {
    p.get('m')!.split(',').slice(0, 4).forEach((m, i) => { if (data.moves[m]) inputs[i].value = data.moves[m][0]; });
    const g = p.get('g'); const btn = g && document.querySelector<HTMLButtonElement>(`#game [data-b="${g}"]`); if (btn) btn.click(); else search();
  });
</script>
<style>
  .slots { display: grid; grid-template-columns: repeat(4, 1fr) auto; gap: .6rem; margin: .4rem 0 .5rem; }
  @media (max-width: 800px) { .slots { grid-template-columns: 1fr 1fr; } }
</style>
