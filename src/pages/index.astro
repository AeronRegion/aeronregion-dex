---
import Base from '../layouts/Base.astro';
import { moves, abilities, items, meta, groups } from '../lib/data';
import { TYPES, typeColors } from '../lib/types';
const ITEM = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/';
const tiles = [
  { href: '/pokedex/', name: 'Pokédex', icon: 'poke-ball', text: `All ${groups.length} Pokémon` },
  { href: '/moves/', name: 'Moves', icon: 'tm-normal', text: `${moves.length} moves, filter by category or tag` },
  { href: '/abilities/', name: 'Abilities', icon: 'ability-capsule', text: `${abilities.length} abilities and who has them` },
  { href: '/search/', name: 'Moveset search', icon: 'poke-radar', text: 'Who learns these moves together' },
];
const _tries = [['Garchomp', '/pokemon/garchomp/'], ['Fake Out', '/moves/fake-out/'], ['Intimidate', '/abilities/intimidate/'], ['Choice Scarf', '/items/choice-scarf/']];
---
<Base description="ARdex: the Aeron Region Pokédex, with Cobbleverse spawns and movepools.">
  <section class="hero">
    <div class="blur" aria-hidden="true"></div>
    <div class="hero-in">
      <h1 class="logo"><span class="word"><img src="/icon-96.png" alt="" width="76" height="76" />ARdex</span></h1>
      <p class="tag">The Aeron Region Pokédex</p>
      <form class="big" role="search">
        <input data-find placeholder="Search a Pokémon, move, ability or item…" autocomplete="off" aria-label="Search" />
        <button type="submit">Search</button>
      </form>
    </div>
  </section>

  <div class="tiles">
    {tiles.map((t) => (
      <a href={t.href} class="tile">
        {t.icon ? <img src={ITEM + t.icon + '.png'} alt="" width="56" height="56" />
          : <span class="mini">{TYPES.slice(0, 9).map((x) => <i style={`background:${typeColors[x]}`}></i>)}</span>}
        <b>{t.name}</b>
      </a>
    ))}
  </div>

  <div class="potd" id="potd">
    <a class="pa" id="partlink" href="/pokedex/"><img id="part" alt="" /></a>
    <span class="pm">
      <span class="pl">Pokémon of the day · <span id="pnum"></span></span>
      <a class="pn" id="pname" href="/pokedex/">&nbsp;</a>
      <span class="pty" id="ptypes"></span>
      <span class="pinfo"><span id="pev"></span><span id="pspawn"></span></span>
      <span class="pab" id="pab"></span>
    </span>
    <span class="pstats" id="pstats"></span>
  </div>

  <div class="about">
    <p>ARdex is built for hunting, training and competitive team building, with spawns and movepools pulled straight from Cobbleverse {meta.cobbleverse}. It's a neutral tool: nothing here is for sale.</p>
    <p class="note">Data from Cobbleverse, Pokémon Showdown and PokéAPI · Updated {meta.built} · Part of <a href="https://aeronregion.net">Aeron Region</a></p>
  </div>
</Base>

<script>
  // Pokémon of the day: same pick for everyone on a given date (local time).
  const TC: Record<string, string> = { Normal: '#a8a77a', Fire: '#ee8130', Water: '#6390f0', Electric: '#f7d02c', Grass: '#7ac74c', Ice: '#96d9d6', Fighting: '#c22e28', Poison: '#a33ea1', Ground: '#e2bf65', Flying: '#a98ff3', Psychic: '#f95587', Bug: '#a6b91a', Rock: '#b6a136', Ghost: '#735797', Dragon: '#6f35fc', Dark: '#705746', Steel: '#b7b7ce', Fairy: '#d685ad' };
  const LIGHT = new Set(['Normal', 'Electric', 'Grass', 'Ice', 'Ground', 'Flying', 'Bug', 'Rock', 'Steel', 'Fairy']);
  const shade = (hex: string, f: number) => '#' + [1, 3, 5].map((i) => Math.round(parseInt(hex.slice(i, i + 2), 16) * f).toString(16).padStart(2, '0')).join('');
  const col = (v: number) => v < 50 ? '#e06a5a' : v < 80 ? '#f2a65a' : v < 100 ? '#e8c64a' : v < 130 ? '#8cc35b' : '#3fa66a';
  fetch('/potd.json').then((r) => r.json()).then((list: [string, number, string[], number[], string, string, string, string | null, string[], string | null][]) => {
    const d = new Date(); const key = d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
    let h = key; h = Math.imul(h ^ (h >>> 16), 0x45d9f3b) >>> 0; h = Math.imul(h ^ (h >>> 16), 0x45d9f3b) >>> 0; h = (h ^ (h >>> 16)) >>> 0;
    const [name, num, types, stats, ev, art, url, spawn, abil, hidden] = list[h % list.length];
    const card = document.getElementById('potd') as HTMLElement;
    const slug = (x: string) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/['’.:%]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const c = TC[types[0]];
    (document.getElementById('partlink') as HTMLAnchorElement).href = url;
    (document.getElementById('pname') as HTMLAnchorElement).href = url;
    card.style.background = `linear-gradient(110deg, ${c}, ${shade(c, .55)} 60%, ${shade(c, .35)})`;
    document.getElementById('pnum')!.textContent = '#' + String(num).padStart(4, '0');
    document.getElementById('pname')!.textContent = name;
    document.getElementById('ptypes')!.innerHTML = types.map((t) => `<a href="/types/${t.toLowerCase()}/" style="background:${TC[t]};color:${LIGHT.has(t) ? '#2e1a20' : '#fff'}">${t}</a>`).join('');
    (document.getElementById('part') as HTMLImageElement).src = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/home/${art}.png`;
    const labels = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
    document.getElementById('pstats')!.innerHTML = stats.map((v, i) => `<span class="ps"><span>${labels[i]}</span><b>${v}</b><i><u style="width:${Math.min(100, v / 1.6)}%;background:${col(v)}"></u></i></span>`).join('') + `<span class="ps tot"><span>Total</span><b>${stats.reduce((a, b) => a + b, 0)}</b><i></i></span>`;
    document.getElementById('pab')!.innerHTML = 'Abilities ' + abil.map((a) => `<a href="/abilities/${slug(a)}/">${a}</a>`).join(', ') + (hidden ? ` · <a href="/abilities/${slug(hidden)}/">${hidden}</a> <span class="hid">(hidden)</span>` : '');
    document.getElementById('pev')!.innerHTML = `EV yield <b>${ev || '—'}</b>`;
    document.getElementById('pspawn')!.innerHTML = spawn ? `<img src="/cobbleverse.png" alt="" width="16" height="16"> ${spawn}` : 'No natural Cobbleverse spawn';
  });
</script>

<style>
  .hero { position: relative; overflow: hidden; margin: -1.4rem calc(50% - 50vw) 0; padding: 3.4rem 1.2rem 6rem; text-align: center; color: var(--on-brick); background: var(--brick-deep); }
  .blur { position: absolute; inset: 0; background: linear-gradient(rgb(53 24 32 / .84), rgb(53 24 32 / .84)), url(/hero-battle.webp) center 35% / cover; }
  .hero-in { position: relative; }
  .logo { margin: 0; font-size: clamp(3.4rem, 8vw, 4.8rem); font-weight: 800; line-height: 1; color: #f6e7e2; }
  .word { position: relative; display: inline-block; }
  .word img { position: absolute; right: calc(100% + .2em); top: 50%; transform: translateY(-50%); width: 1.05em; height: 1.05em; image-rendering: pixelated; }
  .tag { margin: .6rem 0 1.5rem; font-size: 1.1rem; opacity: .85; }
  .big { display: flex; max-width: 640px; margin: 0 auto; background: #fff7f5; border: 3px solid #07142a; box-shadow: 5px 5px 0 #07142a; position: relative; text-align: left; }
  .big input { flex: 1; border: 0; background: none; font: inherit; font-size: 1.1rem; padding: .9rem 1rem; color: var(--ink); min-width: 0; }
  .big input:focus { outline: none; }
  .big button { font: inherit; font-weight: 800; font-size: 1.05rem; background: #59c4fb; color: #07142a; border: 0; border-left: 3px solid #07142a; padding: 0 1.5rem; cursor: pointer; }
  .big button:hover { background: #7fd3ff; }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; max-width: 900px; margin-left: auto; margin-right: auto; margin-top: -3.4rem; position: relative; }
  .tile { display: flex; flex-direction: column; align-items: center; gap: .3rem; padding: .9rem .3rem .8rem; background: #fff7f5; border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); text-decoration: none; color: var(--ink); text-align: center; transition: transform .08s, box-shadow .08s; }
  .tile:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); color: var(--ink); }
  .tile img { width: 56px; height: 56px; image-rendering: pixelated; margin: -4px 0; }
  .tile b { font-size: .95rem; }
  .mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; width: 38px; height: 38px; margin: 5px 0; }
  .mini i { display: block; border: 1px solid rgb(0 0 0 / .25); }
  .potd { display: grid; grid-template-columns: 250px 1fr 290px; align-items: center; gap: 1.4rem; margin-top: 2.2rem; min-height: 230px; color: #fff; text-decoration: none; border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); background: var(--brick); overflow: hidden; }
  .potd a { color: #fff; }
  .potd a:hover { color: #fff; text-decoration: underline; }
  .pab :global(a), .pty :global(a) { color: #fff !important; }
  .pab :global(a) { font-weight: 700; text-decoration: none; }
  .pab :global(a:hover) { text-decoration: underline; }
  .pa { text-decoration: none !important; align-self: stretch; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle, rgb(255 255 255 / .24), transparent 66%); }
  .pa img { width: 210px; height: 210px; object-fit: contain; animation: drift 6s ease-in-out infinite; will-change: transform; backface-visibility: hidden; }
  .pa { filter: drop-shadow(0 10px 10px rgb(0 0 0 / .35)); }
  /* small slow loop: a few pixels around a circle */
  @keyframes drift { 0%, 100% { transform: translate3d(0, 0, 0); } 25% { transform: translate3d(2px, -2px, 0); } 50% { transform: translate3d(0, -4px, 0); } 75% { transform: translate3d(-2px, -2px, 0); } }
  .pl { display: block; font-size: .85rem; font-weight: 700; opacity: .85; }
  .pn { display: inline-block; text-decoration: none; font-size: 2.6rem; font-weight: 800; line-height: 1.05; margin: .15rem 0 .5rem; }
  .pty { display: flex; gap: .3rem; }
  .pty :global(a) { text-decoration: none !important;  font-size: .78rem; font-weight: 700; padding: .05rem .55rem; border: 1px solid rgb(0 0 0 / .3); }
  .pinfo { display: flex; gap: 1.4rem; flex-wrap: wrap; margin-top: 1rem; font-size: .9rem; }
  .pinfo > span { display: flex; align-items: center; gap: .4rem; }
  .pab { display: block; margin-top: .55rem; font-size: .9rem; }
  .pab :global(.hid) { opacity: .75; }
  .pstats { background: rgb(0 0 0 / .28); padding: .8rem 1rem; margin-right: 1.4rem; }
  .pstats :global(.ps) { display: grid; grid-template-columns: 42px 36px 1fr; gap: .4rem; align-items: center; font-size: .85rem; margin: .1rem 0; }
  .pstats :global(.ps i) { height: 7px; background: rgb(255 255 255 / .15); }
  .pstats :global(.ps.tot i) { background: none; }
  .pstats :global(.ps u) { display: block; height: 100%; }
  .about { text-align: center; margin-top: 2.4rem; }
  .about p { max-width: 60ch; margin: 0 auto .5rem; color: var(--ink-soft); }
  @media (prefers-reduced-motion: reduce) { .pa img { animation: none; } }
  @media (max-width: 1000px) { .potd { grid-template-columns: 180px 1fr; } .pa img { width: 160px; height: 160px; } .pstats { grid-column: 1 / -1; margin: 0 1.2rem 1.2rem; } }
  @media (max-width: 560px) { .tiles { grid-template-columns: repeat(2, 1fr); } .potd { grid-template-columns: 1fr; text-align: center; } .pty, .pinfo { justify-content: center; } .pm { padding: 0 1rem; } }
</style>
