---
import Base from '../layouts/Base.astro';
import { moves, abilities, items, meta, groups } from '../lib/data';
import { TYPES, typeColors } from '../lib/types';
const ITEM = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/';
const tiles = [
  { href: '/pokedex/', name: 'Pokédex', icon: 'poke-ball', text: `${groups.length} Pokémon` },
  { href: '/moves/', name: 'Moves', icon: 'tm-normal', text: `${moves.length} moves` },
  { href: '/abilities/', name: 'Abilities', icon: 'ability-capsule', text: `${abilities.length} abilities` },
  { href: '/types/', name: 'Type chart', icon: null, text: 'Matchups' },
];
const _tries = [['Garchomp', '/pokemon/garchomp/'], ['Fake Out', '/moves/fake-out/'], ['Intimidate', '/abilities/intimidate/'], ['Choice Scarf', '/items/choice-scarf/']];
---
<Base description="Stats, type matchups, movepools, tiers and evolutions from across the major Pokémon sites in one place, built around Cobbleverse spawns and movepools.">
  <section class="hero" id="potd">
    <div class="hero-in">
      <div class="left">
        <h1>Welcome to ARdex</h1>
        <form class="big" role="search">
          <input data-find placeholder="Search a Pokémon, move, ability or item…" autocomplete="off" aria-label="Search" />
          <button type="submit">Search</button>
        </form>
        <span class="pl">Pokémon of the day · <span id="pnum"></span><span class="pnext" id="pnext" title="Time until the next Pokémon of the day"></span></span>
        <a class="pn" id="pname" href="/pokedex/">&nbsp;</a>
        <span class="pty" id="ptypes"></span>
        <span class="pinfo"><span id="pev"></span><span id="pspawn"></span></span>
        <span class="pab" id="pab"></span>
      </div>
      <div class="right">
        <a class="pa" id="partlink" href="/pokedex/"><img id="part" alt="" /></a>
        <span class="pstats" id="pstats"></span>
      </div>
    </div>
  </section>

  <div class="tiles">
    {tiles.map((t) => (
      <a href={t.href} class="tile">
        {t.icon ? <img src={ITEM + t.icon + '.png'} alt="" width="48" height="48" />
          : <span class="mini">{TYPES.slice(0, 9).map((x) => <i style={`background:${typeColors[x]}`}></i>)}</span>}
        <span><b>{t.name}</b><small>{t.text}</small></span>
      </a>
    ))}
  </div>

  <div class="about">
    <p>Every Pokémon site shows a different slice of the picture: PokemonDB has the clean stat pages, Bulbapedia the evolution and breeding details, Smogon the tiers, Serebii the locations. ARdex puts those pieces side by side on one page, and builds it around Cobbleverse {meta.cobbleverse}, with spawns and movepools read straight from the pack's own files. It's made for hunting, training and team building on the server.</p>
    <p class="note">Data from Cobbleverse, Pokémon Showdown and PokéAPI · Updated {meta.built} · Part of <a href="https://aeronregion.net">Aeron Region</a></p>
  </div>
</Base>

<script>
  // Pokémon of the day: same pick for everyone on a given date (local time).
  const nextEl = document.getElementById('pnext')!;
  const tickNext = () => { const n = new Date(), m = new Date(n.getFullYear(), n.getMonth(), n.getDate() + 1); const mins = Math.ceil((+m - +n) / 60000); nextEl.textContent = `next in ${Math.floor(mins / 60)}h ${String(mins % 60).padStart(2, '0')}m`; if (mins <= 0) location.reload(); };
  tickNext(); setInterval(tickNext, 30000);
  const TC: Record<string, string> = { Normal: '#a8a77a', Fire: '#ee8130', Water: '#6390f0', Electric: '#f7d02c', Grass: '#7ac74c', Ice: '#96d9d6', Fighting: '#c22e28', Poison: '#a33ea1', Ground: '#e2bf65', Flying: '#a98ff3', Psychic: '#f95587', Bug: '#a6b91a', Rock: '#b6a136', Ghost: '#735797', Dragon: '#6f35fc', Dark: '#705746', Steel: '#b7b7ce', Fairy: '#d685ad' };
  const LIGHT = new Set(['Normal', 'Electric', 'Grass', 'Ice', 'Ground', 'Flying', 'Bug', 'Rock', 'Steel', 'Fairy']);
  const shade = (hex: string, f: number) => '#' + [1, 3, 5].map((i) => Math.round(parseInt(hex.slice(i, i + 2), 16) * f).toString(16).padStart(2, '0')).join('');
  const col = (v: number) => v < 50 ? '#e06a5a' : v < 80 ? '#f2a65a' : v < 100 ? '#e8c64a' : v < 130 ? '#8cc35b' : '#3fa66a';
  fetch('/potd.json').then((r) => r.json()).then((list: [string, number, string[], number[], string, string, string, string | null, string[], string | null][]) => {
    const d = new Date(); const key = d.getFullYear() * 10000 + (d.getMonth() + 1) * 100 + d.getDate();
    let h = key; h = Math.imul(h ^ (h >>> 16), 0x45d9f3b) >>> 0; h = Math.imul(h ^ (h >>> 16), 0x45d9f3b) >>> 0; h = (h ^ (h >>> 16)) >>> 0;
    const [name, num, types, stats, ev, art, url, spawn, abil, hidden] = list[h % list.length];
    const card = document.getElementById('potd') as HTMLElement;
    const slug = (x: string) => x.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/['’.:%]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const c = TC[types[0]];
    (document.getElementById('partlink') as HTMLAnchorElement).href = url;
    (document.getElementById('pname') as HTMLAnchorElement).href = url;
    card.style.background = `radial-gradient(circle at 78% 42%, rgb(255 255 255 / .16), transparent 38%), linear-gradient(110deg, ${c}, ${shade(c, .55)} 58%, ${shade(c, .32)})`;
    document.getElementById('pnum')!.textContent = '#' + String(num).padStart(4, '0');
    document.getElementById('pname')!.textContent = name;
    document.getElementById('ptypes')!.innerHTML = types.map((t) => `<a href="/types/${t.toLowerCase()}/" style="background:${TC[t]};color:${LIGHT.has(t) ? '#2e1a20' : '#fff'}">${t}</a>`).join('');
    (document.getElementById('part') as HTMLImageElement).src = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/home/${art}.png`;
    const labels = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
    document.getElementById('pstats')!.innerHTML = stats.map((v, i) => `<span class="ps"><span>${labels[i]}</span><b>${v}</b><i><u style="width:${Math.min(100, v / 1.6)}%;background:${col(v)}"></u></i></span>`).join('') + `<span class="ps tot"><span>Total</span><b>${stats.reduce((a, b) => a + b, 0)}</b><i></i></span>`;
    document.getElementById('pab')!.innerHTML = 'Abilities ' + abil.map((a) => `<a href="/abilities/${slug(a)}/">${a}</a>`).join(', ') + (hidden ? ` · <a href="/abilities/${slug(hidden)}/">${hidden}</a> <span class="hid">(hidden)</span>` : '');
    document.getElementById('pev')!.innerHTML = `EV yield <b>${ev || '—'}</b>`;
    document.getElementById('pspawn')!.innerHTML = spawn ? `<img src="/cobbleverse.png" alt="" width="16" height="16"> ${spawn}` : 'No natural Cobbleverse spawn';
  });
</script>

<style>
  .hero { margin: -1.4rem calc(50% - 50vw) 0; padding: 2.8rem 1.25rem 5.4rem; color: #fff; background: linear-gradient(110deg, #5a2731, #351820); min-height: 520px; }
  .hero-in { width: min(100%, 1180px); margin: 0 auto; display: grid; grid-template-columns: 1fr 420px; gap: 2rem; align-items: center; }
  .hero a { color: #fff; }
  h1 { font-size: 1.45rem; font-weight: 600; margin: 0 0 1.1rem; opacity: .95; text-shadow: 0 1px 3px rgb(0 0 0 / .3); }
  .big { display: flex; max-width: 580px; background: #fff7f5; border: 3px solid #07142a; box-shadow: 5px 5px 0 #07142a; position: relative; margin-bottom: 2.2rem; }
  .big input { flex: 1; border: 0; background: none; font: inherit; font-size: 1.08rem; padding: .85rem 1rem; color: var(--ink); min-width: 0; }
  .big input:focus { outline: none; }
  .big button { font: inherit; font-weight: 800; font-size: 1.05rem; background: #59c4fb; color: #07142a; border: 0; border-left: 3px solid #07142a; padding: 0 1.4rem; cursor: pointer; }
  .big button:hover { background: #7fd3ff; }
  .pl { display: block; font-size: .85rem; font-weight: 700; opacity: .85; }
  .pn { display: inline-block; font-size: clamp(2.8rem, 6vw, 4rem); font-weight: 800; line-height: 1; margin: .15rem 0 .55rem; text-decoration: none; text-shadow: 0 2px 6px rgb(0 0 0 / .3); }
  .pn:hover { opacity: .85; }
  .pty { display: flex; gap: .3rem; }
  .pty :global(a) { font-size: .8rem; font-weight: 700; padding: .05rem .6rem; border: 1px solid rgb(0 0 0 / .3); text-decoration: none; color: #fff !important; }
  .pinfo { display: flex; gap: 1.4rem; flex-wrap: wrap; margin-top: 1rem; font-size: .95rem; }
  .pinfo > span { display: flex; align-items: center; gap: .4rem; }
  .pab { display: block; margin-top: .5rem; font-size: .95rem; }
  .pab :global(a) { font-weight: 700; text-decoration: none; color: #fff !important; }
  .pab :global(a:hover) { opacity: .85; }
  .pab :global(.hid) { opacity: .75; }
  .right { display: flex; flex-direction: column; align-items: center; gap: .6rem; }
  .pa { display: block; filter: drop-shadow(0 14px 14px rgb(0 0 0 / .35)); }
  .pa img { width: 340px; height: 340px; object-fit: contain; animation: drift 6s ease-in-out infinite; will-change: transform; }
  @keyframes drift { 0%, 100% { transform: translate3d(0, 0, 0); } 25% { transform: translate3d(2px, -2px, 0); } 50% { transform: translate3d(0, -4px, 0); } 75% { transform: translate3d(-2px, -2px, 0); } }
  .pstats { width: 300px; background: rgb(0 0 0 / .28); padding: .7rem .9rem; }
  .pstats :global(.ps) { display: grid; grid-template-columns: 42px 36px 1fr; gap: .4rem; align-items: center; font-size: .85rem; margin: .1rem 0; }
  .pstats :global(.ps i) { height: 7px; background: rgb(255 255 255 / .18); }
  .pstats :global(.ps.tot i) { background: none; }
  .pstats :global(.ps u) { display: block; height: 100%; }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: -2.8rem; position: relative; }
  .tile { display: flex; gap: .8rem; align-items: center; padding: .9rem 1rem; background: #fff7f5; border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--ink); text-decoration: none; color: var(--ink); transition: transform .08s, box-shadow .08s; }
  .tile:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--ink); color: var(--ink); }
  .tile img { width: 48px; height: 48px; image-rendering: pixelated; margin: -4px; flex: none; }
  .tile b { display: block; font-size: 1.05rem; }
  .tile small { display: block; color: var(--ink-soft); font-size: .84rem; line-height: 1.3; }
  .mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; width: 34px; height: 34px; margin: 3px; flex: none; }
  .mini i { display: block; border: 1px solid rgb(0 0 0 / .25); }
  .about { text-align: center; margin-top: 2.4rem; }
  .about p { max-width: 60ch; margin: 0 auto .5rem; color: var(--ink-soft); }
  .pnext { margin-left: .6rem; font-weight: 500; font-size: .72rem; opacity: .55; }
  @media (prefers-reduced-motion: reduce) { .pa img { animation: none; } }
  @media (max-width: 960px) { .hero-in { grid-template-columns: 1fr; } .pa img { width: 220px; height: 220px; } .tiles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) {
    .hero { padding: 1.6rem 1rem 4rem; min-height: 0; }
    .tiles { grid-template-columns: 1fr 1fr; gap: .6rem; }
    .tile { padding: .6rem; gap: .5rem; } .tile img { width: 36px; height: 36px; } .tile small { display: none; }
    .big { margin-bottom: 1.4rem; } .big input { font-size: 1rem; padding: .7rem .8rem; } .big button { padding: 0 .9rem; font-size: .95rem; }
    .right { display: grid !important; grid-template-columns: 120px 1fr; align-items: center; gap: .8rem; margin-top: 1rem; }
    .pa img { width: 120px; height: 120px; }
    .pstats { width: 100%; padding: .6rem .7rem !important; font-size: .82rem; }
    .pinfo { gap: .4rem 1rem; }
  }
</style>
