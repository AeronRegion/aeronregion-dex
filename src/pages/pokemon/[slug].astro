---
import Base from '../../layouts/Base.astro';
import PokemonForm from '../../components/PokemonForm.astro';
import { groups, slug, pokeUrl, formSlug, formLabel } from '../../lib/data';

export function getStaticPaths() {
  return groups.map((forms, i) => ({
    params: { slug: slug(forms[0].name) },
    props: { forms, prev: groups[i - 1]?.[0] ?? null, next: groups[i + 1]?.[0] ?? null },
  }));
}
const { forms, prev, next } = Astro.props as { forms: any[]; prev: any; next: any };
const base = forms[0];
const num = (s: any) => '#' + String(s.num).padStart(4, '0');
---
<Base title={`${base.name} Pokédex: stats, moves & spawns`} description={`${base.name}: stats, type matchups, evolutions, where to find it and every move it learns.`}>
  <nav class="pn" aria-label="Previous and next Pokémon">
    {prev ? <a href={pokeUrl(prev)} rel="prev">← <span class="soft">{num(prev)}</span> {prev.name}</a> : <span></span>}
    {next ? <a href={pokeUrl(next)} rel="next">{next.name} <span class="soft">{num(next)}</span> →</a> : <span></span>}
  </nav>

  <div class="formtabs" role="tablist" aria-label="Forms">
    {forms.map((s, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-f={formSlug(s)}>{formLabel(s)}</button>)}
  </div>

  {forms.map((s, i) => <PokemonForm s={s} first={i === 0} />)}
</Base>

<script>
  // Form tabs. The URL hash remembers the form and tab: #mega, #moves, #mega:moves
  const formTabs = document.querySelectorAll<HTMLButtonElement>('.formtabs button');
  const showForm = (f: string) => {
    let found = false;
    document.querySelectorAll<HTMLElement>('.form').forEach((el) => { const on = el.dataset.form === f; el.hidden = !on; found ||= on; });
    if (!found) { document.querySelectorAll<HTMLElement>('.form').forEach((el, i) => (el.hidden = i !== 0)); f = ''; }
    formTabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.f === f)));
  };
  const writeHash = () => {
    const f = document.querySelector<HTMLElement>('.form:not([hidden])')?.dataset.form ?? '';
    const moves = document.querySelector('.form:not([hidden]) [data-tab="moves"][aria-selected="true"]') ? 'moves' : '';
    const h = [f, moves].filter(Boolean).join(':');
    history.replaceState(null, '', h ? `#${h}` : location.pathname);
  };
  formTabs.forEach((b) => b.addEventListener('click', () => { showForm(b.dataset.f!); writeHash(); }));
  document.addEventListener('form-state', writeHash);
  const readHash = () => {
    const parts = decodeURIComponent(location.hash.slice(1)).split(':');
    const tab = parts.includes('moves') ? 'moves' : 'overview';
    const f = parts.find((p) => p && p !== 'moves') ?? '';
    showForm(f);
    document.querySelectorAll('.form').forEach((el) => el.dispatchEvent(new CustomEvent('show-tab', { detail: tab })));
  };
  readHash();
  window.addEventListener('hashchange', readHash);
</script>

<style>
  .pn { display: flex; justify-content: space-between; gap: 1rem; margin: -.4rem 0 .8rem; padding-bottom: .5rem; border-bottom: 1px solid var(--line); font-size: .95rem; }
  .pn a { text-decoration: none; color: var(--ink); font-weight: 600; white-space: nowrap; }
  .pn a:hover { color: var(--hover); }
  .formtabs { display: flex; flex-wrap: nowrap; overflow-x: auto; scrollbar-width: thin; gap: 0; margin-bottom: 1rem; border-bottom: 3px solid var(--ink); }
  .formtabs button { white-space: nowrap; flex: none; }
  .formtabs button { font: inherit; font-weight: 600; font-size: .92rem; padding: .4rem 1rem; background: none; color: var(--ink-soft); border: 2px solid transparent; border-bottom: 0; cursor: pointer; margin-bottom: -3px; }
  .formtabs button:hover { color: var(--ink); }
  .formtabs button[aria-selected='true'] { color: var(--ink); background: var(--blossom); border-color: var(--ink); }
</style>
