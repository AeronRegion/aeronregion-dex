---
import Base from '../../layouts/Base.astro';
import Type from '../../components/Type.astro';
import { species, pokeUrl, iconUrl, boxIconUrl } from '../../lib/data';
const egg = (g: string) => g.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const list = species.filter((s) => !s.forme && s.eggGroups?.length);
const counts = new Map<string, number>();
for (const s of list) for (const g of s.eggGroups) counts.set(g, (counts.get(g) ?? 0) + 1);
const all = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Egg groups" description="Every Pokémon egg group and which Pokémon can breed together.">
  <h1 id="h">Egg groups</h1>
  <p class="note" id="note">Two Pokémon can breed if they share an egg group.</p>
  <div class="controls"><span class="lab">Egg group</span><select class="field" id="pickg">{all.map(([g, n]) => <option value={egg(g)} data-g={g}>{g} ({n})</option>)}</select></div>
  <table class="data sortable" id="eg" hidden>
    <thead><tr><th data-sort="num">#</th><th></th><th data-sort="text">Name</th><th>Type</th><th data-sort="text">Other group</th></tr></thead>
    <tbody>{list.map((s) => (
      <tr data-g={s.eggGroups.join('|')} hidden>
        <td class="n soft" data-v={s.num}>{String(s.num).padStart(4, '0')}</td>
        <td><img class="sprite" src={boxIconUrl(s.art)} data-fb={iconUrl(s.art)} onerror="if(this.dataset.fb&&this.src!==this.dataset.fb){this.src=this.dataset.fb;this.classList.add('fb')}" alt="" loading="lazy" width="40" height="30" /></td>
        <td><a href={pokeUrl(s)}>{s.name}</a></td>
        <td><div class="chips">{s.types.map((t: string) => <Type type={t} small />)}</div></td>
        <td class="other"></td>
      </tr>
    ))}</tbody>
  </table>
  <script>
    const sel = document.getElementById('pickg') as HTMLSelectElement; const btns = [...sel.options].map((o) => ({ dataset: { s: o.value, g: o.dataset.g } }));
    const table = document.getElementById('eg') as HTMLTableElement, rows = [...table.tBodies[0].rows];
    const h = document.getElementById('h')!, note = document.getElementById('note')!;
    const show = (s: string) => {
      const b = btns.find((x) => x.dataset.s === s); if (!b) return;
      const g = b.dataset.g!; let n = 0;
      sel.value = s;
      for (const r of rows) {
        const gs = r.dataset.g!.split('|'), on = gs.includes(g); r.hidden = !on;
        if (on) { n++; const o = gs.filter((x) => x !== g); const c = r.querySelector('.other') as HTMLElement; c.dataset.v = o.join(' ');
          c.innerHTML = o.map((x) => `<a href="#${btns.find((y) => y.dataset.g === x)!.dataset.s}">${x}</a>`).join(', '); }
      }
      table.hidden = false;
      h.innerHTML = `${g} <span class="kind">(egg group)</span>`;
      note.textContent = `${n} Pokémon. ` + (g === 'Undiscovered' ? "These can't breed." : g === 'Ditto' ? 'Ditto can breed with any Pokémon outside Undiscovered.' : 'Any two of these can breed, as can any of them with Ditto.');
      document.title = `${g} egg group | ARdex`;
    };
    sel.addEventListener('change', () => { history.replaceState(null, '', '#' + sel.value); show(sel.value); });
    const go = () => show(location.hash.slice(1) || 'amorphous');
    window.addEventListener('hashchange', go); go();
  </script>
</Base>
<style>

  #eg td, #eg th { padding-top: .2rem; padding-bottom: .2rem; }
</style>
