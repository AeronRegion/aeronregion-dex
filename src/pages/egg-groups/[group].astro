---
import Base from '../../layouts/Base.astro';
import Type from '../../components/Type.astro';
import { species, pokeUrl, iconUrl } from '../../lib/data';
const egg = (g: string) => g.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
export function getStaticPaths() {
  const egg = (g: string) => g.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const names = new Set<string>(); for (const s of species) for (const g of s.eggGroups ?? []) names.add(g);
  return [...names].map((g) => ({ params: { group: egg(g) }, props: { g } }));
}
const { g } = Astro.props as { g: string };
const list = species.filter((s) => !s.forme && s.eggGroups?.includes(g));
const counts = new Map<string, number>();
for (const s of species) if (!s.forme) for (const x of s.eggGroups ?? []) counts.set(x, (counts.get(x) ?? 0) + 1);
const all = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title={`${g} egg group`} description={`Every Pokémon in the ${g} egg group.`}>
  <h1>{g} <span class="kind">(egg group)</span></h1>
  <p class="note">{list.length} Pokémon. {g === 'Undiscovered' ? "These can't breed." : g === 'Ditto' ? 'Ditto can breed with any Pokémon outside Undiscovered.' : 'Any two of these can breed, as can any of them with Ditto.'}</p>
  <nav class="groups">{all.map(([x, n]) => <a href={`/egg-groups/${egg(x)}/`} aria-current={x === g ? 'page' : undefined}>{x} <span>{n}</span></a>)}</nav>
  <table class="data sortable" id="eg">
    <thead><tr><th data-sort="num">#</th><th></th><th data-sort="text">Name</th><th>Type</th><th data-sort="text">Other group</th></tr></thead>
    <tbody>{list.map((s) => { const other = s.eggGroups.filter((x: string) => x !== g); return (
      <tr>
        <td class="n soft" data-v={s.num}>{String(s.num).padStart(4, '0')}</td><td><img class="sprite" src={iconUrl(s.art)} alt="" loading="lazy" width="32" height="32" /></td>
        <td><a href={pokeUrl(s)}>{s.name}</a></td>
        <td><div class="chips">{s.types.map((t: string) => <Type type={t} small />)}</div></td>
        <td data-v={other.join(' ')}>{other.map((x: string, i: number) => <>{i > 0 && ', '}<a href={`/egg-groups/${egg(x)}/`}>{x}</a></>)}</td>
      </tr>
    ); })}</tbody>
  </table>
</Base>
<style>
  #eg { max-width: 720px; }
  #eg td, #eg th { padding-top: .2rem; padding-bottom: .2rem; }
  #eg td.n { white-space: nowrap; } #eg .sprite { width: 32px; height: 32px; }
  #eg tbody tr:nth-child(even) { background: rgb(255 255 255 / .35); }
  .groups { display: flex; flex-wrap: wrap; gap: .35rem; margin: .8rem 0 1rem; }
  .groups a { font-weight: 700; font-size: .85rem; padding: .15rem .55rem; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; background: #fff7f5; }
  .groups a span { font-weight: 500; color: var(--ink-soft); }
  .groups a[aria-current] { background: var(--ink); color: #fff; } .groups a[aria-current] span { color: #e8d3d0; }
</style>
