---
import Base from '../layouts/Base.astro';
import { TYPES, dbTypeColors } from '../lib/types';
import { GAMES, meta } from '../lib/data';
---
<Base title="Teambuilder" description="Build Pokémon teams with full Showdown sets: abilities, items, moves, natures, EVs, IVs and Tera types, with calculated stats.">
  <h1>Teambuilder</h1>
  <div class="bar">
    <label class="lab2">Team
      <select class="field" id="teams" aria-label="Saved teams"></select>
    </label>
    <input class="field tname" id="tname" placeholder="Team name" aria-label="Team name" />
    <button class="sm" id="new" type="button">New team</button>
    <button class="sm" id="del" type="button">Delete team</button>
    <label class="lab2">Format
      <select class="field" id="fmt">
        <option value="all" selected>All games</option>
        <option value="champ">Pokémon Champions (Stat Points)</option>
        {meta.cobbleverse && <option value="0">Cobbleverse {meta.cobbleverse}</option>}
        {[9, 8, 7].map((g) => <option value={g}>{GAMES[g]}</option>)}
      </select>
    </label>
  </div>
  <div class="bar">
    <button class="sm" id="imp" type="button">Import</button>
    <button class="sm" id="paste" type="button">Create PokéPaste ↗</button>
    <button class="sm" id="share" type="button">Copy link</button>
    <a class="sm" id="cov" href="/coverage/">Check coverage</a>
    <span class="soft" id="saved" aria-live="polite"></span>
  </div>
  <div id="impbox" class="impbox" hidden>
    <textarea class="field" id="imptext" rows="10" placeholder="Paste a whole team or a single Pokémon in Showdown format, or a link to one…"></textarea>
    <div><button class="sm" id="impgo" type="button">Replace team</button> <button class="sm" id="impadd" type="button">Add to team</button> <button class="sm" id="impx" type="button">Cancel</button></div>
  </div>
  <p class="note" id="msg" aria-live="polite"></p>

  <div class="strip" id="strip"></div>
  <div id="ed" class="ed" hidden></div>

  <script define:vars={{ TYPES, COLORS: dbTypeColors }}>
    window.__TB = { TYPES, COLORS };
  </script>
  <script>
    import { autocomplete, CAT_SVG } from '../lib/ac';
    import { parseShowdown, moveId } from '../lib/showdown';
    const { TYPES, COLORS } = (window as any).__TB as { TYPES: string[]; COLORS: Record<string, string> };
    type Sp = [string, string, string[], string | null, number, string, string[], string | null];
    type Idx = { species: Sp[]; moves: Record<string, [string, string, string]>; learn: Record<string, number[]> };
    type Tb = { stats: number[][]; items: [string, string, string][]; abilities: Record<string, string>; moves: Record<string, [number | null, number | null, number, string]> };
    type Set6 = [number, number, number, number, number, number];
    type Mon = { sp: string; ab: string; item: string; moves: string[]; nature: string; evs: Set6; ivs: Set6; level: number; tera: string; shiny?: boolean; gender?: string };
    type Team = { id: string; name: string; fmt: string; mons: Mon[] };

    const $ = (id: string) => document.getElementById(id)!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const toID = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
    const SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/';
    const chip = (t: string) => `<span class="tchip" data-type="${t}" style="background:${COLORS[t] ?? '#888'}">${t}</span>`;
    const STAT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
    const STATNAME = ['HP', 'Attack', 'Defense', 'Sp. Atk.', 'Sp. Def.', 'Speed'];
    // nature -> [raised stat index, lowered stat index] (1..5); neutral natures have equal indexes
    const NAT: Record<string, [number, number]> = {};
    [['Hardy', 'Lonely', 'Adamant', 'Naughty', 'Brave'], ['Bold', 'Docile', 'Impish', 'Lax', 'Relaxed'], ['Modest', 'Mild', 'Bashful', 'Rash', 'Quiet'], ['Calm', 'Gentle', 'Careful', 'Quirky', 'Sassy'], ['Timid', 'Hasty', 'Jolly', 'Naive', 'Serious']]
      .forEach((row, r) => row.forEach((n, c) => (NAT[n] = [r + 1, c + 1])));
    const natLabel = (n: string) => { const [u, d] = NAT[n]; return u === d ? `${n} (neutral)` : `${n} (+${STAT[u]}, −${STAT[d]})`; };

    let idx: Idx, tb: Tb;
    let learnable: Map<number, [string, number][]> | null = null;
    const spIndex = new Map<string, number>();
    const fmtSel = $('fmt') as HTMLSelectElement;
    const learnOf = (i: number) => {
      if (!learnable) { learnable = new Map(); for (const [m, arr] of Object.entries(idx.learn)) for (let k = 0; k < arr.length; k += 2) { const e: [string, number] = [m, arr[k + 1]]; const l = learnable.get(arr[k]); l ? l.push(e) : learnable.set(arr[k], [e]); } }
      const w = fmtSel.value === 'all' || fmtSel.value === 'champ' ? -1 : 1 << +fmtSel.value;
      return (learnable.get(i) ?? []).filter(([, mask]) => mask & w).map(([m]) => m);
    };
    const spOf = (m: Mon) => idx.species[spIndex.get(m.sp) ?? 0];
    const isEmpty = (m: Mon) => !spIndex.has(m.sp);
    const itemIcon = (name: string) => { const it = name ? tb.items.find((x) => x[0] === name) : null; return it?.[1] ? SPR + 'items/' + it[1] + '.png' : ''; };
    // Showdown teambuilder bars: length and color come from the calculated stat, so they move with EVs, IVs, nature and level
    const sdBar = (v: number, k: number) => `width:${Math.min(179, Math.floor(v * 180 / (k ? 504 : 704)))}px;background:hsl(${Math.min(360, Math.floor(v * 180 / 714))}, 85%, 45%)`;
    const abilitiesOf = (s: Sp) => [...s[6], ...(s[7] ? [s[7]] : [])];
    const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
    const moveName = (id: string) => { const hp = id.match(/^hiddenpower-(\w+)$/); if (hp) return `Hidden Power [${cap(hp[1])}]`; return idx.moves[id]?.[0] ?? ''; };
    const moveType = (id: string) => { const hp = id.match(/^hiddenpower-(\w+)$/); if (hp) return cap(hp[1]); return idx.moves[id]?.[1] ?? ''; };
    const newMon = (i: number): Mon => { const s = idx.species[i]; return { sp: s[0], ab: abilitiesOf(s)[0] ?? '', item: '', moves: ['', '', '', ''], nature: 'Serious', evs: [0, 0, 0, 0, 0, 0], ivs: [31, 31, 31, 31, 31, 31], level: 50, tera: s[2][0] }; };
    // Pokémon Champions: Stat Points (66 total, 32 per stat) instead of EVs; always Lv 50 with 31 IVs.
    // The first point is worth 4 EVs and each one after it 8, so 32 SP = 252 EVs.
    const champ = () => team().fmt === 'champ';
    const spToEv = (sp: number) => (sp > 0 ? Math.min(252, 4 + 8 * (sp - 1)) : 0);
    const evToSp = (ev: number) => (ev >= 4 ? Math.min(32, 1 + Math.floor((ev - 4) / 8)) : 0);
    // Converting a set to the team's format: EVs -> Stat Points (Champions, 66 total / 32 per stat, Lv 50, 31 IVs) or back
    const fitTo = (m: Mon, toChamp: boolean, isSp: boolean) => {
      if (toChamp && !isSp) {
        const sp = m.evs.map(evToSp);
        while (sp.reduce((a, b) => a + b, 0) > 66) { const i = sp.indexOf(Math.max(...sp)); sp[i]--; }
        m.evs = sp as Set6; m.level = 50; m.ivs = [31, 31, 31, 31, 31, 31]; return true;
      }
      if (!toChamp && isSp) {
        const ev = m.evs.map(spToEv);
        while (ev.reduce((a, b) => a + b, 0) > 510) { const i = ev.indexOf(Math.max(...ev)); ev[i] -= 4; }
        m.evs = ev as Set6; return true;
      }
      if (toChamp) { m.level = 50; m.ivs = [31, 31, 31, 31, 31, 31]; }
      return false;
    };
    const CAP = () => (champ() ? { per: 32, total: 66, step: 1, label: 'Stat Points' } : { per: 252, total: 510, step: 4, label: 'EVs' });
    const statsOf = (m: Mon) => {
      const base = tb.stats[spIndex.get(m.sp) ?? 0]; const [u, d] = NAT[m.nature] ?? [1, 1];
      const c = champ(), lv = c ? 50 : m.level;
      return base.map((b, k) => {
        const ev = c ? spToEv(m.evs[k]) : m.evs[k], iv = c ? 31 : m.ivs[k];
        const core = Math.floor(((2 * b + iv + Math.floor(ev / 4)) * lv) / 100);
        if (k === 0) return m.sp === 'shedinja' ? 1 : core + lv + 10;
        return Math.floor((core + 5) * (u === d ? 1 : k === u ? 1.1 : k === d ? 0.9 : 1));
      });
    };

    // ---------- storage (this browser only) ----------
    const KEY = 'ardex-teams';
    let teams: Team[] = [];
    let cur = 0, sel = 0;
    const store = {
      get: () => { try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; } },
      set: (v: unknown) => { try { localStorage.setItem(KEY, JSON.stringify(v)); return true; } catch { return false; } },
    };
    const team = () => teams[cur];
    let savedTimer = 0;
    const save = () => {
      const ok = store.set(teams);
      $('saved').textContent = ok ? 'Saved in this browser' : "Couldn't save in this browser. Use Copy link to keep this team.";
      clearTimeout(savedTimer); savedTimer = window.setTimeout(() => ($('saved').textContent = ''), 2500);
      ($('cov') as HTMLAnchorElement).href = team().mons.some((m) => !isEmpty(m)) ? '/coverage/?team=' + encodeURIComponent(b64(exportText())) : '/coverage/';
    };
    const say = (t: string) => { $('msg').textContent = t; setTimeout(() => ($('msg').textContent = ''), 6000); };

    // ---------- Showdown text ----------
    const statLine = (v: Set6, skip: number) => v.map((x, k) => (x !== skip ? `${x} ${STAT[k]}` : '')).filter(Boolean).join(' / ');
    const monText = (m: Mon) => {
      const s = spOf(m); const lines = [`${s[1]}${m.gender ? ` (${m.gender})` : ''}${m.item ? ` @ ${m.item}` : ''}`];
      if (m.ab) lines.push(`Ability: ${m.ab}`);
      const c = champ();
      const lv = c ? 50 : m.level; if (lv !== 100) lines.push(`Level: ${lv}`);
      if (m.shiny) lines.push('Shiny: Yes');
      if (m.tera) lines.push(`Tera Type: ${m.tera}`);
      const ev = statLine((c ? m.evs.map(spToEv) : m.evs) as Set6, 0); if (ev) lines.push(`EVs: ${ev}`);
      lines.push(`${m.nature} Nature`);
      const iv = c ? '' : statLine(m.ivs, 31); if (iv) lines.push(`IVs: ${iv}`);
      for (const id of m.moves) if (id) lines.push(`- ${moveName(id)}`);
      return lines.join('\n');
    };
    const exportText = () => team().mons.filter((m) => !isEmpty(m)).map(monText).join('\n\n') + '\n';
    const b64 = (t: string) => btoa(unescape(encodeURIComponent(t)));
    const unb64 = (t: string) => decodeURIComponent(escape(atob(t)));
    const findSpecies = (name: string) => {
      const n = toID(name); let i = idx.species.findIndex((x) => toID(x[1]) === n || x[0] === n);
      if (i < 0 && name.includes('-')) i = idx.species.findIndex((x) => toID(x[1]) === toID(name.split('-')[0]));
      return i;
    };
    const parseTeam = (text: string) => {
      const out: Mon[] = []; const miss: string[] = [];
      const sets = parseShowdown(text, (n) => !!idx.moves[moveId(n, TYPES)] || /^hiddenpower-/.test(moveId(n, TYPES)), (n) => findSpecies(n) >= 0);
      // Champions spreads (66 points, 32 max) pasted as "EVs:" lines
      const looksSp = sets.some((x) => x.evs) && sets.every((x) => !x.evs || (x.evs.every((v) => v <= 32) && x.evs.reduce((a, b) => a + b, 0) <= 66));
      for (const x of sets) {
        const i = findSpecies(x.species); if (i < 0) { miss.push(x.species); continue; }
        const m = newMon(i); m.item = x.item; m.level = x.level ?? 100; m.shiny = x.shiny; m.gender = x.gender;
        if (x.ability) m.ab = x.ability; if (x.tera) m.tera = x.tera; if (x.nature && NAT[x.nature]) m.nature = x.nature;
        if (x.evs) m.evs = x.evs as Set6; if (x.ivs) m.ivs = x.ivs as Set6;
        m.moves = x.moves.map((n) => moveId(n, TYPES)).filter((id) => idx.moves[id] || /^hiddenpower-\w+$/.test(id)).slice(0, 4);
        while (m.moves.length < 4) m.moves.push('');
        out.push(m); if (out.length >= 14) break;
      }
      return { out, miss, looksSp };
    };
    const fromLink = (s: string) => { try { const u = new URL(s); const t = u.searchParams.get('team'); return t ? unb64(t) : null; } catch { return null; } };

    // ---------- rendering ----------
    const drawTeams = () => {
      ($('teams') as HTMLSelectElement).innerHTML = teams.map((t, k) => `<option value="${k}"${k === cur ? ' selected' : ''}>${esc(t.name || 'Untitled team')} (${t.mons.length})</option>`).join('');
      const tn = $('tname') as HTMLInputElement; if (document.activeElement !== tn) tn.value = team().name;
      fmtSel.value = team().fmt;
    };
    const drawStrip = () => {
      const t = team();
      $('strip').innerHTML = t.mons.map((m, k) => { const s = spOf(m); if (isEmpty(m)) return `<button type="button" class="slotb blank${k === sel ? ' on' : ''}" data-k="${k}" title="Empty slot"><span></span></button>`; return `<button type="button" class="slotb${k === sel ? ' on' : ''}" data-k="${k}" draggable="true" title="Drag to reorder"><img src="${s[3] ? SPR + 'pokemon/versions/generation-vii/icons/' + s[3] + '.png' : ''}" onerror="this.onerror=null;this.src=this.dataset.fb" data-fb="${s[3] ? SPR + 'pokemon/' + s[3] + '.png' : ''}" alt="" width="56" height="56" />${m.shiny ? '<i class="tabstar" title="Shiny">★</i>' : ''}<span>${esc(s[1])}</span></button>`; }).join('') +
        (t.mons.length < 14 ? `<button type="button" class="slotplus" id="plus" title="Add a Pokémon" aria-label="Add a Pokémon">+</button>` : '');
      document.getElementById('plus')?.addEventListener('click', () => { const m = newMon(0); m.sp = ''; m.ab = ''; t.mons.push(m); sel = t.mons.length - 1; drawTeams(); drawStrip(); drawEd(); setTimeout(() => { const f = $('f-sp') as HTMLInputElement | null; f?.focus(); f?.dispatchEvent(new Event('focus')); }, 0); });
    };
    const sortState: Record<string, { by: string; dir: number } | null> = {};
    // Showdown-style Pokémon filters: type, ability or move chips; a Pokémon must match all of them
    type Filt = { t: 'type' | 'ability' | 'move'; v: string; label: string };
    const filters: Filt[] = [];
    let allAb: string[] | null = null;
    const ALL_ABILITIES = () => (allAb ??= [...new Set(idx.species.flatMap((x) => [...x[6], ...(x[7] ? [x[7]] : [])]))].sort());
    const bboxCache = new Map<string, Promise<number[] | null>>();
    const bbox = (url: string) => {
      if (!bboxCache.has(url)) bboxCache.set(url, new Promise((res) => {
        const im = new Image(); im.crossOrigin = 'anonymous';
        im.onload = () => { try { const c = document.createElement('canvas'); c.width = im.naturalWidth; c.height = im.naturalHeight; const x = c.getContext('2d')!; x.drawImage(im, 0, 0); const d = x.getImageData(0, 0, c.width, c.height).data; let t = c.height, b = -1, l = c.width, r = -1; for (let y = 0; y < c.height; y += 2) for (let xx = 0; xx < c.width; xx += 2) if (d[(y * c.width + xx) * 4 + 3] > 20) { if (y < t) t = y; if (y > b) b = y; if (xx < l) l = xx; if (xx > r) r = xx; } res(b < 0 ? null : [l, t, r, b, c.width]); } catch { res(null); } };
        im.onerror = () => res(null); im.src = url;
      }));
      return bboxCache.get(url)!;
    };
    const fitShiny = async (img: HTMLImageElement, normalUrl: string) => {
      const [n, sh] = await Promise.all([bbox(normalUrl), bbox(img.src)]); if (!n || !sh) return;
      // match the shiny drawing's size and centre to the normal drawing's (both measured as a fraction of the image)
      const size = (q: number[]) => Math.max(q[2] - q[0], q[3] - q[1]) / q[4];
      const cx = (q: number[]) => (q[0] + q[2]) / 2 / q[4], cy = (q: number[]) => (q[1] + q[3]) / 2 / q[4];
      const k = size(n) / size(sh), S = img.clientWidth || 150;
      const tx = (cx(n) - k * cx(sh)) * S, ty = (cy(n) - k * cy(sh)) * S;
      if (Math.abs(1 - k) < 0.04 && Math.abs(tx) < 3 && Math.abs(ty) < 3) return;
      img.style.transformOrigin = '0 0'; img.style.transform = `translate(${tx.toFixed(1)}px, ${ty.toFixed(1)}px) scale(${k.toFixed(3)})`;
    };
    // type, category, power and accuracy shown beside each chosen move
    const moveInfo = (key: string) => {
      if (!key || !idx.moves[key]) return '<span class="minfo"></span>';
      const [, type, cat] = idx.moves[key]; const md = tb.moves[key] ?? [null, null, 0, ''];
      return `<span class="minfo"><svg viewBox="0 0 28 14" width="30" height="15" role="img" aria-label="${cat}"><title>${cat}</title>${CAT_SVG[cat] ?? ''}</svg><span class="pw"><small>Pow</small> ${md[0] ?? '—'}</span><span class="pw"><small>Acc</small> ${md[1] ?? '—'}</span></span>`;
    };
    const drawEd = () => {
      const t = team(); const ed = $('ed');
      if (!t.mons.length) { ed.hidden = true; return; }
      sel = Math.min(sel, t.mons.length - 1); ed.hidden = false;
      const m = t.mons[sel], s = spOf(m), st = statsOf(m), base = tb.stats[spIndex.get(m.sp) ?? 0], empty = isEmpty(m);
      ed.classList.toggle('empty', empty);
      const evTotal = m.evs.reduce((a, b) => a + b, 0);
      const [u, d] = NAT[m.nature]; const cap = CAP(), c = champ();
      const mark = (k: number) => (k && u !== d ? (k === u ? 'up' : k === d ? 'down' : '') : '');
      const sfx = (k: number) => (mark(k) === 'up' ? '+' : mark(k) === 'down' ? '-' : '');
      const evTot = m.evs.reduce((a, b) => a + b, 0);
      const SHORT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
      // Showdown's compact layout: one set card on top (art, details, names, moves, stat summary), then the stat editor and the pick list side by side
      ed.classList.add('sd');
      ed.innerHTML = `
        <button type="button" class="ecalc" id="f-calc" title="Open this Pokémon in the damage calculator">Damage calc</button><button type="button" class="edel" id="f-rm" title="Delete this Pokémon from the team">🗑 Delete</button>
        <div class="setcard">
          <div class="c-art who">${itemIcon(m.item) ? `<img class="whoitem" src="${itemIcon(m.item)}" alt="${esc(m.item)}" title="${esc(m.item)}" width="32" height="32" />` : ''}<img src="${s[3] ? SPR + 'pokemon/other/home/' + (m.shiny ? 'shiny/' : '') + s[3] + '.png' : ''}" data-fb="${s[3] ? SPR + 'pokemon/other/official-artwork/' + (m.shiny ? 'shiny/' : '') + s[3] + '.png' : ''}" onerror="if(this.dataset.fb&&this.src!==this.dataset.fb)this.src=this.dataset.fb" alt="${m.shiny ? 'Shiny ' : ''}${esc(s[1])}" width="104" height="104" />${m.shiny ? '<span class="shinytag" title="Shiny">★</span>' : ''}</div>
          <div class="c-det">
            <span class="cap">Details</span>
            <div class="detbox">
              <label><small>Level</small><input class="field" id="f-lv" type="number" min="1" max="100" value="${c ? 50 : m.level}"${c ? ' disabled title="Champions battles are always Lv. 50"' : ''} /></label>
              <label><small>Gender</small><select class="field" id="f-gen"><option value=""${!m.gender ? ' selected' : ''}>—</option><option value="M"${m.gender === 'M' ? ' selected' : ''}>M</option><option value="F"${m.gender === 'F' ? ' selected' : ''}>F</option></select></label>
              <label><small>Shiny</small><span class="shinybox"><input type="checkbox" id="f-shiny"${m.shiny ? ' checked' : ''} /></span></label>
              <label><small>Tera</small><select class="field" id="f-tera">${[...TYPES, 'Stellar'].map((x) => `<option${x === m.tera ? ' selected' : ''}>${x}</option>`).join('')}</select></label>
            </div>
            <div class="types">${s[2].map(chip).join(' ')} <a href="${s[5]}" class="dexl">Dex page</a></div>
          </div>
          <div class="c-nm">
            <label class="fl"><span class="cap">Pokémon</span><input class="field" id="f-sp" value="${empty ? '' : esc(s[1])}" placeholder="Choose a Pokémon" autocomplete="off" /></label>
            <label class="fl"><span class="cap">Item</span><span class="iwrap">${itemIcon(m.item) ? `<img class="itemic" src="${itemIcon(m.item)}" alt="" width="24" height="24" />` : ''}<input class="field" id="f-item" value="${esc(m.item)}" placeholder="No item" autocomplete="off" /></span></label>
            <label class="fl"><span class="cap">Ability</span><input class="field" id="f-ab" value="${esc(m.ab)}" autocomplete="off" /></label>
          </div>
          <div class="c-mv col b">
            <span class="cap">Moves</span>
            ${[0, 1, 2, 3].map((j) => `<div class="slot mrow"><input class="field mvin" data-j="${j}" value="${esc(m.moves[j] ? moveName(m.moves[j]) : '')}" placeholder="Move ${j + 1}" autocomplete="off" />${moveInfo(m.moves[j])}</div>`).join('')}
          </div>
        </div>
        <div class="col c evp">
          <h3 class="sec">${c ? 'Stat Points' : 'EVs'}</h3>
          <table class="stt">
            <thead><tr><th></th><th class="n">Base</th><th class="sbh"></th><th>${c ? 'SP' : 'EVs'}</th><th></th>${c ? '' : '<th>IVs</th>'}<th class="n"></th></tr></thead>
            <tbody>${base.map((b, k) => `<tr>
              <th class="${mark(k)}" title="${k ? 'Type + or - after the EVs to raise or lower this stat with your nature' : ''}">${STATNAME[k]}</th>
              <td class="n"><b>${b}</b></td>
              <td class="sbar"><i style="${sdBar(st[k] * 100 / (c ? 50 : m.level || 100), k)}"></i></td>
              <td><input class="field num ev" data-k="${k}" type="text" inputmode="numeric" autocomplete="off" value="${m.evs[k]}${sfx(k)}" aria-label="${STATNAME[k]} ${cap.label}" /></td>
              <td class="barc"><input type="range" class="evr" style="--fill:${(m.evs[k] / cap.per) * 100}%" data-k="${k}" min="0" max="${cap.per}" step="${cap.step}" value="${m.evs[k]}" aria-label="${STATNAME[k]} ${cap.label}" /></td>
              ${c ? '' : `<td><input class="field num iv" data-k="${k}" type="number" min="0" max="31" value="${m.ivs[k]}" aria-label="${STATNAME[k]} IVs" /></td>`}
              <td class="n"><b>${st[k]}</b></td></tr>`).join('')}</tbody>
          </table>
          <div class="evfoot">
