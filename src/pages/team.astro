---
import Base from '../layouts/Base.astro';
import { TYPES, CHART, dbTypeColors } from '../lib/types';
---
<Base title="Team builder" description="Add up to 12 Pokémon to check type coverage, and copy the team into Pokémon Showdown.">
  <h1>Team builder</h1>
  <p class="note">Add 1 to 12 Pokémon to see how the team holds up against each type.</p>
  <div class="controls">
    <div class="slot"><input class="field" id="add" placeholder="Add a Pokémon…" autocomplete="off" /></div>
    <span class="soft" id="n">0 / 12</span>
    <div class="acts">
      <button class="sm" id="copy" type="button" disabled>Copy for Showdown</button>
      <a class="sm" href="https://play.pokemonshowdown.com/teambuilder" target="_blank" rel="noopener">Open Showdown ↗</a>
      <button class="sm" id="share" type="button" disabled>Copy link</button>
      <button class="sm" id="clear" type="button" disabled>Clear</button>
    </div>
  </div>
  <p class="note" id="msg" aria-live="polite"></p>
  <div id="team" class="team"></div>
  <div id="res" hidden>
    <h3 class="sec">Defensive coverage</h3>
    <p class="note">How much damage each attacking type does to each team member. Totals on the right; the most shared weakness is highlighted.</p>
    <div class="mx-wrap"><table class="mx" id="mx"></table></div>
  </div>
  <script define:vars={{ TYPES, CHART, COLORS: dbTypeColors }}>
    window.__TW = { TYPES, CHART, COLORS };
  </script>
  <script>
    import { autocomplete } from '../lib/ac';
    const { TYPES, CHART, COLORS } = (window as any).__TW as { TYPES: string[]; CHART: Record<string, Record<string, number>>; COLORS: Record<string, string> };
    type Sp = [string, string, string[], string | null, number, string, string[], string | null];
    let all: Sp[] = [];
    const load = async () => (all.length ? all : (all = (await (await fetch('/search-index.json')).json()).species));
    const team: Sp[] = [];
    const $ = (id: string) => document.getElementById(id)!;
    const add = $('add') as HTMLInputElement;
    const SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
    const chip = (t: string) => `<span class="tchip" style="background:${COLORS[t]}">${t}</span>`;
    const mult = (atk: string, defs: string[]) => defs.reduce((m, d) => m * (CHART[atk][d] ?? 1), 1);
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    const render = () => {
      $('n').textContent = `${team.length} / 12`;
      add.disabled = team.length >= 12; add.placeholder = team.length >= 12 ? 'Team is full' : 'Add a Pokémon…';
      ['copy', 'share', 'clear'].forEach((k) => (($(k) as HTMLButtonElement).disabled = !team.length));
      $('team').innerHTML = team.map((s, i) => `<span class="mon"><img src="${s[3] ? SPR + s[3] + '.png' : ''}" alt="" width="40" height="40" /><a href="${s[5]}">${esc(s[1])}</a><button type="button" data-i="${i}" aria-label="Remove ${esc(s[1])}">×</button></span>`).join('');
      const q = new URLSearchParams(); if (team.length) q.set('t', team.map((s) => s[0]).join(','));
      history.replaceState(null, '', team.length ? `?${q}` : location.pathname);
      $('res').hidden = !team.length; if (!team.length) return;
      const txt = (m: number) => m === 1 ? '' : m === 0 ? '0' : m === 0.5 ? '½' : m === 0.25 ? '¼' : String(m);
      const bg = (m: number) => m === 1 ? '' : m === 0 ? '#2e3436' : m >= 4 ? '#73d216' : m > 1 ? '#4e9a06' : m <= 0.25 ? '#7c0000' : '#a40000';
      const rows = TYPES.map((t) => { const ms = team.map((s) => mult(t, s[2])); return { t, ms, w: ms.filter((m) => m > 1).length, r: ms.filter((m) => m > 0 && m < 1).length, i: ms.filter((m) => m === 0).length }; });
      const maxW = Math.max(...rows.map((r) => r.w));
      $('mx').innerHTML = `<thead><tr><th></th>${team.map((s) => `<th class="mh" title="${esc(s[1])}"><a href="${s[5]}"><img src="${s[3] ? SPR + s[3] + '.png' : ''}" alt="${esc(s[1])}" width="44" height="44" /><span>${esc(s[1])}</span></a></th>`).join('')}<th class="tot">Weak</th><th class="tot">Resist</th></tr></thead><tbody>` +
        rows.map((r) => `<tr class="${r.w && r.w === maxW ? 'worst' : ''}"><th>${chip(r.t)}</th>${r.ms.map((m) => `<td style="${bg(m) ? `background:${bg(m)};color:${m === 0 ? '#fff' : '#ffdd57'}` : ''}">${txt(m)}</td>`).join('')}<td class="tot w${r.w >= 3 ? ' hi' : ''}">${r.w || ''}</td><td class="tot">${r.r + r.i || ''}</td></tr>`).join('') + '</tbody>';
    };

    const addMon = async (name: string) => {
      const d = await load(); const s = d.find((x) => x[1].toLowerCase() === name.trim().toLowerCase());
      if (!s || team.length >= 12) return;
      team.push(s); add.value = ''; render(); add.focus();
    };
    autocomplete(add, async () => (await load()).map((s) => ({ label: s[1], sub: s[2].join(' / ') })), (it) => addMon(it.label));
    add.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addMon(add.value); } });
    $('team').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('button'); if (b) { team.splice(+b.dataset.i!, 1); render(); } });
    $('clear').addEventListener('click', () => { team.length = 0; render(); });
    const say = (t: string) => { $('msg').textContent = t; setTimeout(() => ($('msg').textContent = ''), 4000); };
    $('copy').addEventListener('click', async () => {
      await navigator.clipboard.writeText(team.map((s) => s[1]).join('\n\n') + '\n');
      say('Copied. In Showdown: Teambuilder → New team → Import from text, then paste.');
    });
    $('share').addEventListener('click', async () => { await navigator.clipboard.writeText(location.href); say('Link copied.'); });
    const p = new URLSearchParams(location.search).get('t');
    if (p) load().then((d) => { for (const id of p.split(',').slice(0, 12)) { const s = d.find((x) => x[0] === id); if (s) team.push(s); } render(); });
    else render();
  </script>
</Base>
<style>
  .slot { position: relative; flex: 1; min-width: 240px; max-width: 420px; } .slot .field { width: 100%; }
  .acts { display: flex; gap: .4rem; flex-wrap: wrap; margin-left: auto; }
  .sm { font: inherit; font-weight: 700; font-size: .85rem; padding: .35rem .7rem; border: 2px solid var(--ink); background: #fff7f5; color: var(--ink); cursor: pointer; text-decoration: none; }
  .sm:hover:not(:disabled) { background: var(--petal-deep); color: var(--ink); }
  .sm:disabled { opacity: .45; cursor: default; }
  .team { display: flex; flex-wrap: wrap; gap: .4rem; margin: .6rem 0 1rem; }
  .team :global(.mon) { display: inline-flex; align-items: center; gap: .25rem; border: 2px solid var(--ink); background: #fff7f5; padding: 0 0 0 .1rem; font-size: .88rem; }
  .team :global(.mon img) { width: 36px; height: 36px; }
  .team :global(.mon button) { border: 0; background: none; font: inherit; font-size: 1.1rem; font-weight: 800; cursor: pointer; color: var(--ink-soft); padding: 0 .45rem; }
  .team :global(.mon button:hover) { color: #a40000; }
  .mx-wrap { overflow-x: auto; }
  .mx { border-collapse: separate; border-spacing: 2px; width: auto; }
  .mx :global(th), .mx :global(td) { padding: 0; }
  .mx :global(tbody th) { text-align: left; padding-right: .5rem; }
  .mx :global(td) { width: 52px; height: 28px; text-align: center; font-weight: 800; font-size: .85rem; background: #fff7f5; border: 1px solid #e2c3bf; }
  .mx :global(.mh) { vertical-align: bottom; width: 52px; }
  .mx :global(.mh a) { display: flex; flex-direction: column; align-items: center; font-size: .66rem; line-height: 1.1; color: var(--ink); }
  .mx :global(.mh span) { max-width: 52px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mx :global(.tot) { width: 52px; font-size: .78rem; color: var(--ink-soft); }
  .mx :global(td.tot) { background: transparent; border-color: transparent; color: var(--ink); font-size: .95rem; }
  .mx :global(td.tot.hi) { color: #a40000; }
  .mx :global(tr.worst th .tchip) { outline: 2px solid var(--ink); outline-offset: 1px; }
  .mx :global(tr.worst td.w) { background: #f6d2cd; border-color: #a40000; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 2.2rem; align-items: start; }
  .cols > div { min-width: 0; }
  @media (max-width: 900px) { .cols { grid-template-columns: 1fr; } }
  .tw :global(td), .tw :global(th) { padding: .2rem .45rem; vertical-align: middle; }
  .tw :global(tbody tr:nth-child(even)) { background: rgb(255 255 255 / .35); }
  .tw :global(.who) { font-size: .85rem; white-space: normal; }
  .tw :global(tr.worst td) { background: #f6d2cd; }
  .tw :global(.chips) { margin-top: .1rem; }
  :global(.tchip) { display: inline-block; font-weight: 700; font-size: .68rem; padding: 0 .35rem; margin-right: .2rem; color: #fff; text-shadow: 1px 1px 1px rgb(0 0 0 / .5); border: 1px solid rgb(0 0 0 / .25); }
  :global(.x4) { font-size: .72rem; background: #a40000; color: #ffdd57; padding: 0 .25rem; }
</style>
