---
import Base from '../layouts/Base.astro';
import { TYPES, CHART, dbTypeColors, ABILITY_DEF } from '../lib/types';
import { GAMES, meta } from '../lib/data';
---
<Base title="Team builder" description="Build a team of up to 12 Pokémon with moves, and check its defensive and offensive type coverage.">
  <h1>Team builder</h1>
  <p class="note">Add up to 12 Pokémon and give each one up to 4 moves. The tables below show what the team is weak to and which types its moves hit super effectively.</p>
  <div class="controls">
    <label class="lab2">Format
      <select class="field" id="fmt">
        <option value="all" selected>All games</option>
        {meta.cobbleverse && <option value="0">Cobbleverse {meta.cobbleverse}</option>}
        {[9, 8, 7].map((g) => <option value={g}>{GAMES[g]}</option>)}
      </select>
    </label>
    <label class="lab2">Randomize <input class="field num" id="rn" type="number" min="1" max="12" value="6" aria-label="How many to randomize" /></label>
    <button class="sm" id="rand" type="button">Randomize team</button>
  </div>
  <div class="controls">
    <div class="slot addslot"><input class="field" id="add" placeholder="Add a Pokémon…" autocomplete="off" /></div>
    <span class="soft" id="n">0 / 12</span>
    <div class="acts">
      <button class="sm" id="copy" type="button" disabled>Copy for Showdown</button>
      <a class="sm" href="https://play.pokemonshowdown.com/teambuilder" target="_blank" rel="noopener">Open Showdown ↗</a>
      <button class="sm" id="imp" type="button">Import</button>
      <button class="sm" id="share" type="button" disabled>Copy link</button>
      <button class="sm" id="clear" type="button" disabled>Clear</button>
    </div>
  </div>
  <div id="impbox" class="impbox" hidden>
    <textarea class="field" id="imptext" rows="8" placeholder="Paste a team in Showdown format (from Showdown's Export, PokéPaste or a mypokemonteam.com link)…"></textarea>
    <div><button class="sm" id="impgo" type="button">Load team</button> <button class="sm" id="impx" type="button">Cancel</button></div>
  </div>
  <p class="note" id="msg" aria-live="polite"></p>
  <div id="team" class="team"></div>

  <div id="res" hidden>
    <div class="sums">
      <div>
        <h3 class="sec">Team defense</h3>
        <div class="sum" id="sumdef"></div>
        <p class="note">Members that resist or are immune, minus members that are weak. <b class="pos">Green</b> is good, <b class="neg">red</b> is a hole.</p>
      </div>
      <div>
        <h3 class="sec">Moveset coverage</h3>
        <div class="sum" id="sumoff"></div>
        <p class="note" id="offnote"></p>
      </div>
    </div>
    <div class="sums">
      <div>
        <h3 class="sec">Defense by member</h3>
        <div class="mx-wrap"><table class="mx" id="def"></table></div>
      </div>
      <div>
        <h3 class="sec">Moveset coverage by member</h3>
        <div class="mx-wrap"><table class="mx" id="off"></table></div>
      </div>
    </div>
  </div>

  <script define:vars={{ TYPES, CHART, COLORS: dbTypeColors, ABDEF: ABILITY_DEF }}>
    window.__TW = { TYPES, CHART, COLORS, ABDEF };
  </script>
  <script>
    import { autocomplete } from '../lib/ac';
    const { TYPES, CHART, COLORS, ABDEF } = (window as any).__TW as { TYPES: string[]; CHART: Record<string, Record<string, number>>; COLORS: Record<string, string>; ABDEF: Record<string, any> };
    type Sp = [string, string, string[], string | null, number, string, string[], string | null];
    type Idx = { species: Sp[]; moves: Record<string, [string, string, string]>; learn: Record<string, number[]> };
    type Member = { i: number; moves: string[]; ab: string };
    let idx: Idx | null = null;
    let learnable: Map<number, [string, number][]> | null = null;
    const fmtSel = document.getElementById('fmt') as HTMLSelectElement;
    const want = () => fmtSel.value === 'all' ? -1 : 1 << +fmtSel.value;
    const load = async () => (idx ??= await (await fetch('/search-index.json')).json());
    const learnOf = async (i: number) => {
      const d = await load();
      if (!learnable) { learnable = new Map(); for (const [m, arr] of Object.entries(d.learn)) for (let k = 0; k < arr.length; k += 2) { const e: [string, number] = [m, arr[k + 1]]; const l = learnable.get(arr[k]); l ? l.push(e) : learnable.set(arr[k], [e]); } }
      const w = want(); return (learnable.get(i) ?? []).filter(([, mask]) => mask & w).map(([m]) => m);
    };
    const team: Member[] = [];
    const $ = (id: string) => document.getElementById(id)!;
    const add = $('add') as HTMLInputElement;
    const SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const toID = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
    const chip = (t: string) => `<span class="tchip" style="background:${COLORS[t]}">${t}</span>`;
    const mult = (atk: string, defs: string[]) => defs.reduce((m, d) => m * (CHART[atk][d] ?? 1), 1);
    // damage taken, including abilities like Levitate, Flash Fire or Thick Fat
    const defMult = (atk: string, defs: string[], ability: string) => {
      let m = mult(atk, defs); const a = ABDEF[ability]; if (!a) return m;
      if (a.wonder) return m > 1 ? m : 0;
      if (a.delta && defs.includes('Flying') && (CHART[atk].Flying ?? 1) > 1) m /= 2;
      if (a[atk] !== undefined) m *= a[atk];
      if (a.se && m > 1) m *= a.se;
      return m;
    };
    // move info, with Hidden Power stored as hiddenpower-water so its type survives
    const mv = (id: string): [string, string, string] | null => {
      const d = idx!; const hp = id.match(/^hiddenpower-(\w+)$/);
      if (hp) { const t = TYPES.find((x) => x.toLowerCase() === hp[1]); return t ? [`Hidden Power [${t}]`, t, 'Special'] : null; }
      return d.moves[id] ?? null;
    };
    const moveVs = (id: string, type: string, def: string) => {
      if (id === 'freezedry' && def === 'Water') return 2;
      if (id === 'flyingpress') return mult('Fighting', [def]) * mult('Flying', [def]);
      if (id === 'thousandarrows' && def === 'Flying') return 1;
      return mult(type, [def]);
    };
    const txt = (m: number) => m === 1 ? '' : m === 0 ? '0' : m === 0.5 ? '½' : m === 0.25 ? '¼' : m === 0.75 ? '¾' : String(+m.toFixed(2));
    const bg = (m: number) => m === 1 ? '' : m === 0 ? '#2e3436' : m >= 4 ? '#73d216' : m > 1 ? '#4e9a06' : m <= 0.25 ? '#7c0000' : '#a40000';
    const cell = (m: number, title = '') => `<td title="${title}" style="${bg(m) ? `background:${bg(m)};color:${m === 0 ? '#fff' : '#ffdd57'}` : ''}">${txt(m)}</td>`;
    const head = (d: Idx) => `<thead><tr><th></th>${team.map((t) => { const s = d.species[t.i]; return `<th class="mh" title="${esc(s[1])}"><img src="${s[3] ? SPR + s[3] + '.png' : ''}" alt="" width="40" height="40" /></th>`; }).join('')}`;
    const abilitiesOf = (s: Sp) => [...s[6], ...(s[7] ? [s[7]] : [])];

    const draw = () => {
      const d = idx!;
      $('n').textContent = `${team.length} / 12`;
      add.disabled = team.length >= 12; add.placeholder = team.length >= 12 ? 'Team is full' : 'Add a Pokémon…';
      ['copy', 'share', 'clear'].forEach((k) => (($(k) as HTMLButtonElement).disabled = !team.length));
      const q = team.map((t) => [d.species[t.i][0], t.moves.filter(Boolean).join('.'), toID(t.ab)].join(':').replace(/:+$/, '')).join(',');
      history.replaceState(null, '', team.length ? `?t=${q}` : location.pathname);
      $('res').hidden = !team.length; if (!team.length) return;

      // defense
      const rows = TYPES.map((t) => { const ms = team.map((m) => defMult(t, d.species[m.i][2], m.ab)); return { t, ms, w: ms.filter((m) => m > 1).length, r: ms.filter((m) => m < 1).length }; });
      const score = (n: number) => `<b class="${n > 0 ? 'pos' : n < 0 ? 'neg' : 'z'}">${n > 0 ? '+' : ''}${n}</b>`;
      $('sumdef').innerHTML = rows.map((r) => `<div class="sc" title="${r.t}: ${r.r} resist or immune, ${r.w} weak">${chip(r.t)}${score(r.r - r.w)}</div>`).join('');
      $('def').innerHTML = head(d) + `<th class="gap"></th><th class="tot">Weak</th><th class="tot">Resist</th></tr></thead><tbody>` +
        rows.map((r) => `<tr><th>${chip(r.t)}</th>${r.ms.map((m) => cell(m)).join('')}<td class="gap"></td><td class="tot weak${r.w ? '' : ' zero'}">${r.w}</td><td class="tot res${r.r ? '' : ' zero'}">${r.r}</td></tr>`).join('') + '</tbody>';

      // coverage: best multiplier each member's damaging moves get against each type
      const dmg = team.map((m) => m.moves.filter((id) => { const x = id && mv(id); return x && x[2] !== 'Status'; }));
      const anyMoves = dmg.some((l) => l.length);
      const offRows = TYPES.map((def) => {
        const best = team.map((m, k) => {
          let b = -1, by = '';
          for (const id of dmg[k]) { const x = mv(id)!; const v = moveVs(id, x[1], def); if (v > b) { b = v; by = x[0]; } }
          return { b, by };
        });
        return { def, best, se: best.filter((x) => x.b > 1).length };
      });
      $('sumoff').innerHTML = offRows.map((r) => `<div class="sc" title="${r.def}: ${r.se} member${r.se === 1 ? '' : 's'} hit it super effectively">${chip(r.def)}<b class="${!anyMoves ? 'z' : r.se ? 'pos' : 'neg'}">${anyMoves ? (r.se ? '+' + r.se : '0') : '–'}</b></div>`).join('');
      const none = offRows.filter((r) => r.se === 0).map((r) => r.def);
      $('offnote').innerHTML = !anyMoves ? 'Add attacking moves to see what the team hits super effectively.'
        : none.length ? `Members with a super-effective move against each type. <b class="neg">No answer to ${none.join(', ')}.</b>`
        : `Members with a super-effective move against each type. <b class="pos">Every type is covered.</b>`;
      $('off').innerHTML = head(d) + `<th class="gap"></th><th class="tot">Hit 2×</th></tr></thead><tbody>` +
        offRows.map((r) => `<tr class="${anyMoves && r.se === 0 ? 'hole' : ''}"><th>${chip(r.def)}</th>${r.best.map((x) => x.b < 0 ? '<td class="none"></td>' : cell(x.b, `${x.by}: ${txt(x.b) || '1'}×`)).join('')}<td class="gap"></td><td class="tot cov${r.se ? '' : ' zero'}">${r.se}</td></tr>`).join('') + '</tbody>';
    };

    const cards = () => {
      const d = idx!;
      $('team').innerHTML = team.map((t, k) => { const s = d.species[t.i]; const abs = abilitiesOf(s); return `<div class="mon" data-k="${k}">
        <div class="top"><img src="${s[3] ? SPR + s[3] + '.png' : ''}" alt="" width="48" height="48" /><div><a href="${s[5]}">${esc(s[1])}</a><div>${s[2].map(chip).join('')}</div></div><button type="button" class="rm" aria-label="Remove ${esc(s[1])}">×</button></div>
        <select class="field absel" aria-label="Ability">${abs.map((a) => `<option${a === t.ab ? ' selected' : ''}>${esc(a)}</option>`).join('')}</select>
        ${[0, 1, 2, 3].map((j) => { const x = t.moves[j] ? mv(t.moves[j]) : null; return `<div class="slot"><input class="field mvin" data-j="${j}" placeholder="Move ${j + 1}" value="${x ? esc(x[0]) : ''}" autocomplete="off" /></div>`; }).join('')}
      </div>`; }).join('');
      $('team').querySelectorAll<HTMLElement>('.mon').forEach((el) => {
        const t = team[+el.dataset.k!];
        el.querySelector<HTMLSelectElement>('.absel')!.addEventListener('change', (e) => { t.ab = (e.target as HTMLSelectElement).value; draw(); });
        el.querySelectorAll<HTMLInputElement>('.mvin').forEach((inp) => {
          const j = +inp.dataset.j!;
          const setMove = (name: string) => { const id = Object.keys(d.moves).find((m) => d.moves[m][0].toLowerCase() === name.trim().toLowerCase()) ?? ''; t.moves[j] = id; draw(); };
          autocomplete(inp, async () => (await learnOf(t.i)).map((m) => d.moves[m]).filter(Boolean).map(([label, type, cat]) => ({ label, type, cat })).sort((a, b) => a.label.localeCompare(b.label)), (it) => { setMove(it.label); (el.querySelectorAll<HTMLInputElement>('.mvin')[j + 1])?.focus(); }, 12, true);
          inp.addEventListener('change', () => setMove(inp.value));
        });
      });
      draw();
    };

    const findSpecies = (d: Idx, name: string) => {
      const n = toID(name); let i = d.species.findIndex((x) => toID(x[1]) === n || x[0] === n);
      if (i < 0 && name.includes('-')) i = d.species.findIndex((x) => toID(x[1]) === toID(name.split('-')[0]));
      return i;
    };
    const addMon = async (name: string) => {
      const d = await load(); const i = findSpecies(d, name);
      if (i < 0 || team.length >= 12) return;
      team.push({ i, moves: [], ab: abilitiesOf(d.species[i])[0] ?? '' }); add.value = ''; cards();
      ($('team').lastElementChild?.querySelector('.mvin') as HTMLInputElement | null)?.focus();
    };
    autocomplete(add, async () => (await load()).species.map((s) => ({ label: s[1], sub: s[2].join(' / ') })), (it) => addMon(it.label));
    add.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); addMon(add.value); } });
    $('team').addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest('.rm'); if (b) { team.splice(+b.closest<HTMLElement>('.mon')!.dataset.k!, 1); cards(); } });
    $('clear').addEventListener('click', () => { team.length = 0; cards(); });
    const say = (t: string) => { $('msg').textContent = t; setTimeout(() => ($('msg').textContent = ''), 6000); };
    $('copy').addEventListener('click', async () => {
      const d = idx!;
      const text = team.map((t) => [d.species[t.i][1], ...(t.ab ? [`Ability: ${t.ab}`] : []), ...t.moves.map((m) => m && mv(m)).filter(Boolean).map((x) => `- ${x![0]}`)].join('\n')).join('\n\n') + '\n';
      await navigator.clipboard.writeText(text);
      say('Copied. In Showdown: Teambuilder → New team → Import from text, then paste.');
    });
    $('share').addEventListener('click', async () => { await navigator.clipboard.writeText(location.href); say('Link copied.'); });
    fmtSel.addEventListener('change', () => cards());

    // import a Showdown-format team (also what mypokemonteam.com links carry, base64-encoded)
    const importText = async (text: string) => {
      const d = await load(); const out: Member[] = []; const miss: string[] = [];
      for (const block of text.replace(/\r/g, '').split(/\n\s*\n/)) {
        const lines = block.split('\n').map((l) => l.trim()).filter(Boolean); if (!lines.length) continue;
        let head = lines[0].split(' @ ')[0].replace(/\s*\((M|F)\)\s*$/, '').trim();
        const paren = head.match(/\(([^)]+)\)\s*$/); if (paren) head = paren[1];
        const i = findSpecies(d, head); if (i < 0) { miss.push(head); continue; }
        const abLine = lines.find((l) => /^Ability:/i.test(l));
        const ab = abLine ? abLine.replace(/^Ability:\s*/i, '') : abilitiesOf(d.species[i])[0] ?? '';
        const moves = lines.filter((l) => l.startsWith('-')).map((l) => {
          const name = l.replace(/^-\s*/, ''); const hp = name.match(/^Hidden Power\s*\[?(\w+)\]?/i);
          if (hp && TYPES.some((t) => t.toLowerCase() === hp[1].toLowerCase())) return `hiddenpower-${hp[1].toLowerCase()}`;
          const id = toID(name); return d.moves[id] ? id : '';
        }).filter(Boolean).slice(0, 4);
        out.push({ i, moves, ab }); if (out.length >= 12) break;
      }
      if (!out.length) { say("Couldn't read any Pokémon from that. Paste the team in Showdown's export format."); return; }
      team.length = 0; team.push(...out); cards();
      say(`Loaded ${out.length} Pokémon.${miss.length ? ` Not found: ${miss.join(', ')}.` : ''}`);
    };
    const fromLink = (s: string) => { try { const u = new URL(s); const t = u.searchParams.get('team'); return t ? decodeURIComponent(escape(atob(t))) : null; } catch { return null; } };
    $('imp').addEventListener('click', () => { $('impbox').hidden = false; ($('imptext') as HTMLTextAreaElement).focus(); });
    $('impx').addEventListener('click', () => { $('impbox').hidden = true; });
    $('impgo').addEventListener('click', async () => {
      const v = ($('imptext') as HTMLTextAreaElement).value.trim(); await importText(fromLink(v) ?? v);
      $('impbox').hidden = true; ($('imptext') as HTMLTextAreaElement).value = '';
    });

    // randomize: random Pokémon that have a movepool in the chosen format, each with 4 random moves (at least 2 attacks when possible)
    const rnIn = document.getElementById('rn') as HTMLInputElement, rBtn = document.getElementById('rand') as HTMLButtonElement;
    const pickN = <T,>(arr: T[], n: number) => { const a = arr.slice(); for (let k = a.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [a[k], a[j]] = [a[j], a[k]]; } return a.slice(0, n); };
    rBtn.addEventListener('click', async () => {
      const d = await load(); await learnOf(0);
      const n = Math.max(1, Math.min(12, Math.round(+rnIn.value || 6))); rnIn.value = String(n);
      const pool: number[] = []; for (let i = 0; i < d.species.length; i++) if ((await learnOf(i)).length >= 4) pool.push(i);
      team.length = 0;
      for (const i of pickN(pool, n)) {
        const ms = await learnOf(i); const atk = ms.filter((m) => d.moves[m] && d.moves[m][2] !== 'Status'), st = ms.filter((m) => d.moves[m] && d.moves[m][2] === 'Status');
        const a = pickN(atk, Math.min(atk.length, 2 + Math.floor(Math.random() * 2)));
        team.push({ i, moves: pickN([...a, ...pickN(st.concat(atk.filter((m) => !a.includes(m))), 4 - a.length)], 4), ab: pickN(abilitiesOf(d.species[i]), 1)[0] ?? '' });
      }
      cards();
      let left = 10; rBtn.disabled = true; rBtn.textContent = `Randomize (${left}s)`;
      const tick = setInterval(() => { left--; if (left <= 0) { clearInterval(tick); rBtn.disabled = false; rBtn.textContent = 'Randomize team'; } else rBtn.textContent = `Randomize (${left}s)`; }, 1000);
    });

    load().then(async (d) => {
      const sp = new URLSearchParams(location.search);
      const p = sp.get('t'), ext = sp.get('team');
      if (ext) { try { await importText(decodeURIComponent(escape(atob(ext)))); return; } catch { /* fall through */ } }
      if (p) for (const part of p.split(',').slice(0, 12)) {
        const [id, mvs, abId] = part.split(':'); const i = d.species.findIndex((x) => x[0] === id); if (i < 0) continue;
        const abs = abilitiesOf(d.species[i]);
        team.push({ i, moves: (mvs ?? '').split('.').filter((m) => d.moves[m] || /^hiddenpower-\w+$/.test(m)).slice(0, 4), ab: abs.find((a) => toID(a) === abId) ?? abs[0] ?? '' });
      }
      cards();
    });
  </script>
</Base>
<style>
  .addslot { position: relative; flex: 1; min-width: 240px; max-width: 420px; } .addslot .field { width: 100%; }
  .acts { display: flex; gap: .4rem; flex-wrap: wrap; margin-left: auto; }
  .sm { font: inherit; font-weight: 700; font-size: .85rem; padding: .35rem .7rem; border: 2px solid var(--ink); background: #fff7f5; color: var(--ink); cursor: pointer; text-decoration: none; }
  .sm:hover:not(:disabled) { background: var(--petal-deep); color: var(--ink); }
  .sm:disabled { opacity: .45; cursor: default; }
  .team { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: .6rem; margin: .6rem 0 1.4rem; }
  .team :global(.mon) { border: 2px solid var(--ink); background: #fff7f5; padding: .4rem; display: flex; flex-direction: column; gap: .3rem; }
  .team :global(.top) { display: flex; align-items: center; gap: .4rem; }
  .team :global(.top img) { width: 48px; height: 48px; }
  .team :global(.top > div) { flex: 1; min-width: 0; }
  .team :global(.top a) { display: block; font-size: .95rem; }
  .team :global(.rm) { align-self: flex-start; border: 0; background: none; font: inherit; font-size: 1.2rem; font-weight: 800; cursor: pointer; color: var(--ink-soft); padding: 0 .3rem; }
  .team :global(.rm:hover) { color: #a40000; }
  .team :global(.slot) { position: relative; }
  .team :global(.mvin) { width: 100%; padding: .3rem .5rem; font-size: .85rem; }
  .sums { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; margin-bottom: 1rem; }
  .sums > div { min-width: 0; }
  @media (max-width: 1000px) { .sums { grid-template-columns: 1fr; } }
  .sum { display: grid; grid-template-columns: repeat(6, 1fr); gap: .3rem; }
  @media (max-width: 520px) { .sum { grid-template-columns: repeat(3, 1fr); } }
  .sum :global(.sc) { display: flex; flex-direction: column; align-items: stretch; text-align: center; border: 1px solid #e2c3bf; background: #fff7f5; }
  .sum :global(.sc .tchip) { display: block; margin: 0; padding: .1rem 0; font-size: .72rem; }
  .sum :global(.sc b) { font-size: 1.05rem; padding: .1rem 0; }
  :global(b.pos) { color: #2f7d0a; } :global(b.neg) { color: #b3261e; } :global(b.z) { color: var(--ink-soft); font-weight: 600; }
  .team :global(.absel) { padding: .25rem .5rem; font-size: .85rem; }
  .impbox { display: flex; flex-direction: column; gap: .4rem; margin: .6rem 0; }
  .impbox textarea { width: 100%; font: inherit; font-size: .85rem; }
  .lab2 { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; font-size: .9rem; color: var(--ink-soft); }
  .num { width: 4.2rem; }
  #rand:disabled { opacity: .55; cursor: default; }
  .lab2 { display: inline-flex; align-items: center; gap: .5rem; font-weight: 600; font-size: .9rem; color: var(--ink-soft); }
  .num { width: 4.2rem; }
  #rand:disabled { opacity: .55; cursor: default; }
  .key { display: inline-block; font-weight: 800; font-size: .78rem; padding: 0 .4rem; border: 2px solid; }
  .key.weak { color: #a40000; border-color: #a40000; background: #fbe3e0; }
  .key.res { color: #2f6b06; border-color: #4e9a06; background: #e4f2d9; }
  .mx-wrap { overflow-x: auto; }
  .mx { border-collapse: separate; border-spacing: 2px; width: auto; }
