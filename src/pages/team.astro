---
import Base from '../layouts/Base.astro';
import { TYPES, dbTypeColors } from '../lib/types';
import { GAMES, meta } from '../lib/data';
---
<Base title="Teambuilder" description="Build Pokémon teams with full Showdown sets: abilities, items, moves, natures, EVs, IVs and Tera types, with calculated stats.">
  <h1>Teambuilder</h1>
  <div class="bar">
    <label class="lab2">Team
      <select class="field" id="teams" aria-label="Saved teams"></select>
    </label>
    <input class="field tname" id="tname" placeholder="Team name" aria-label="Team name" />
    <button class="sm" id="new" type="button">New team</button>
    <button class="sm" id="del" type="button">Delete team</button>
    <label class="lab2">Format
      <select class="field" id="fmt">
        <option value="all" selected>All games</option>
        <option value="champ">Pokémon Champions (Stat Points)</option>
        {meta.cobbleverse && <option value="0">Cobbleverse {meta.cobbleverse}</option>}
        {[9, 8, 7].map((g) => <option value={g}>{GAMES[g]}</option>)}
      </select>
    </label>
  </div>
  <div class="bar">
    <button class="sm" id="imp" type="button">Import</button>
    <button class="sm" id="paste" type="button">Create PokéPaste ↗</button>
    <button class="sm" id="share" type="button">Copy link</button>
    <a class="sm" id="cov" href="/coverage/">Check coverage</a>
    <span class="soft" id="saved" aria-live="polite"></span>
  </div>
  <div id="impbox" class="impbox" hidden>
    <textarea class="field" id="imptext" rows="10" placeholder="Paste a whole team or a single Pokémon in Showdown format, or a link to one…"></textarea>
    <div><button class="sm" id="impgo" type="button">Replace team</button> <button class="sm" id="impadd" type="button">Add to team</button> <button class="sm" id="impx" type="button">Cancel</button></div>
  </div>
  <p class="note" id="msg" aria-live="polite"></p>

  <div class="strip" id="strip"></div>
  <div id="ed" class="ed" hidden></div>

  <script define:vars={{ TYPES, COLORS: dbTypeColors }}>
    window.__TB = { TYPES, COLORS };
  </script>
  <script>
    import { autocomplete } from '../lib/ac';
    import { parseShowdown, moveId } from '../lib/showdown';
    const { TYPES, COLORS } = (window as any).__TB as { TYPES: string[]; COLORS: Record<string, string> };
    type Sp = [string, string, string[], string | null, number, string, string[], string | null];
    type Idx = { species: Sp[]; moves: Record<string, [string, string, string]>; learn: Record<string, number[]> };
    type Tb = { stats: number[][]; items: [string, string, string][]; moves: Record<string, [number | null, number | null, number, string]> };
    type Set6 = [number, number, number, number, number, number];
    type Mon = { sp: string; ab: string; item: string; moves: string[]; nature: string; evs: Set6; ivs: Set6; level: number; tera: string };
    type Team = { id: string; name: string; fmt: string; mons: Mon[] };

    const $ = (id: string) => document.getElementById(id)!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const toID = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
    const SPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/';
    const chip = (t: string) => `<span class="tchip" style="background:${COLORS[t] ?? '#888'}">${t}</span>`;
    const STAT = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
    const STATNAME = ['HP', 'Attack', 'Defense', 'Sp. Atk', 'Sp. Def', 'Speed'];
    // nature -> [raised stat index, lowered stat index] (1..5); neutral natures have equal indexes
    const NAT: Record<string, [number, number]> = {};
    [['Hardy', 'Lonely', 'Adamant', 'Naughty', 'Brave'], ['Bold', 'Docile', 'Impish', 'Lax', 'Relaxed'], ['Modest', 'Mild', 'Bashful', 'Rash', 'Quiet'], ['Calm', 'Gentle', 'Careful', 'Quirky', 'Sassy'], ['Timid', 'Hasty', 'Jolly', 'Naive', 'Serious']]
      .forEach((row, r) => row.forEach((n, c) => (NAT[n] = [r + 1, c + 1])));
    const natLabel = (n: string) => { const [u, d] = NAT[n]; return u === d ? `${n} (neutral)` : `${n} (+${STAT[u]}, −${STAT[d]})`; };

    let idx: Idx, tb: Tb;
    let learnable: Map<number, [string, number][]> | null = null;
    const spIndex = new Map<string, number>();
    const fmtSel = $('fmt') as HTMLSelectElement;
    const learnOf = (i: number) => {
      if (!learnable) { learnable = new Map(); for (const [m, arr] of Object.entries(idx.learn)) for (let k = 0; k < arr.length; k += 2) { const e: [string, number] = [m, arr[k + 1]]; const l = learnable.get(arr[k]); l ? l.push(e) : learnable.set(arr[k], [e]); } }
      const w = fmtSel.value === 'all' || fmtSel.value === 'champ' ? -1 : 1 << +fmtSel.value;
      return (learnable.get(i) ?? []).filter(([, mask]) => mask & w).map(([m]) => m);
    };
    const spOf = (m: Mon) => idx.species[spIndex.get(m.sp) ?? -1];
    const abilitiesOf = (s: Sp) => [...s[6], ...(s[7] ? [s[7]] : [])];
    const cap = (s: string) => s[0].toUpperCase() + s.slice(1);
    const moveName = (id: string) => { const hp = id.match(/^hiddenpower-(\w+)$/); if (hp) return `Hidden Power [${cap(hp[1])}]`; return idx.moves[id]?.[0] ?? ''; };
    const moveType = (id: string) => { const hp = id.match(/^hiddenpower-(\w+)$/); if (hp) return cap(hp[1]); return idx.moves[id]?.[1] ?? ''; };
    const newMon = (i: number): Mon => { const s = idx.species[i]; return { sp: s[0], ab: abilitiesOf(s)[0] ?? '', item: '', moves: ['', '', '', ''], nature: 'Serious', evs: [0, 0, 0, 0, 0, 0], ivs: [31, 31, 31, 31, 31, 31], level: 50, tera: s[2][0] }; };
    // Pokémon Champions: Stat Points (66 total, 32 per stat) instead of EVs; always Lv 50 with 31 IVs.
    // The first point is worth 4 EVs and each one after it 8, so 32 SP = 252 EVs.
    const champ = () => team().fmt === 'champ';
    const spToEv = (sp: number) => (sp > 0 ? Math.min(252, 4 + 8 * (sp - 1)) : 0);
    const evToSp = (ev: number) => (ev >= 4 ? Math.min(32, 1 + Math.floor((ev - 4) / 8)) : 0);
    const CAP = () => (champ() ? { per: 32, total: 66, step: 1, label: 'Stat Points' } : { per: 252, total: 510, step: 4, label: 'EVs' });
    const statsOf = (m: Mon) => {
      const base = tb.stats[spIndex.get(m.sp)!]; const [u, d] = NAT[m.nature] ?? [1, 1];
      const c = champ(), lv = c ? 50 : m.level;
      return base.map((b, k) => {
        const ev = c ? spToEv(m.evs[k]) : m.evs[k], iv = c ? 31 : m.ivs[k];
        const core = Math.floor(((2 * b + iv + Math.floor(ev / 4)) * lv) / 100);
        if (k === 0) return m.sp === 'shedinja' ? 1 : core + lv + 10;
        return Math.floor((core + 5) * (u === d ? 1 : k === u ? 1.1 : k === d ? 0.9 : 1));
      });
    };

    // ---------- storage (this browser only) ----------
    const KEY = 'ardex-teams';
    let teams: Team[] = [];
    let cur = 0, sel = 0;
    const store = {
      get: () => { try { return JSON.parse(localStorage.getItem(KEY) ?? '[]'); } catch { return []; } },
      set: (v: unknown) => { try { localStorage.setItem(KEY, JSON.stringify(v)); return true; } catch { return false; } },
    };
    const team = () => teams[cur];
    let savedTimer = 0;
    const save = () => {
      const ok = store.set(teams);
      $('saved').textContent = ok ? 'Saved in this browser' : "Couldn't save in this browser. Use Copy link to keep this team.";
      clearTimeout(savedTimer); savedTimer = window.setTimeout(() => ($('saved').textContent = ''), 2500);
      ($('cov') as HTMLAnchorElement).href = team().mons.length ? '/coverage/?team=' + encodeURIComponent(b64(exportText())) : '/coverage/';
    };
    const say = (t: string) => { $('msg').textContent = t; setTimeout(() => ($('msg').textContent = ''), 6000); };

    // ---------- Showdown text ----------
    const statLine = (v: Set6, skip: number) => v.map((x, k) => (x !== skip ? `${x} ${STAT[k]}` : '')).filter(Boolean).join(' / ');
    const monText = (m: Mon) => {
      const s = spOf(m); const lines = [`${s[1]}${m.item ? ` @ ${m.item}` : ''}`];
      if (m.ab) lines.push(`Ability: ${m.ab}`);
      const c = champ();
      const lv = c ? 50 : m.level; if (lv !== 100) lines.push(`Level: ${lv}`);
      if (m.tera) lines.push(`Tera Type: ${m.tera}`);
      const ev = statLine((c ? m.evs.map(spToEv) : m.evs) as Set6, 0); if (ev) lines.push(`EVs: ${ev}`);
      lines.push(`${m.nature} Nature`);
      const iv = c ? '' : statLine(m.ivs, 31); if (iv) lines.push(`IVs: ${iv}`);
      for (const id of m.moves) if (id) lines.push(`- ${moveName(id)}`);
      return lines.join('\n');
    };
    const exportText = () => team().mons.map(monText).join('\n\n') + '\n';
    const b64 = (t: string) => btoa(unescape(encodeURIComponent(t)));
    const unb64 = (t: string) => decodeURIComponent(escape(atob(t)));
    const findSpecies = (name: string) => {
      const n = toID(name); let i = idx.species.findIndex((x) => toID(x[1]) === n || x[0] === n);
      if (i < 0 && name.includes('-')) i = idx.species.findIndex((x) => toID(x[1]) === toID(name.split('-')[0]));
      return i;
    };
    const parseTeam = (text: string) => {
      const out: Mon[] = []; const miss: string[] = [];
      const sets = parseShowdown(text, (n) => !!idx.moves[moveId(n, TYPES)] || /^hiddenpower-/.test(moveId(n, TYPES)), (n) => findSpecies(n) >= 0);
      // Champions spreads (66 points, 32 max) pasted as "EVs:" lines
      const looksSp = sets.some((x) => x.evs) && sets.every((x) => !x.evs || (x.evs.every((v) => v <= 32) && x.evs.reduce((a, b) => a + b, 0) <= 66));
      for (const x of sets) {
        const i = findSpecies(x.species); if (i < 0) { miss.push(x.species); continue; }
        const m = newMon(i); m.item = x.item; m.level = x.level ?? 100;
        if (x.ability) m.ab = x.ability; if (x.tera) m.tera = x.tera; if (x.nature && NAT[x.nature]) m.nature = x.nature;
        if (x.evs) m.evs = x.evs as Set6; if (x.ivs) m.ivs = x.ivs as Set6;
        m.moves = x.moves.map((n) => moveId(n, TYPES)).filter((id) => idx.moves[id] || /^hiddenpower-\w+$/.test(id)).slice(0, 4);
        while (m.moves.length < 4) m.moves.push('');
        out.push(m); if (out.length >= 14) break;
      }
      return { out, miss, looksSp };
    };
    const fromLink = (s: string) => { try { const u = new URL(s); const t = u.searchParams.get('team'); return t ? unb64(t) : null; } catch { return null; } };

    // ---------- rendering ----------
    const drawTeams = () => {
      ($('teams') as HTMLSelectElement).innerHTML = teams.map((t, k) => `<option value="${k}"${k === cur ? ' selected' : ''}>${esc(t.name || 'Untitled team')} (${t.mons.length})</option>`).join('');
      const tn = $('tname') as HTMLInputElement; if (document.activeElement !== tn) tn.value = team().name;
      fmtSel.value = team().fmt;
    };
    const drawStrip = () => {
      const t = team();
      $('strip').innerHTML = t.mons.map((m, k) => { const s = spOf(m); return `<button type="button" class="slotb${k === sel ? ' on' : ''}" data-k="${k}" draggable="true" title="Drag to reorder"><img src="${s[3] ? SPR + 'pokemon/' + s[3] + '.png' : ''}" alt="" width="56" height="56" /><span>${esc(s[1])}</span></button>`; }).join('') +
        (t.mons.length < 14 ? `<div class="slotadd"><input class="field" id="addmon" placeholder="+ Add Pokémon" autocomplete="off" /></div>` : '');
      const addIn = document.getElementById('addmon') as HTMLInputElement | null;
      if (addIn) autocomplete(addIn, () => idx.species.map((s) => ({ label: s[1], sub: s[2].join(' / ') })), (it) => { const i = findSpecies(it.label); if (i < 0) return; t.mons.push(newMon(i)); sel = t.mons.length - 1; save(); drawTeams(); drawStrip(); drawEd(); });
    };
    const drawEd = () => {
      const t = team(); const ed = $('ed');
      if (!t.mons.length) { ed.hidden = true; return; }
      sel = Math.min(sel, t.mons.length - 1); ed.hidden = false;
      const m = t.mons[sel], s = spOf(m), st = statsOf(m), base = tb.stats[spIndex.get(m.sp)!];
      const evTotal = m.evs.reduce((a, b) => a + b, 0);
      const [u, d] = NAT[m.nature]; const cap = CAP(), c = champ();
      const mark = (k: number) => (k && u !== d ? (k === u ? 'up' : k === d ? 'down' : '') : '');
      ed.innerHTML = `
        <div class="col a">
          <div class="who"><img src="${s[3] ? SPR + 'pokemon/other/official-artwork/' + s[3] + '.png' : ''}" alt="" width="150" height="150" /></div>
          <div class="slot"><label class="fl">Pokémon<input class="field" id="f-sp" value="${esc(s[1])}" autocomplete="off" /></label></div>
          <div class="types">${s[2].map(chip).join(' ')} <a href="${s[5]}" class="dexl">Dex page</a></div>
          <label class="fl">Ability<select class="field" id="f-ab">${abilitiesOf(s).map((a) => `<option${a === m.ab ? ' selected' : ''}>${esc(a)}</option>`).join('')}</select></label>
          <div class="slot"><label class="fl">Item<input class="field" id="f-item" value="${esc(m.item)}" placeholder="No item" autocomplete="off" /></label></div>
          <div class="pair">
            <label class="fl">Level<input class="field" id="f-lv" type="number" min="1" max="100" value="${c ? 50 : m.level}"${c ? ' disabled title="Champions battles are always Lv. 50"' : ''} /></label>
            <label class="fl">Tera type<select class="field" id="f-tera">${[...TYPES, 'Stellar'].map((x) => `<option${x === m.tera ? ' selected' : ''}>${x}</option>`).join('')}</select></label>
          </div>
          <div class="order"><button type="button" class="sm" id="f-left"${sel === 0 ? ' disabled' : ''} aria-label="Move earlier in the team">← Move</button><button type="button" class="sm" id="f-right"${sel === t.mons.length - 1 ? ' disabled' : ''} aria-label="Move later in the team">Move →</button></div>
          <button type="button" class="sm danger" id="f-rm">Remove from team</button>
        </div>
        <div class="col b">
          <h3 class="sec">Moves</h3>
          ${[0, 1, 2, 3].map((j) => `<div class="slot mrow"><input class="field mvin" data-j="${j}" value="${esc(m.moves[j] ? moveName(m.moves[j]) : '')}" placeholder="Move ${j + 1}" autocomplete="off" />${m.moves[j] ? chip(moveType(m.moves[j])) : ''}</div>`).join('')}
          <h3 class="sec">Nature</h3>
          <select class="field" id="f-nat">${Object.keys(NAT).sort().map((n) => `<option value="${n}"${n === m.nature ? ' selected' : ''}>${natLabel(n)}</option>`).join('')}</select>
        </div>
        <div class="col c">
          <h3 class="sec">Stats <span class="soft evleft${evTotal > cap.total ? ' over' : ''}">${cap.label} left: ${cap.total - evTotal}</span></h3>
          <table class="stt">
            <thead><tr><th></th><th class="n">Base</th><th></th><th>${c ? 'SP' : 'EVs'}</th>${c ? '' : '<th>IVs</th>'}<th class="n">Stat</th></tr></thead>
            <tbody>${base.map((b, k) => `<tr>
              <th class="${mark(k)}">${STATNAME[k]}${k ? `<span class="nb"><button type="button" class="np${mark(k) === 'up' ? ' on' : ''}" data-k="${k}" data-d="1" title="Nature raises ${STATNAME[k]}" aria-label="Nature raises ${STATNAME[k]}">+</button><button type="button" class="np${mark(k) === 'down' ? ' on' : ''}" data-k="${k}" data-d="-1" title="Nature lowers ${STATNAME[k]}" aria-label="Nature lowers ${STATNAME[k]}">−</button></span>` : ''}</th>
              <td class="n soft">${b}</td>
              <td class="barc"><input type="range" class="evr" data-k="${k}" min="0" max="${cap.per}" step="${cap.step}" value="${m.evs[k]}" aria-label="${STATNAME[k]} ${cap.label}" /></td>
              <td><input class="field num ev" data-k="${k}" type="number" min="0" max="${cap.per}" step="${cap.step}" value="${m.evs[k]}" aria-label="${STATNAME[k]} ${cap.label}" /></td>
              ${c ? '' : `<td><input class="field num iv" data-k="${k}" type="number" min="0" max="31" value="${m.ivs[k]}" aria-label="${STATNAME[k]} IVs" /></td>`}
              <td class="n"><b>${st[k]}</b></td></tr>`).join('')}</tbody>
          </table>
          <p class="note">Base stat total ${base.reduce((a, b) => a + b, 0)}. ${c ? 'Champions: up to 32 Stat Points per stat and 66 in total; each point adds 1 to the stat. Always Lv. 50 with perfect IVs. Copy for Showdown converts the points to EVs.' : 'EVs go up to 252 per stat and 510 in total.'}</p>
        </div>`;
      const reStats = () => { // update numbers without rebuilding the inputs, so sliders keep focus while dragging
        const st2 = statsOf(m); ed.querySelectorAll<HTMLElement>('.stt tbody tr').forEach((tr, k) => (tr.querySelector('td:last-child b')!.textContent = String(st2[k])));
        const tot = m.evs.reduce((a, b) => a + b, 0); const el = ed.querySelector('.evleft')!; el.textContent = `${cap.label} left: ${cap.total - tot}`; el.classList.toggle('over', tot > cap.total);
        save();
      };
      autocomplete(ed.querySelector<HTMLInputElement>('#f-sp')!, () => idx.species.map((x) => ({ label: x[1], sub: x[2].join(' / ') })), (it) => {
        const i = findSpecies(it.label); if (i < 0) return;
        t.mons[sel] = { ...newMon(i), item: m.item, nature: m.nature, evs: m.evs, ivs: m.ivs, level: m.level };
        save(); drawTeams(); drawStrip(); drawEd();
      });
      ed.querySelector<HTMLSelectElement>('#f-ab')!.addEventListener('change', (e) => { m.ab = (e.target as HTMLSelectElement).value; save(); });
      const itemIn = ed.querySelector<HTMLInputElement>('#f-item')!;
      autocomplete(itemIn, () => tb.items.map(([label, , desc]) => ({ label, sub: desc.length > 48 ? desc.slice(0, 48) + '…' : desc })), (it) => { m.item = it.label; save(); });
      itemIn.addEventListener('change', () => { const v = itemIn.value.trim(); const hit = tb.items.find(([n]) => n.toLowerCase() === v.toLowerCase()); m.item = hit ? hit[0] : v; save(); });
      ed.querySelector<HTMLInputElement>('#f-lv')!.addEventListener('change', (e) => { const el = e.target as HTMLInputElement; m.level = Math.max(1, Math.min(100, Math.round(+el.value) || 50)); el.value = String(m.level); reStats(); });
      ed.querySelector<HTMLSelectElement>('#f-tera')!.addEventListener('change', (e) => { m.tera = (e.target as HTMLSelectElement).value; save(); });
      ed.querySelector<HTMLSelectElement>('#f-nat')!.addEventListener('change', (e) => { m.nature = (e.target as HTMLSelectElement).value; save(); drawEd(); });
      // +/− beside a stat picks the nature that raises or lowers it, keeping the other half when it can
      ed.querySelectorAll<HTMLButtonElement>('.np').forEach((b) => b.addEventListener('click', () => {
        const k = +b.dataset.k!, up = b.dataset.d === '1'; let [nu, nd] = NAT[m.nature];
        const neutral = nu === nd;
        if (up) { if (!neutral && nu === k) { nd = nu; } else { if (nd === k) nd = nu; nu = k; if (neutral) nd = k === 1 ? 3 : 1; } }
        else { if (!neutral && nd === k) { nu = nd; } else { if (nu === k) nu = nd; nd = k; if (neutral) nu = k === 1 ? 3 : 1; } }
        if (nu === nd) { m.nature = ({ 1: 'Hardy', 2: 'Docile', 3: 'Bashful', 4: 'Quirky', 5: 'Serious' } as Record<number, string>)[nu]; }
        else m.nature = Object.keys(NAT).find((n) => NAT[n][0] === nu && NAT[n][1] === nd)!;
        save(); drawEd();
      }));
      const shift = (dir: number) => { const to = sel + dir; if (to < 0 || to >= t.mons.length) return; [t.mons[sel], t.mons[to]] = [t.mons[to], t.mons[sel]]; sel = to; save(); drawStrip(); drawEd(); };
      ed.querySelector('#f-left')!.addEventListener('click', () => shift(-1));
      ed.querySelector('#f-right')!.addEventListener('click', () => shift(1));
      ed.querySelector('#f-rm')!.addEventListener('click', () => { t.mons.splice(sel, 1); sel = Math.max(0, sel - 1); save(); drawTeams(); drawStrip(); drawEd(); });
      const i = spIndex.get(m.sp)!;
      ed.querySelectorAll<HTMLInputElement>('.mvin').forEach((inp) => {
        const j = +inp.dataset.j!;
        const setMove = (name: string) => { const v = name.trim().toLowerCase(); m.moves[j] = v ? (Object.keys(idx.moves).find((x) => idx.moves[x][0].toLowerCase() === v) ?? m.moves[j]) : ''; save(); };
        autocomplete(inp, () => learnOf(i).filter((x) => idx.moves[x]).map((x) => { const [label, type, cat] = idx.moves[x]; const md = tb.moves[x]; return { label, type, cat, move: md ? { pow: md[0], acc: md[1], pp: md[2], desc: md[3] } : undefined }; }).sort((a, b) => a.label.localeCompare(b.label)),
          (it) => { setMove(it.label); drawEd(); (ed.querySelectorAll<HTMLInputElement>('.mvin')[j + 1])?.focus(); }, 12, true);
        inp.addEventListener('change', () => { setMove(inp.value); drawEd(); });
      });
      const clampEv = (k: number, v: number) => { const others = m.evs.reduce((a, b, x) => a + (x === k ? 0 : b), 0); return Math.max(0, Math.min(cap.per, v, cap.total - others)); };
      ed.querySelectorAll<HTMLInputElement>('.evr').forEach((r) => r.addEventListener('input', () => {
        const k = +r.dataset.k!; m.evs[k] = clampEv(k, +r.value); r.value = String(m.evs[k]); (ed.querySelector(`.ev[data-k="${k}"]`) as HTMLInputElement).value = String(m.evs[k]); reStats();
      }));
      ed.querySelectorAll<HTMLInputElement>('.ev').forEach((n) => n.addEventListener('change', () => {
        const k = +n.dataset.k!; m.evs[k] = clampEv(k, Math.round(+n.value || 0)); n.value = String(m.evs[k]); (ed.querySelector(`.evr[data-k="${k}"]`) as HTMLInputElement).value = String(m.evs[k]); reStats();
      }));
      ed.querySelectorAll<HTMLInputElement>('.iv').forEach((n) => n.addEventListener('change', () => {
        const k = +n.dataset.k!; m.ivs[k] = Math.max(0, Math.min(31, Math.round(+n.value || 0))); n.value = String(m.ivs[k]); reStats();
      }));
    };
    const drawAll = () => { drawTeams(); drawStrip(); drawEd(); save(); };

    // ---------- controls ----------
    const blank = (): Team => ({ id: Math.random().toString(36).slice(2, 9), name: 'Untitled team', fmt: 'all', mons: [] });
    // drag a Pokémon in the row to reorder the team
    let dragFrom = -1;
