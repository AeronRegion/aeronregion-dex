---
import Base from '../../layouts/Base.astro';
import { abilities, abilityUrl } from '../../lib/data';
---
<Base title="Abilities" description="Every ability, what it does and which Pokémon have it.">
  <h1>Abilities</h1>
  <div class="controls"><input class="field" id="q" placeholder="Search abilities or effects…" style="flex:1" /></div>
  <p class="note" id="count"></p>
  <table class="data sortable" id="ab">
    <thead><tr><th data-sort="text">Ability</th><th>Effect</th><th data-sort="num">Pokémon</th><th data-sort="num">Gen</th></tr></thead>
    <tbody>
      {abilities.map((a) => (
        <tr data-q={`${a.name} ${a.short}`.toLowerCase()}>
          <td style="white-space:nowrap"><a href={abilityUrl(a.name)}>{a.name}</a></td>
          <td class="tgt">{a.short}</td>
          <td class="n">{a.holders.length}</td>
          <td class="n">{a.gen}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <script>
    const q = document.getElementById('q') as HTMLInputElement;
    const rows = [...(document.getElementById('ab') as HTMLTableElement).tBodies[0].rows];
    const run = () => { const v = q.value.trim().toLowerCase(); let n = 0; for (const r of rows) { const ok = !v || r.dataset.q!.includes(v); r.hidden = !ok; if (ok) n++; } document.getElementById('count')!.textContent = `${n} abilities`; };
    q.addEventListener('input', run); run();
  </script>
</Base>
