---
import Base from '../../layouts/Base.astro';
import Type from '../../components/Type.astro';
import Cat from '../../components/Cat.astro';
import { moves, moveUrl } from '../../lib/data';
import { TYPES } from '../../lib/types';
const catOrder: Record<string, number> = { Physical: 0, Special: 1, Status: 2 };
const list = [...moves].sort((a, b) => catOrder[a.cat] - catOrder[b.cat] || a.name.localeCompare(b.name));
---
<Base title="Moves" description="Every move with type, category, power, accuracy, PP, priority and target.">
  <h1>Moves</h1>
  <div class="controls">
    <input class="field" id="q" placeholder="Search moves or effects…" style="flex:1;min-width:240px" />
    <select class="field" id="t"><option value="">All types</option>{TYPES.map((t) => <option>{t}</option>)}</select>
  </div>
  <p class="note" id="count"></p>
  <table class="data sortable" id="mv">
    <thead><tr><th data-sort="text">Move</th><th data-sort="text">Type</th><th data-sort="num" class="sorted asc">Cat.</th><th data-sort="num">Pwr</th><th data-sort="num">Acc</th><th data-sort="num">PP</th><th data-sort="num" class="pri">Priority</th><th data-sort="text">Target</th><th>Effect</th></tr></thead>
    <tbody>
      {list.map((m) => (
        <tr data-q={`${m.name} ${m.short}`.toLowerCase()} data-t={m.type}>
          <td><a href={moveUrl(m)}>{m.name}</a></td>
          <td data-v={m.type}><Type type={m.type} small /></td>
          <td data-v={catOrder[m.cat]}><Cat cat={m.cat} /></td>
          <td class="n">{m.power ?? '—'}</td><td class="n">{m.acc ?? '—'}</td><td class="n">{m.pp}</td>
          <td class={`n pri ${m.pri > 0 ? 'pos' : m.pri < 0 ? 'neg' : 'zero'}`} data-v={m.pri}>{m.pri > 0 ? `+${m.pri}` : m.pri}</td>
          <td class="tgt">{m.target}</td>
          <td class="tgt">{m.short}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <script>
    const q = document.getElementById('q') as HTMLInputElement, t = document.getElementById('t') as HTMLSelectElement;
    const rows = [...(document.getElementById('mv') as HTMLTableElement).tBodies[0].rows];
    const run = () => { const v = q.value.trim().toLowerCase(); let n = 0;
      for (const r of rows) { const ok = (!v || r.dataset.q!.includes(v)) && (!t.value || r.dataset.t === t.value); r.hidden = !ok; if (ok) n++; }
      document.getElementById('count')!.textContent = `${n} moves`; };
    [q, t].forEach((el) => el.addEventListener('input', run)); run();
  </script>
</Base>
