---
import Base from '../layouts/Base.astro';
import { species, pokeUrl, iconUrl } from '../lib/data';
const list = species.filter((s) => !s.forme);
const KEYS = ['HP', 'Atk', 'Def', 'SpA', 'SpD', 'Spe'];
const NAMES: Record<string, string> = { HP: 'HP', Atk: 'Attack', Def: 'Defense', SpA: 'Sp. Atk', SpD: 'Sp. Def', Spe: 'Speed' };
const evOf = (s: any) => Object.fromEntries(s.ev.map((e: string) => { const [n, k] = e.split(' '); return [k, +n]; }));
---
<Base title="EV yield: Pokémon to train each stat" description="Which Pokémon give EVs in each stat when defeated.">
  <h1>EV yield</h1>
  <p class="note">Effort values a Pokémon gives when defeated. Pick a stat to see who to train against.</p>
  <div class="controls">
    <span class="lab">Stat</span>
    <select class="field" id="st"><option value="">Any stat</option>{KEYS.map((k) => <option value={k}>{NAMES[k]}</option>)}</select>
    <select class="field" id="amt"><option value="">Any amount</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select>
  </div>
  <p class="note" id="count"></p>
  <table class="data sortable" id="ev">
    <thead><tr><th data-sort="num">#</th><th></th><th data-sort="text">Name</th>{KEYS.map((k) => <th data-sort="num" class="c" title={NAMES[k]}>{k}</th>)}<th data-sort="num" class="c">Total</th></tr></thead>
    <tbody>
      {list.map((s) => { const ev = evOf(s); return (
        <tr data-ev={JSON.stringify(ev)}>
          <td class="n soft" data-v={s.num}>{String(s.num).padStart(4, '0')}</td>
          <td><img class="sprite" src={iconUrl(s.art)} alt="" loading="lazy" width="32" height="32" /></td>
          <td><a href={pokeUrl(s)}>{s.name}</a></td>
          {KEYS.map((k) => <td class="c" data-v={ev[k] ?? 0}>{ev[k] ? <span class={`evb ev-${k}`}>{ev[k]}</span> : ''}</td>)}
          <td class="c" data-v={Object.values(ev).reduce((a: number, b: any) => a + b, 0)}><b>{Object.values(ev).reduce((a: number, b: any) => a + b, 0)}</b></td>
        </tr>
      ); })}
    </tbody>
  </table>
  <script>
    const st = document.getElementById('st') as HTMLSelectElement, amt = document.getElementById('amt') as HTMLSelectElement;
    const rows = [...(document.getElementById('ev') as HTMLTableElement).tBodies[0].rows];
    const run = () => {
      let n = 0;
      for (const r of rows) {
        const ev = JSON.parse(r.dataset.ev!) as Record<string, number>;
        const ok = !st.value || (ev[st.value] && (!amt.value || ev[st.value] === +amt.value));
        r.hidden = !ok; if (ok) n++;
      }
      document.getElementById('count')!.textContent = `${n} Pokémon`;
      const q = new URLSearchParams(); if (st.value) q.set('stat', st.value); if (amt.value) q.set('n', amt.value);
      history.replaceState(null, '', q.toString() ? `?${q}` : location.pathname);
    };
    const p = new URLSearchParams(location.search); if (p.get('stat')) st.value = p.get('stat')!; if (p.get('n')) amt.value = p.get('n')!;
    [st, amt].forEach((el) => el.addEventListener('change', run)); run();
  </script>
</Base>
<style>
  #ev { max-width: 760px; }
  #ev td, #ev th { padding-top: .2rem; padding-bottom: .2rem; }
  #ev th.c, #ev td.c { text-align: center; width: 56px; }
  #ev .sprite { width: 32px; height: 32px; }
  #ev .evb { min-width: 1.6rem; text-align: center; font-size: .78rem; padding: 0 .35rem; }
  #ev tbody tr:nth-child(even) { background: rgb(255 255 255 / .35); }
</style>
